/.claude

# DDEV local secrets (never commit)
drupal/.ddev/.env

# SearchStax Studio exports often include API tokens (sandbox removed; ignore leftovers)
search_ui_demo/*.searchstaxApp.apis.txt

# Migration tooling leftovers (the pipeline was removed; local exports stay untracked)
drupal/migration-data/private/
drupal/migration-data/wp_chrome_reference.json

# Local QA screenshots and scratch (not shared via git)
/testing/

# WP↔Drupal parity loop artifacts (legacy local path)
.parity/

# Parity harness generated output (keep manifest + scripts in git)
parity/node_modules/
parity/reports/runs/
parity/reports/latest-report.html
parity/reports/content-sweep/
parity/reports/smoke-200/
parity/reports/url-parity/
parity/reports/template-samples-http/
parity/reports/head-meta/
parity/reports/computed-style-diff/
parity/reports/behavior/
parity/reports/progress/
parity/reports/editor-e2e/
parity/reports/playwright-results.json
parity/reports/vm-integrator-before/
parity/test-results/
parity/playwright-report/
parity/baselines/*
!parity/baselines/README.md
!parity/baselines/.gitkeep

# Host-side DDEV DB override (copy from scripts/repro/settings.local.example.php)
drupal/web/sites/default/settings.local.php

# Local standups / demo prep (not shared via git)
standups/

# Drupal — never commit generated public files (aggregation, Twig PHP, image style derivatives)
drupal/web/sites/default/files/css/
drupal/web/sites/default/files/js/
drupal/web/sites/default/files/php/
drupal/web/sites/default/files/styles/
drupal/web/sites/default/files/wp-content/
drupal/web/sites/default/files/config_*/drupal/web/wp-content/

# Composer dependencies. Install with `composer install` inside drupal/.
/drupal/vendor/

# Config sync lives at drupal/config/sync (outside the webroot).
# Ignore a leftover copy under the public files directory.
/drupal/web/sites/default/files/sync/

# Upstream binary assets not used by this site (keep binaries out of git; restored by `composer install`).
drupal/web/core/themes/default_admin/font/
drupal/web/core/themes/default_admin/images/
drupal/web/core/themes/default_admin/logo.png
drupal/web/core/themes/default_admin/screenshot.png
drupal/web/core/modules/system/tests/fixtures/update/drupal-11.3.0.*.php.gz
drupal/vendor/weitzman/drupal-test-traits/tests/fixtures/drupal.png
