<?php

/**
 * @file
 * Editor roles, site chrome, and issue publishing workflow.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\df_editor\IssuePublisher;
use Drupal\Core\Session\AccountInterface;
use Drupal\filter\FilterFormatInterface;
use Drupal\node\Form\NodeForm;
use Drupal\node\NodeInterface;

/**
 * Implements hook_form_FORM_ID_alter() for issue edit forms.
 */
/**
 * Implements hook_form_FORM_ID_alter() for article forms.
 */
/**
 * Implements hook_form_FORM_ID_alter() for article edit forms.
 */
function df_editor_form_node_article_edit_form_alter(array &$form, FormStateInterface $form_state): void {
  df_editor_form_node_article_form_alter($form, $form_state);
}

function df_editor_form_node_article_form_alter(array &$form, FormStateInterface $form_state): void {
  df_editor_configure_article_placement_form($form, $form_state);
  df_editor_restrict_url_alias_form($form);
  if (!isset($form['body']['widget'][0])) {
    return;
  }
  $account = \Drupal::currentUser();
  $widget = &$form['body']['widget'][0];
  $stored_format = is_array($widget['#default_value'] ?? NULL)
    ? ($widget['#default_value']['format'] ?? NULL)
    : ($widget['#format'] ?? NULL);

  if ($account->hasPermission('use text format full_html')) {
    $widget['#format'] = 'full_html';
    if (is_array($widget['#default_value'] ?? NULL)) {
      $widget['#default_value']['format'] = $stored_format === 'full_html' ? 'full_html' : ($widget['#default_value']['format'] ?? 'full_html');
    }
    $widget['#allowed_formats'] = ['full_html', 'editor_html'];
  }
  elseif ($account->hasPermission('use text format editor_html')) {
    if ($stored_format === 'full_html' && $account->hasPermission('use legacy full html on stored content')) {
      $widget['#format'] = 'full_html';
      if (is_array($widget['#default_value'] ?? NULL)) {
        $widget['#default_value']['format'] = 'full_html';
      }
      $widget['#allowed_formats'] = ['full_html'];
    }
    else {
      $widget['#format'] = 'editor_html';
      if (is_array($widget['#default_value'] ?? NULL)) {
        $widget['#default_value']['format'] = 'editor_html';
      }
      $widget['#allowed_formats'] = ['editor_html'];
    }
  }

  $widget['#description'] = (string) t('Use the toolbar for headings, quotes, images, and the media library (insert an image once and reuse it). For a multi-image gallery with captions, add an Image gallery in Content sections. For WordPress-style blocks, switch to Source.');

  if (isset($form['title']['widget'][0]['value'])) {
    $form['title']['widget'][0]['value']['#title_display'] = 'before';
  }
  if (isset($form['field_topics']['widget'])) {
    $form['field_topics']['widget']['#title'] = $form['field_topics']['widget']['#title'] ?? t('Topics');
    $form['field_topics']['widget']['#title_display'] = 'before';
    $form['field_topics']['widget']['#required'] = FALSE;
  }
  if (isset($form['field_featured_image']['widget'])) {
    $form['field_featured_image']['widget']['#required'] = FALSE;
  }

  df_editor_attach_web_editor_save_redirect($form);
}

/**
 * Implements hook_entity_type_alter().
 */
function df_editor_entity_type_alter(array &$entity_types): void {
  if (isset($entity_types['file'])) {
    $entity_types['file']->setLinkTemplate('canonical', '/admin/content/files/{file}');
  }
}

/**
 * Deletes nodes left by Drush/Playwright automation (DF Test*, Playwright*).
 */
function df_editor_cleanup_automation_test_nodes(): int {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $deleted = 0;
  foreach (['Playwright%', 'DF Test%'] as $pattern) {
    $nids = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('title', $pattern, 'LIKE')
      ->execute();
    foreach ($nids as $nid) {
      $storage->load($nid)?->delete();
      $deleted++;
    }
  }
  return $deleted;
}

/**
 * Counts published and draft articles assigned to an issue.
 */
function df_editor_count_attached_articles(NodeInterface $issue): int {
  if (!$issue->id()) {
    return 0;
  }
  return (int) \Drupal::entityTypeManager()->getStorage('node')->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', ['article', 'in_brief'], 'IN')
    ->condition('field_issue.target_id', $issue->id())
    ->count()
    ->execute();
}

/**
 * Implements hook_entity_access() for legacy Full HTML on migrated bodies.
 */
function df_editor_entity_access(EntityInterface $entity, $operation, AccountInterface $account): AccessResult {
  if ($operation !== 'use' || !$entity instanceof FilterFormatInterface || $entity->id() !== 'full_html') {
    return AccessResult::neutral();
  }
  if ($account->hasPermission('use text format full_html')) {
    return AccessResult::neutral();
  }
  if ($account->hasPermission('use legacy full html on stored content')) {
    return AccessResult::allowed()->cachePerPermissions();
  }
  return AccessResult::neutral();
}

/**
 * Implements hook_node_presave().
 *
 * Web editors with legacy Full HTML may only keep that format on existing nodes.
 */
function df_editor_node_presave(NodeInterface $node): void {
  if ($node->bundle() === 'article' && $node->hasField('field_homepage_placement') && $node->hasField('field_explore_order')) {
    $placement = (string) $node->get('field_homepage_placement')->value;
    if ($placement !== 'featured') {
      $node->set('field_explore_order', NULL);
    }
  }
  if ($node->bundle() !== 'article' || !$node->hasField('body') || $node->get('body')->isEmpty()) {
    return;
  }
  $format = $node->get('body')->format;
  if ($format !== 'full_html') {
    return;
  }
  $account = \Drupal::currentUser();
  if ($account->hasPermission('use text format full_html')) {
    return;
  }
  if (!$account->hasPermission('use legacy full html on stored content')) {
    return;
  }
  $original = $node->original ?? NULL;
  if (!$original instanceof NodeInterface || $original->get('body')->format !== 'full_html') {
    $node->set('body', [
      'value' => $node->get('body')->value,
      'format' => 'editor_html',
    ]);
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for media forms (require alt text).
 */
function df_editor_form_media_image_form_alter(array &$form, FormStateInterface $form_state): void {
  df_editor_media_require_alt_text($form);
}

/**
 * Implements hook_form_FORM_ID_alter() for media library edit.
 */
function df_editor_form_media_form_alter(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  if (!is_object($form_object) || !method_exists($form_object, 'getEntity')) {
    return;
  }
  $media = $form_object->getEntity();
  if ($media && $media->bundle() === 'image') {
    df_editor_media_require_alt_text($form);
  }
}

/**
 * Marks image alt fields required for accessibility parity.
 */
function df_editor_media_require_alt_text(array &$form): void {
  if (isset($form['field_media_image']['widget'][0]['#alt_field_required'])) {
    $form['field_media_image']['widget'][0]['#alt_field_required'] = TRUE;
  }
  if (isset($form['field_media_image']['widget'][0]['alt'])) {
    $form['field_media_image']['widget'][0]['alt']['#required'] = TRUE;
    $form['field_media_image']['widget'][0]['alt']['#description'] = (string) t('Required. Describe the image for screen readers (WordPress alt parity).');
  }
}

/**
 * Implements hook_views_pre_render().
 */
function df_editor_views_pre_render(\Drupal\views\ViewExecutable $view): void {
  if (!in_array($view->storage->id(), ['browse_issues', 'issue_articles'], TRUE)) {
    return;
  }
  $view->element['#cache']['tags'] = Cache::mergeTags(
    $view->element['#cache']['tags'] ?? [],
    [
      'node_list:issue',
      'node_list:article',
      'node_list:in_brief',
      IssuePublisher::CACHE_TAG_ISSUE_NAV,
      'config:df_editor.settings',
      'config:views.view.browse_issues',
    ],
  );
}

/**
 * Implements hook_page_attachments_alter().
 */
function df_editor_page_attachments_alter(array &$attachments): void {
  df_editor_apply_issue_nav_page_cache($attachments);
  if (!\Drupal::moduleHandler()->moduleExists('df_editor')) {
    return;
  }
  /** @var \Drupal\df_editor\IssuePreview $preview */
  $preview = \Drupal::service('df_editor.issue_preview');
  $nid = $preview->getPreviewIssueNid();
  if ($nid === NULL) {
    return;
  }
  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'meta',
      '#attributes' => ['name' => 'df-preview-issue', 'content' => (string) $nid],
    ],
    'df_editor_preview_issue',
  ];
  if (\Drupal::currentUser()->hasPermission('publish issue with articles') && \Drupal::service('path.matcher')->isFrontPage()) {
    \Drupal::messenger()->addWarning(t('Homepage and Issues navigation preview: treating issue @nid as the current featured issue.', ['@nid' => $nid]));
  }
}

/**
 * Invalidates render and page cache for issue-driven chrome.
 */
function df_editor_invalidate_issue_nav_cache(): void {
  \Drupal::service('cache_tags.invalidator')->invalidateTags([
    'node_list:issue',
    'node_list:article',
    'node_list:in_brief',
    IssuePublisher::CACHE_TAG_ISSUE_NAV,
    'config:df_editor.settings',
    'config:views.view.browse_issues',
  ]);
}

/**
 * Implements hook_preprocess_page().
 */
function df_editor_preprocess_page(array &$variables): void {
  df_editor_apply_issue_nav_page_cache($variables);
}

/**
 * Adds cache tags so issue publish and df_editor.settings changes bust page cache.
 *
 * @param array<string, mixed> $element
 */
function df_editor_apply_issue_nav_page_cache(array &$element): void {
  $tags = [
    'node_list:issue',
    'node_list:article',
    'node_list:in_brief',
    IssuePublisher::CACHE_TAG_ISSUE_NAV,
    'config:df_editor.settings',
    'config:views.view.browse_issues',
  ];
  if (function_exists('df_setup_get_latest_issue_nid')) {
    $latest = df_setup_get_latest_issue_nid();
    if ($latest) {
      $tags[] = 'node:' . $latest;
    }
  }
  $element['#cache']['tags'] = Cache::mergeTags($element['#cache']['tags'] ?? [], $tags);
  $element['#cache']['contexts'] = Cache::mergeContexts(
    $element['#cache']['contexts'] ?? [],
    ['languages:language_interface'],
  );
  $element['#cache']['max-age'] = Cache::PERMANENT;
}

/**
 * Implements hook_form_FORM_ID_alter() for issue edit forms.
 */
function df_editor_form_node_issue_edit_form_alter(array &$form, FormStateInterface $form_state): void {
  df_editor_form_node_issue_form_alter($form, $form_state);
}

function df_editor_form_node_issue_form_alter(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof NodeForm) {
    return;
  }
  $entity = $form_object->getEntity();
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'issue') {
    return;
  }

  if (isset($form['field_hero_video'])) {
    $form['field_hero_video']['#description'] = (string) t('Ambient MP4 for the homepage cover video when this issue is the newest published issue. Autoplay, muted, loop—same behavior as WordPress.');
    $form['field_hero_video']['#weight'] = 20;
  }
  if (isset($form['field_hero_poster'])) {
    $form['field_hero_poster']['#description'] = (string) t('Poster image shown while the homepage hero video loads (cover image).');
    $form['field_hero_poster']['#weight'] = 21;
  }
  if (isset($form['field_hero_heading'])) {
    $form['field_hero_heading']['#description'] = (string) t('Large heading over the homepage hero video when this issue is the current featured issue on the homepage.');
    $form['field_hero_heading']['#weight'] = 12;
  }

  $group = [
    '#type' => 'details',
    '#title' => t('Homepage hero (site admins)'),
    '#open' => TRUE,
    '#weight' => 15,
  ];
  if (isset($form['field_hero_heading']) && !\Drupal::currentUser()->hasPermission('administer df site settings')) {
    $form['field_hero_heading']['#access'] = FALSE;
  }
  foreach (['field_hero_video', 'field_hero_poster', 'field_hero_heading'] as $field_name) {
    if (isset($form[$field_name])) {
      $group[$field_name] = $form[$field_name];
      unset($form[$field_name]);
    }
  }
  if (isset($group['field_hero_video']) || isset($group['field_hero_poster']) || isset($group['field_hero_heading'])) {
    $form['df_homepage_hero'] = $group;
    if (!\Drupal::currentUser()->hasPermission('administer df site settings')) {
      $form['df_homepage_hero']['#access'] = FALSE;
    }
  }

  if (\Drupal::currentUser()->hasPermission('publish issue with articles')) {
    $form['#attached']['library'][] = 'df_editor/issue_publish_confirm';
    $form['#attached']['drupalSettings']['dfEditor']['issueArticleCount'] = df_editor_count_attached_articles($entity);
    $form['df_publish_issue_bundle'] = [
      '#type' => 'submit',
      '#value' => t('Publish issue'),
      '#weight' => 101,
      '#submit' => ['df_editor_issue_publish_bundle_submit'],
      '#limit_validation_errors' => [],
      '#attributes' => ['class' => ['js-df-issue-publish-bundle']],
    ];
  }

  if (isset($form['publish_on'])) {
    $form['publish_on']['#description'] = (string) t('Optional: schedule this issue to go live automatically (requires Scheduler).');
    $form['publish_on']['#weight'] = 99;
  }
  if (isset($form['field_year']['widget'][0]['value'])) {
    $form['field_year']['widget'][0]['value']['#max'] = 2105;
  }
  df_editor_restrict_url_alias_form($form);
  df_editor_attach_web_editor_save_redirect($form);
}

/**
 * Keeps editors on the Gin edit form after save so status messages render.
 */
function df_editor_attach_web_editor_save_redirect(array &$form): void {
  $account = \Drupal::currentUser();
  if (!$account->hasPermission('create article content') && !$account->hasPermission('create issue content')) {
    return;
  }
  if (!isset($form['actions'])) {
    return;
  }
  foreach (array_keys($form['actions']) as $action) {
    if (($form['actions'][$action]['#type'] ?? '') !== 'submit') {
      continue;
    }
    if (in_array($action, ['df_publish_issue_bundle', 'preview', 'delete'], TRUE)) {
      continue;
    }
    $form['actions'][$action]['#submit'][] = 'df_editor_web_editor_node_save_redirect';
  }
}

/**
 * Submit handler: redirect to edit-form after a successful save (Gin status messages).
 */
function df_editor_web_editor_node_save_redirect(array &$form, FormStateInterface $form_state): void {
  if ($form_state->get('df_editor_web_editor_save_redirect_done')) {
    return;
  }
  $trigger = $form_state->getTriggeringElement();
  $parents = $trigger['#parents'] ?? [];
  $triggering_name = $trigger['#name'] ?? '';
  if (in_array('preview', $parents, TRUE) || $triggering_name === 'preview') {
    return;
  }
  if (in_array('delete', $parents, TRUE) || $triggering_name === 'delete') {
    return;
  }
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof NodeForm) {
    return;
  }
  $node = $form_object->getEntity();
  if (!$node instanceof NodeInterface || !in_array($node->bundle(), ['issue', 'article'], TRUE)) {
    return;
  }
  if (!$node->id()) {
    return;
  }
  $form_state->set('df_editor_web_editor_save_redirect_done', TRUE);
  $form_state->setRedirectUrl($node->toUrl('edit-form'));
}

/**
 * Submit handler: publish issue and attached articles.
 */
function df_editor_issue_publish_bundle_submit(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof NodeForm) {
    return;
  }
  $issue = $form_object->getEntity();
  if (!$issue instanceof NodeInterface) {
    return;
  }
  /** @var \Drupal\df_editor\IssuePublisher $publisher */
  $publisher = \Drupal::service('df_editor.issue_publisher');
  $articles = $publisher->publishIssueWithArticles($issue);
  \Drupal::messenger()->addStatus(t('Published issue @issue and @count draft or in-review article(s) and brief(s). Homepage placement was not changed.', [
    '@issue' => $issue->label(),
    '@count' => count($articles),
  ]));
  $form_state->setRedirect('entity.node.canonical', ['node' => $issue->id()]);
}

/**
 * Implements hook_node_insert().
 */
function df_editor_node_insert(NodeInterface $node): void {
  if ($node->bundle() === 'issue' && $node->isPublished() && PHP_SAPI !== 'cli') {
    df_editor_warn_empty_published_issue($node);
  }
}

/**
 * Server-side counterpart of issue-publish-confirm.js; warns without blocking the publish.
 */
function df_editor_warn_empty_published_issue(NodeInterface $issue): void {
  if (df_editor_count_attached_articles($issue) > 0) {
    return;
  }
  \Drupal::messenger()->addWarning(t('Issue @issue was published with no attached articles or briefs. Its issue page and the homepage feature stay empty until stories are attached.', [
    '@issue' => $issue->label(),
  ]));
}

/**
 * Implements hook_node_update().
 *
 * When an issue is first published via moderation, attach-publish its articles.
 */
function df_editor_node_update(NodeInterface $node): void {
  if ($node->bundle() === 'issue') {
    $original = $node->original ?? NULL;
    if ($original instanceof NodeInterface) {
      if ($original->isPublished() !== $node->isPublished()) {
        df_editor_invalidate_issue_nav_cache();
        if ($original->isPublished() && !$node->isPublished()) {
          df_editor_warn_unpublished_issue_links($node);
        }
      }
      elseif ($original->hasField('moderation_state') && $node->hasField('moderation_state')) {
        $old_mod = (string) $original->get('moderation_state')->value;
        $new_mod = (string) $node->get('moderation_state')->value;
        if ($old_mod !== $new_mod && ($old_mod === 'published' || $new_mod === 'published')) {
          df_editor_invalidate_issue_nav_cache();
        }
      }
      if ($node->isPublished()) {
        if ($node->hasField('field_hero_heading') && $original->hasField('field_hero_heading')) {
          $old = (string) $original->get('field_hero_heading')->value;
          $new = (string) $node->get('field_hero_heading')->value;
          if ($old !== $new) {
            df_editor_invalidate_issue_nav_cache();
          }
        }
      }
    }
  }
  if ($node->bundle() !== 'issue' || !$node->isPublished()) {
    return;
  }
  $original = $node->original ?? NULL;
  if (!$original instanceof NodeInterface || $original->isPublished()) {
    return;
  }
  df_editor_warn_empty_published_issue($node);
  if (!\Drupal::currentUser()->hasPermission('publish issue with articles')) {
    return;
  }
  \Drupal::service('df_editor.issue_publisher')->publishAttachedArticles($node);
}

/**
 * Hides the URL alias widget unless the account may override aliases.
 *
 * site_admin has create/administer url aliases. web_editor does not.
 * Alias changes are not scheduled.
 */
function df_editor_restrict_url_alias_form(array &$form): void {
  $account = \Drupal::currentUser();
  $can_override = $account->hasPermission('create url aliases') || $account->hasPermission('administer url aliases');
  if ($can_override || !isset($form['path'])) {
    return;
  }
  $form['path']['#access'] = FALSE;
}

/**
 * Explore slots are regular articles only, with an editor-chosen order of 1–3.
 */
function df_editor_configure_article_placement_form(array &$form, FormStateInterface $form_state): void {
  if (isset($form['field_homepage_placement']['widget'])) {
    $form['field_homepage_placement']['widget']['#description'] = (string) t('Explore the Latest Issue uses the three featured slots (1 large, then two stacked). Recent Highlights is separate. Digital Exclusives and In Brief are not featured here.');
  }
  if (isset($form['field_explore_order']['widget'])) {
    $form['field_explore_order']['widget']['#description'] = (string) t('Slot on Explore the Latest Issue when Homepage placement is Explore the Latest Issue. 1 is the large card. 2 and 3 are the stacked cards.');
    $form['field_explore_order']['#states'] = [
      'visible' => [
        ':input[name="field_homepage_placement"]' => ['value' => 'featured'],
      ],
    ];
  }
  if (isset($form['field_issue_story_rank']['widget'])) {
    $form['field_issue_story_rank']['widget']['#description'] = (string) t('Issue pages list stories by publication date. Pinned stays at the top. Demoted stays at the bottom. Normal uses the date.');
  }
  if (isset($form['field_homepage_sort_weight']['widget'])) {
    $form['field_homepage_sort_weight']['widget']['#description'] = (string) t('Not used for Explore the Latest Issue. Leave blank. Digital Exclusives no longer need a 110–199 weight.');
  }
  $form['#validate'][] = 'df_editor_article_featured_slot_validate';
}

/**
 * Warns when a fourth story is featured or an Explore slot is taken.
 */
function df_editor_article_featured_slot_validate(array &$form, FormStateInterface $form_state): void {
  $placement = (string) ($form_state->getValue(['field_homepage_placement', 0, 'value']) ?? 'none');
  $digital_exclusive = !$form_state->isValueEmpty('df_digital_exclusive_checkbox');
  if ($digital_exclusive && $placement === 'featured') {
    $form_state->setErrorByName('field_homepage_placement', t('Digital Exclusives are not featured in Explore the Latest Issue. Turn off Digital Exclusives or set placement to None.'));
    return;
  }
  if ($placement !== 'featured') {
    return;
  }
  $order = (int) ($form_state->getValue(['field_explore_order', 0, 'value']) ?? 0);
  if (!in_array($order, [1, 2, 3], TRUE)) {
    $form_state->setErrorByName('field_explore_order', t('Choose Explore slot 1, 2, or 3.'));
    return;
  }
  $issue_id = (int) ($form_state->getValue(['field_issue', 0, 'target_id']) ?? 0);
  if ($issue_id <= 0) {
    \Drupal::messenger()->addWarning(t('This story is featured, but it has no issue, so it cannot fill an Explore the Latest Issue slot.'));
    return;
  }
  $form_object = $form_state->getFormObject();
  $current_id = 0;
  if ($form_object instanceof NodeForm) {
    $current_id = (int) $form_object->getEntity()->id();
  }
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $nids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'article')
    ->condition('field_issue.target_id', $issue_id)
    ->condition('field_homepage_placement', 'featured')
    ->execute();
  $nids = array_map('intval', $nids);
  if ($current_id === 0 || !in_array($current_id, $nids, TRUE)) {
    $nids[] = $current_id;
  }
  if (count($nids) > 3) {
    \Drupal::messenger()->addWarning(t('This issue already has three featured stories. A fourth featured story will not get its own Explore slot until one of the others is cleared.'));
  }
  $others_query = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'article')
    ->condition('field_issue.target_id', $issue_id)
    ->condition('field_homepage_placement', 'featured')
    ->condition('field_explore_order', $order);
  if ($current_id > 0) {
    $others_query->condition('nid', $current_id, '<>');
  }
  $others = $others_query->execute();
  if ($others === []) {
    return;
  }
  $replaced = $storage->load(reset($others));
  $title = $replaced instanceof NodeInterface ? $replaced->label() : (string) reset($others);
  \Drupal::messenger()->addWarning(t('Explore slot @slot is already used by “@title”. Saving replaces that slot with this story.', [
    '@slot' => $order,
    '@title' => $title,
  ]));
}

/**
 * Unpublished issues keep their stories live. Links must not point at a 403.
 */
function df_editor_warn_unpublished_issue_links(NodeInterface $issue): void {
  if (!$issue->id()) {
    return;
  }
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $nids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', ['article', 'in_brief'], 'IN')
    ->condition('status', 1)
    ->condition('field_issue.target_id', $issue->id())
    ->execute();
  if ($nids === []) {
    return;
  }
  $titles = [];
  foreach ($storage->loadMultiple($nids) as $node) {
    if ($node instanceof NodeInterface) {
      $titles[] = $node->label();
    }
  }
  \Drupal::messenger()->addWarning(t('Issue @issue is unpublished. These stories stay live, and their issue links go to Browse issues instead of this issue: @list', [
    '@issue' => $issue->label(),
    '@list' => implode('; ', $titles),
  ]));
}
