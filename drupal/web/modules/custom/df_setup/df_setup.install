}

/**
 * Migrate legacy Digital Exclusives homepage placement to Channels taxonomy.
 */
function df_setup_update_10003(): string {
  /** @var \Drupal\df_setup\DigitalExclusiveChannels $channels */
  $channels = \Drupal::service('df_setup.digital_exclusive_channels');
  $tid = $channels->ensureTermId();
  if (!$tid) {
    return 'Digital Exclusives taxonomy term was not created (channels vocabulary missing). Run config import, then re-run updates.';
  }

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $nids = $storage->getQuery()
    ->condition('type', 'article')
    ->condition('field_homepage_placement', 'digital_exclusives')
    ->accessCheck(FALSE)
    ->execute();

  $updated = 0;
  foreach ($nids as $nid) {
    $node = $storage->load($nid);
    if (!$node instanceof Node || $node->bundle() !== 'article') {
      continue;
    }
    if ($node->hasField('field_channels')) {
      $referenced = array_map('intval', array_column($node->get('field_channels')->getValue(), 'target_id'));
      if (!in_array($tid, $referenced, TRUE)) {
        $node->get('field_channels')->appendItem(['target_id' => $tid]);
      }
    }
    if ($node->hasField('field_homepage_placement')) {
      $node->set('field_homepage_placement', 'none');
    }
    $node->save();
    $updated++;
  }

  return sprintf('Migrated %d article(s) from homepage placement "digital_exclusives" to Channels (term ID %d).', $updated, $tid);
}

/**
 * Clear legacy digital_exclusives list values before field allowed_values change (cim).
 *
 * Saves affected node IDs in state so a follow-up update can attach field_channels
 * after the field is created via config import.
 */
function df_setup_update_10004(): string {
  $db = \Drupal::database();
  $base = 'node__field_homepage_placement';
  if (!$db->schema()->tableExists($base)) {
    return 'Homepage placement field table not found.';
  }

  $q = $db->select($base, 'h');
  $q->addField('h', 'entity_id');
  $q->distinct();
  $q->condition('h.bundle', 'article');
  $q->condition('h.field_homepage_placement_value', 'digital_exclusives');
  /** @var int[] $nids */
  $nids = array_map('intval', $q->execute()->fetchCol());
  sort($nids);
  \Drupal::state()->set('df_setup.pending_de_channel_nids', array_values(array_unique($nids)));

  $db->update($base)
    ->fields(['field_homepage_placement_value' => 'none'])
    ->condition('bundle', 'article')
    ->condition('field_homepage_placement_value', 'digital_exclusives')
    ->execute();

  $rev = 'node_revision__field_homepage_placement';
  if ($db->schema()->tableExists($rev)) {
    $db->update($rev)
      ->fields(['field_homepage_placement_value' => 'none'])
      ->condition('bundle', 'article')
      ->condition('field_homepage_placement_value', 'digital_exclusives')
      ->execute();
  }

  return sprintf(
    'Cleared homepage placement digital_exclusives from the database (%d articles). Pending channel backfill IDs stored; run config import, then updates again.',
    count($nids)
  );
}

/**
 * Attach Digital Exclusives channel to articles that used legacy placement after cim.
 */
function df_setup_update_10005(): string {
  $pending = \Drupal::state()->get('df_setup.pending_de_channel_nids', []);
  if ($pending === [] || !$pending) {
    return 'No pending Digital Exclusive channel backfill.';
  }

  $field_storage = FieldStorageConfig::loadByName('node', 'field_channels');
  if (!$field_storage) {
    return 'Run config import to create field_channels, then drush updatedb again to complete Digital Exclusive backfill.';
  }

  /** @var \Drupal\df_setup\DigitalExclusiveChannels $channels */
  $channels = \Drupal::service('df_setup.digital_exclusive_channels');
  $tid = $channels->ensureTermId();
  if (!$tid) {
    return 'Digital Exclusives term missing; retry after Channels vocabulary imports.';
  }

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $attached = 0;
  foreach ($pending as $nid) {
    $node = $storage->load($nid);
    if (!$node instanceof Node || $node->bundle() !== 'article') {
      continue;
    }
    $referenced = array_map('intval', array_column($node->get('field_channels')->getValue(), 'target_id'));
    if (!in_array($tid, $referenced, TRUE)) {
      $node->get('field_channels')->appendItem(['target_id' => $tid]);
      $node->save();
      $attached++;
    }
  }

  \Drupal::state()->delete('df_setup.pending_de_channel_nids');

  return sprintf('Attached Digital Exclusives channel to %d article(s).', $attached);
}

/**
 * Decode HTML entities in article titles and image media alt text (migration).
 */
function df_setup_update_10006(): string {
  $node_storage = \Drupal::entityTypeManager()->getStorage('node');

  /** @var int[] $nids */
  // Any '&' catches &amp;, &#8217;, etc. migrated literally into the title string.
  $nids = $node_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'article')
    ->condition('title', '&', 'CONTAINS')
    ->execute();

  $nodes_fixed = 0;
  foreach ($node_storage->loadMultiple($nids) as $node) {
    if (!$node instanceof Node || $node->bundle() !== 'article') {
      continue;
    }
    $decoded = Html::decodeEntities($node->getTitle());
    if ($decoded !== $node->getTitle() && $decoded !== '') {
      $node->setTitle($decoded);
      $node->save();
      $nodes_fixed++;
    }
  }

  /** @var int[] $mids */
  $mids = [];
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('media__field_media_image')) {
    $db = \Drupal::database();
    $alt_column = 'field_media_image_alt';
    if ($schema->fieldExists('media__field_media_image', $alt_column)) {
      $or = $db->condition('OR');
      $or->condition("fi.{$alt_column}", '%&amp;%', 'LIKE');
      $or->condition("fi.{$alt_column}", '%&#%', 'LIKE');
      $mids = $db->select('media__field_media_image', 'fi')
        ->fields('fi', ['entity_id'])
        ->condition($or)
        ->distinct()
        ->execute()
        ->fetchCol();
    }
  }


  $media_storage = \Drupal::entityTypeManager()->getStorage('media');
  $media_fixed = 0;
  foreach ($media_storage->loadMultiple($mids) as $media) {
    if ($media->bundle() !== 'image' || !$media->hasField('field_media_image')) {
      continue;
    }
    $values = $media->get('field_media_image')->getValue();
    $changed = FALSE;
    foreach ($values as $i => $row) {
      if (empty($row['alt'])) {
        continue;
      }
      $decoded_alt = Html::decodeEntities((string) $row['alt']);
      if ($decoded_alt !== (string) $row['alt'] && $decoded_alt !== '') {
        $values[$i]['alt'] = $decoded_alt;
        $changed = TRUE;
      }
    }
    if ($changed) {
      $media->set('field_media_image', $values);
      $media->save();
      $media_fixed++;
    }
  }

  return sprintf('Normalized HTML entities in %d article title(s) and %d media image alt(s).', $nodes_fixed, $media_fixed);
}

/**
 * Remove obsolete Redirect entities that mapped WP /category/foo to legacy /topics/foo.
 *
 * Canonical topic archives now live at /category/{slug}; those redirects fought the view route.
 */
function df_setup_update_10007(): string {
  $entity_type_manager = \Drupal::entityTypeManager();
  if (!$entity_type_manager->hasDefinition('redirect')) {
    return 'Redirect module not present; skipped category redirect cleanup.';
  }
  /** @var \Drupal\Core\Entity\EntityStorageInterface $storage */
  $storage = $entity_type_manager->getStorage('redirect');
  /** @var int[] $ids */
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('redirect_source.path', 'category%', 'LIKE')
    ->execute();
  if (!$ids) {
    return 'No matching category/* redirects to remove.';
  }
  $removed = 0;
  foreach ($storage->loadMultiple($ids) as $redirect) {
    $link = $redirect->get('redirect_redirect')->first();
    $uri = '';
    if ($link && !$link->isEmpty()) {
      $uri = (string) $link->uri;
    }
    if ($uri !== '' && str_contains($uri, 'topics/')) {
      $redirect->delete();
      $removed++;
    }
  }
  return sprintf('Removed %d redirect(s) that pointed category/* to /topics/*.', $removed);
}

/**
 * Rebuild taxonomy_index for published articles so topic archives resolve via taxonomy_index.
 */
function df_setup_update_10008(): string {
  if (!function_exists('taxonomy_build_node_index')) {
    return 'Taxonomy unavailable; skipped taxonomy_index rebuild.';
  }
  /** @var \Drupal\node\NodeStorageInterface $node_storage */
  $node_storage = \Drupal::entityTypeManager()->getStorage('node');
  $nids = $node_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'article')
    ->condition('status', 1)
    ->execute();
  if (!$nids) {
    return 'No published articles found for taxonomy index rebuild.';
  }
  foreach ($node_storage->loadMultiple($nids) as $node) {
    taxonomy_build_node_index($node);
  }
  return sprintf('Rebuilt taxonomy_index for %d published article(s).', count($nids));
}

/**
 * Store author and photographer names only; prefixes are applied at display time.
 */
function df_setup_update_10009(): string {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $nids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'article')
    ->execute();
  if (!$nids) {
    return 'No articles found for byline/photo credit normalization.';
  }

  $updated = 0;
  foreach ($storage->loadMultiple($nids) as $node) {
    if (!$node instanceof Node || $node->bundle() !== 'article') {
      continue;
    }
    $changed = FALSE;
    if ($node->hasField('field_byline') && !$node->get('field_byline')->isEmpty()) {
      $stripped = ArticleCreditLabels::stripByline((string) $node->get('field_byline')->value);
      if ($stripped !== (string) $node->get('field_byline')->value) {
        $node->set('field_byline', $stripped);
        $changed = TRUE;
      }
    }
    if ($node->hasField('field_photo_credit') && !$node->get('field_photo_credit')->isEmpty()) {
      $stripped = ArticleCreditLabels::stripPhotoCredit((string) $node->get('field_photo_credit')->value);
      if ($stripped !== (string) $node->get('field_photo_credit')->value) {
        $node->set('field_photo_credit', $stripped);
        $changed = TRUE;
      }
    }
    if ($changed) {
      $node->save();
      $updated++;
    }
  }

  return sprintf('Normalized byline and photo credit to names-only storage on %d article(s).', $updated);
}

/**
 * Adds photo caption field and moves mis-assigned caption text out of photo credit.
 */
function df_setup_update_10010(): string {
  _df_setup_ensure_article_photo_caption_field();

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $nids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'article')
    ->execute();
  if (!$nids) {
    return 'Photo caption field ensured; no articles to update.';
  }

  $updated = 0;
  foreach ($storage->loadMultiple($nids) as $node) {
    if (!$node instanceof Node || $node->bundle() !== 'article') {
      continue;
    }
    if (!$node->hasField('field_photo_caption') || !$node->hasField('field_photo_credit')) {
      continue;
    }

    $changed = FALSE;
    $credit = $node->get('field_photo_credit')->isEmpty()
      ? ''
      : trim((string) $node->get('field_photo_credit')->value);
    $caption = $node->get('field_photo_caption')->isEmpty()
      ? ''
      : trim((string) $node->get('field_photo_caption')->value);

    if ($caption === '' && $credit !== '' && _df_setup_photo_credit_looks_like_caption($credit)) {
      $node->set('field_photo_caption', $credit);
      $node->set('field_photo_credit', '');
      $changed = TRUE;
    }

    if ($changed) {
      $node->save();
      $updated++;
    }
  }

  return sprintf('Ensured photo caption field and moved mis-assigned caption text on %d article(s).', $updated);
}

/**
 * Creates article photo caption field storage/instance if missing.
 */
function _df_setup_ensure_article_photo_caption_field(): void {
  if (!FieldStorageConfig::loadByName('node', 'field_photo_caption')) {
    FieldStorageConfig::create([
      'field_name' => 'field_photo_caption',
      'entity_type' => 'node',
      'type' => 'string',
      'settings' => [
        'max_length' => 500,
        'case_sensitive' => FALSE,
        'is_ascii' => FALSE,
      ],
      'cardinality' => 1,
      'translatable' => TRUE,
    ])->save();
  }

  if (!FieldConfig::loadByName('node', 'article', 'field_photo_caption')) {
    FieldConfig::create([
      'field_storage' => FieldStorageConfig::loadByName('node', 'field_photo_caption'),
      'bundle' => 'article',
      'label' => 'Photo caption',
      'description' => 'Optional caption for the featured image (e.g., subject name and title). Only shown when a featured image is present.',
      'required' => FALSE,
      'translatable' => TRUE,
    ])->save();
  }

  $form_display = \Drupal\Core\Entity\Entity\EntityFormDisplay::load('node.article.default');
  if ($form_display && !$form_display->getComponent('field_photo_caption')) {
    $form_display->setComponent('field_photo_caption', [
      'type' => 'string_textfield',
      'weight' => 7,
      'region' => 'content',
      'settings' => [
        'size' => 60,
        'placeholder' => '',
      ],
    ])->save();
  }

  $view_display = \Drupal\Core\Entity\Entity\EntityViewDisplay::load('node.article.default');
  if ($view_display && !$view_display->getComponent('field_photo_caption')) {
    $view_display->setComponent('field_photo_caption', [
      'type' => 'string',
      'label' => 'hidden',
      'weight' => -5,
      'region' => 'content',
      'settings' => [
        'link_to_entity' => FALSE,
      ],
    ])->save();
  }
}

/**
 * Heuristic: legacy imports sometimes stored image captions in photo credit.
 */
function _df_setup_photo_credit_looks_like_caption(string $value): bool {
  $value = trim($value);
  if ($value === '') {
    return FALSE;
  }
  return (bool) preg_match('/,\s*(?:MD|PhD|MPH|M\.D\.|Ph\.D\.|Dr\.|chief|division|director|professor)/i', $value);
}

/**
 * Backfills photo captions from migration JSON for articles missing the field.
 */
function df_setup_update_10011(): string {
  $script = __DIR__ . '/../df_migrate/scripts/df_backfill_photo_captions.php';
  if (!is_readable($script)) {
    return 'Photo caption backfill script not found.';
  }
  ob_start();
  include $script;
  return trim((string) ob_get_clean());
}

/**
 * Home page public URL should match WordPress (/homepage/).
 */
function df_setup_update_10012(): string {
  _df_setup_ensure_home_landing();
  return 'Home landing alias set to /homepage (WordPress parity).';
}

/**
 * Drop legacy /home alias so /homepage is the public home path (WordPress parity).
 */
function df_setup_update_10013(): string {
  $storage = \Drupal::entityTypeManager()->getStorage('path_alias');
  $ids = $storage->getQuery()
    ->condition('alias', '/home')
    ->accessCheck(FALSE)
    ->execute();
  if ($ids) {
    $storage->delete($storage->loadMultiple($ids));
  }
  return sprintf('Removed %d legacy /home path alias(es).', count($ids));
}

/**
 * Issue nodes must be published for same-path HTTP 200 on /{season}-{year}-issue URLs.
 */
function df_setup_update_10014(): string {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $nids = $storage->getQuery()
    ->condition('type', 'issue')
    ->accessCheck(FALSE)
    ->execute();
  $updated = 0;
  foreach ($storage->loadMultiple($nids) as $node) {
    $changed = FALSE;
    if ($node->hasField('moderation_state') && $node->get('moderation_state')->value !== 'published') {
      $node->set('moderation_state', 'published');
      $changed = TRUE;
    }
    if (!$node->isPublished()) {
      $node->setPublished();
      $changed = TRUE;
    }
    if ($changed) {
      $node->save();
      $updated++;
    }
  }
  return sprintf('Published %d issue node(s).', $updated);
}

/**
 * Backfill homepage hero video + poster on the latest issue (WordPress uploads).
 */
function df_setup_update_10021(): string {
  return _df_setup_backfill_latest_issue_hero_media();
}

/**
