<?php

/**
 * @file
 * Setup helpers for DF Impact front page and Digital Exclusives Views filters.
 */

declare(strict_types=1);

use Drupal\Component\Utility\Html;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\df_setup\ArticleCreditLabels;
use Drupal\node\NodeInterface;
use Drupal\taxonomy\TermInterface;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\Plugin\views\query\Sql;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_form_FORM_ID_alter() for article add/edit forms.
 *
 * Mirrors the WordPress "Digital Exclusives" category: independent of Issue.
 */
function df_setup_form_node_article_form_alter(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  if (!method_exists($form_object, 'getEntity')) {
    return;
  }
  /** @var \Drupal\Core\Entity\EntityInterface $entity */
  $entity = $form_object->getEntity();
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'article') {
    return;
  }

  /** @var \Drupal\df_setup\DigitalExclusiveChannels $channels */
  $channels = \Drupal::service('df_setup.digital_exclusive_channels');
  $tid = $channels->ensureTermId();
  if (!$tid) {
    return;
  }

  $builders = &$form['#entity_builders'];
  $builders = is_array($builders) ? $builders : [];
  if (!in_array('df_setup_entity_builder_article_digital_exclusive', $builders, TRUE)) {
    $builders[] = 'df_setup_entity_builder_article_digital_exclusive';
  }

  $form['df_digital_exclusive_checkbox'] = [
    '#type' => 'checkbox',
    '#title' => (string) t('Show under Digital Exclusives'),
    '#description' => (string) t('Lists this story in the homepage Digital Exclusives row and on /digital-exclusives—the same intent as choosing the Digital Exclusives category in WordPress. You can assign a magazine Issue and turn this on; they are independent, like on the previous site.'),
    '#default_value' => _df_setup_article_channels_has_exclusive_term($entity, $tid),
    '#weight' => 10,
  ];

  // Place Issue first, then placement for DE list, then channel refinements for admins.
  if (isset($form['field_issue'])) {
    $form['field_issue']['#weight'] = 9;
  }
  if (isset($form['field_channels'])) {
    $form['field_channels']['#weight'] = 11;
    $form['field_channels']['#description'] = (string) t('Only needed for additional Channels terms besides Digital Exclusives. Editors typically leave this blank and use only the checkbox above.');
    // Taxonomy admins can still assign arbitrary channel terms; others use the checkbox.
    $form['field_channels']['#access'] = \Drupal::currentUser()->hasPermission('administer taxonomy');
  }

  _df_setup_alter_article_credit_fields($form);
  _df_setup_alter_article_photo_caption_field($form);
}

/**
 * Article credit fields: store names only; show fixed prefixes in the form UI.
 */
function _df_setup_alter_article_credit_fields(array &$form): void {
  if (isset($form['field_byline']['widget'][0]['value'])) {
    $element = &$form['field_byline']['widget'][0]['value'];
    $element['#field_prefix'] = ArticleCreditLabels::BYLINE_PREFIX;
    if (isset($element['#default_value']) && is_string($element['#default_value'])) {
      $element['#default_value'] = ArticleCreditLabels::stripByline($element['#default_value']);
    }
    $form['field_byline']['#description'] = (string) t('Enter the author name only (e.g., Amber Sinicrope). The site displays this as “By [name]”.');
  }

  if (isset($form['field_photo_credit']['widget'][0]['value'])) {
    $element = &$form['field_photo_credit']['widget'][0]['value'];
    $element['#field_prefix'] = ArticleCreditLabels::PHOTO_CREDIT_PREFIX;
    if (isset($element['#default_value']) && is_string($element['#default_value'])) {
      $element['#default_value'] = ArticleCreditLabels::stripPhotoCredit($element['#default_value']);
    }
    $form['field_photo_credit']['#description'] = (string) t('Enter the photographer name only (e.g., Bryce Vickmark). The site displays this as “Photography by [name]”.');
  }
}

/**
 * Photo caption is only relevant when a featured image is selected.
 */
function _df_setup_alter_article_photo_caption_field(array &$form): void {
  if (!isset($form['field_photo_caption'])) {
    return;
  }

  $form['field_photo_caption']['#description'] = (string) t('Optional caption shown beneath the featured image (e.g., subject name and title).');
  $form['field_photo_caption']['#states'] = [
    'visible' => [
      ':input[name="field_featured_image[0][target_id]"]' => ['filled' => TRUE],
    ],
  ];
}

/**
 * Implements hook_preprocess_field().
 *
 * Adds display prefixes for article byline and photo credit fields.
 */
function df_setup_preprocess_field(array &$variables): void {
  $entity = $variables['element']['#object'] ?? NULL;
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'article') {
    return;
  }

  $formatter = match ($variables['field_name']) {
    'field_byline' => [ArticleCreditLabels::class, 'formatByline'],
    'field_photo_credit' => [ArticleCreditLabels::class, 'formatPhotoCredit'],
    default => NULL,
  };
  if ($formatter === NULL) {
    return;
  }

  foreach ($variables['items'] as &$item) {
    if (!isset($item['content']) || !is_array($item['content'])) {
      continue;
    }
    if (isset($item['content']['#plain_text']) && is_string($item['content']['#plain_text'])) {
      $item['content']['#plain_text'] = $formatter($item['content']['#plain_text']);
    }
    elseif (isset($item['content']['#markup']) && is_string($item['content']['#markup'])) {
      $item['content']['#markup'] = Html::escape($formatter(Html::decodeEntities($item['content']['#markup'])));
    }
    elseif (isset($item['content']['#context']['value']) && is_string($item['content']['#context']['value'])) {
      $item['content']['#context']['value'] = $formatter($item['content']['#context']['value']);
    }
  }
}

/**
 * Applies the Digital Exclusive checkbox onto field_channels during entity_build.
 *
 * Runs after widgets copy onto the draft entity.
 */
function df_setup_entity_builder_article_digital_exclusive(string $entity_type_id, EntityInterface $entity, array &$form, FormStateInterface $form_state): void {
  unset($entity_type_id);
  if (!$entity instanceof NodeInterface || !$entity->hasField('field_channels')) {
    return;
  }

  /** @var \Drupal\df_setup\DigitalExclusiveChannels $channels */
  $channels = \Drupal::service('df_setup.digital_exclusive_channels');
  $tid = $channels->ensureTermId();
  if (!$tid || !isset($form['df_digital_exclusive_checkbox'])) {
    return;
  }

  $want = !$form_state->isValueEmpty('df_digital_exclusive_checkbox');

  /** @var int[] $tids */
  $tids = array_map(static function (array $row): int {
    return (int) ($row['target_id'] ?? 0);
  }, $entity->get('field_channels')->getValue());

  $tids = array_values(array_filter(array_unique($tids), static fn ($id) => $id > 0));
  $has_exclusive = in_array($tid, $tids, TRUE);

  if ($want && !$has_exclusive) {
    $tids[] = $tid;
  }
  elseif (!$want && $has_exclusive) {
    $tids = array_values(array_filter($tids, static fn ($id) => $id !== $tid));
  }

  $references = [];
  foreach ($tids as $id) {
    $references[] = ['target_id' => $id];
  }
  $entity->set('field_channels', $references);
}

/**
 * Checks whether node already references Digital Exclusives tid.
 */
function _df_setup_article_channels_has_exclusive_term(NodeInterface $node, int $tid): bool {
  if (!$node->hasField('field_channels')) {
    return FALSE;
  }
  foreach ($node->get('field_channels')->getValue() as $row) {
    if ((int) ($row['target_id'] ?? 0) === $tid) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Implements hook_views_query_alter().
 *
 * Filters Digital Exclusives Views by field_channels (taxonomy) because term IDs
 * are environment-specific and cannot be stored reliably in exported Views config.
 */
function df_setup_views_query_alter(ViewExecutable $view, QueryPluginBase $query): void {
  if (!$query instanceof Sql) {
    return;
  }

  $view_id = $view->storage->id();
  $display = $view->current_display ?? '';

  if ($view_id === 'issue_articles' && $display === 'homepage_latest') {
    $alias = $query->ensureTable('node__field_homepage_sort_weight');
    if ($alias) {
      $query->addWhere(0, "{$alias}.field_homepage_sort_weight_value", 100, '<');
      $query->addWhere(0, "{$alias}.field_homepage_sort_weight_value", 0, '>');
    }
  }

  if ($view_id === 'homepage_digital_exclusives') {
    $alias = $query->ensureTable('node__field_homepage_sort_weight');
    if ($alias) {
      $query->addWhere(0, "{$alias}.field_homepage_sort_weight_value", 110, '>=');
      $query->addWhere(0, "{$alias}.field_homepage_sort_weight_value", 200, '<');
    }
  }

  $ids = ['homepage_digital_exclusives', 'digital_exclusives_archive'];
  if (!in_array($view_id, $ids, TRUE)) {
    return;
  }

  /** @var \Drupal\df_setup\DigitalExclusiveChannels $channels */
  $channels = \Drupal::service('df_setup.digital_exclusive_channels');
  $tid = $channels->findTermId() ?? $channels->ensureTermId();

  $base_table = $view->storage->get('base_table');
  $base_field = $view->storage->get('base_field');

  if (!$tid) {
    $query->addWhereExpression(0, '1 = 0');
    return;
  }

  $base_alias = $query->ensureTable($base_table) ?: $base_table;
  // Integer literal avoids placeholder collisions inside Views' formula WHERE clauses.
  $tid_sql = (int) $tid;
  $snippet = "{$base_alias}.{$base_field} IN (SELECT fc.entity_id FROM {node__field_channels} fc WHERE fc.bundle = 'article' AND fc.deleted = 0 AND fc.field_channels_target_id = {$tid_sql})";
  $query->addWhereExpression(0, $snippet);
}

/**
 * Implements hook_views_pre_build().
 *
 * Resolves /category/{slug} path components to term IDs before taxonomy_index
 * contextual filters run (entity:taxonomy_term validation expects a TID).
 */
function df_setup_views_pre_build(ViewExecutable $view): void {
  if ($view->id() !== 'topic_archive' || ($view->current_display ?? '') !== 'page_1') {
    return;
  }
  $raw = $view->args[0] ?? '';
  if ($raw === '' || $raw === NULL) {
    return;
  }
  if (ctype_digit((string) $raw)) {
    return;
  }
  $slug = mb_strtolower(trim((string) $raw), 'UTF-8');
  $tids = df_setup_topic_term_tids_for_category_slug($slug);
  if ($tids !== []) {
    $view->args[0] = implode('+', $tids);
  }
}

/**
 * Implements hook_entity_presave().
 *
 * Clears stray HTML entities in titles/alts migrated from WordPress so escaper
 * does not produce literals like "&amp;" for visitors.
 */
/**
 * Implements hook_pathauto_alias_alter().
 *
 * Issue URLs on WordPress use /{season}-{year}-issue/ (not /issues/…).
 */
function df_setup_pathauto_alias_alter(&$alias, array $context): void {
  if (($context['module'] ?? '') !== 'node' || ($context['bundle'] ?? '') !== 'issue') {
    return;
  }
  $node = $context['data'] ?? NULL;
  if (!$node instanceof NodeInterface) {
    return;
  }
  $season = (string) ($node->get('field_season')->value ?? '');
  $year = (string) ($node->get('field_year')->value ?? '');
  $slug = preg_replace('/[^a-z0-9]+/', '-', mb_strtolower($season, 'UTF-8'));
  $slug = trim(preg_replace('/-+/', '-', (string) $slug), '-');
  if ($slug !== '' && $year !== '') {
    $alias = '/' . $slug . '-' . $year . '-issue';
  }
}

function df_setup_entity_presave(EntityInterface $entity): void {
  if ($entity instanceof NodeInterface && $entity->bundle() === 'article') {
    $title = $entity->getTitle();
    $decoded = Html::decodeEntities($title);
    if ($decoded !== $title && $decoded !== '') {
      $entity->setTitle($decoded);
    }

    if ($entity->hasField('field_byline') && !$entity->get('field_byline')->isEmpty()) {
      $entity->set('field_byline', ArticleCreditLabels::stripByline((string) $entity->get('field_byline')->value));
    }
    if ($entity->hasField('field_photo_credit') && !$entity->get('field_photo_credit')->isEmpty()) {
      $entity->set('field_photo_credit', ArticleCreditLabels::stripPhotoCredit((string) $entity->get('field_photo_credit')->value));
    }
    return;
  }

  if ($entity->getEntityTypeId() !== 'media' || $entity->bundle() !== 'image' || !$entity->hasField('field_media_image')) {
    return;
  }

  $values = $entity->get('field_media_image')->getValue();
  $changed = FALSE;
  foreach ($values as $i => $row) {
    if (empty($row['alt'])) {
      continue;
    }
    $alt = (string) $row['alt'];
    $decoded_alt = Html::decodeEntities($alt);
    if ($decoded_alt !== $alt && $decoded_alt !== '') {
      $values[$i]['alt'] = $decoded_alt;
      $changed = TRUE;
    }
  }
  if ($changed) {
    $entity->set('field_media_image', $values);
  }
}

/**
 * Builds a WP-style category slug from a topic term label (e.g. /category/cancer-research).
 */
function df_setup_topic_category_slug(string $name): string {
  $name = trim(Html::decodeEntities($name));
  $lower = mb_strtolower($name, 'UTF-8');
  $slug = preg_replace('/[^a-z0-9]+/u', '-', $lower);
  $slug = preg_replace('/-+/', '-', (string) $slug);
  return trim((string) $slug, '-');
}

/**
 * Returns topic term IDs matching a URL slug (WP /category/[name] parity).
 *
 * The topics vocabulary sometimes contains duplicate terms with identical
 * names (likely from migrated revisions). Articles may reference whichever
 * duplicate has content; callers must UNION all IDs for correct listings.
 *
 * @return int[]
 */
function df_setup_topic_term_tids_for_category_slug(string $slug): array {
  $slug = trim(mb_strtolower($slug, 'UTF-8'), '/');
  if ($slug === '') {
    return [];
  }
  /** @var \Drupal\taxonomy\TermStorageInterface $storage */
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $tree = $storage->loadTree('topics', 0, NULL, TRUE);
  $tids = [];
  foreach ($tree as $item) {
    if (!$item instanceof TermInterface) {
      continue;
    }
    if (!$item->isPublished()) {
      continue;
    }
    if (df_setup_topic_category_slug($item->getName()) === $slug) {
      $tids[] = (int) $item->id();
    }
  }
  sort($tids);
  return array_values(array_unique($tids));
}

/**
 * Loads one published topics term matching a slug (first ID after sorting).
 */
function df_setup_topic_term_load_by_category_slug(string $slug): ?TermInterface {
  $tids = df_setup_topic_term_tids_for_category_slug($slug);
  if (!$tids) {
    return NULL;
  }
  /** @var \Drupal\taxonomy\TermStorageInterface $storage */
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  /** @var \Drupal\taxonomy\TermInterface|null $term */
  $term = $storage->load($tids[0]);
  return $term instanceof TermInterface ? $term : NULL;
}

/**
 * Magazine season order within a calendar year (Fall issue is “latest” for a year).
 */
function df_setup_issue_season_weight(string $season): int {
  return match (mb_strtolower(trim($season), 'UTF-8')) {
    'fall', 'autumn' => 4,
    'summer' => 3,
    'spring' => 2,
    'winter' => 1,
    default => 0,
  };
}

/**
 * Returns the newest published issue node ID (year desc, season weight desc).
 */
function df_setup_get_latest_issue_nid(): ?int {
  if (\Drupal::moduleHandler()->moduleExists('df_editor')) {
    $preview = \Drupal::service('df_editor.issue_preview')->getPreviewIssueNid();
    if ($preview !== NULL) {
      return $preview;
    }
  }
  $issues = df_setup_load_published_issues_sorted();
  if ($issues === []) {
    return NULL;
  }
  $best = reset($issues);
  return $best instanceof NodeInterface ? (int) $best->id() : NULL;
}

/**
 * Published issue nodes sorted newest first (year desc, season weight desc).
 *
 * @return \Drupal\node\NodeInterface[]
 */
function df_setup_load_published_issues_sorted(): array {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $nids = $storage->getQuery()
    ->condition('type', 'issue')
    ->condition('status', 1)
    ->accessCheck(FALSE)
    ->execute();
  if (!$nids) {
    return [];
  }
  $nodes = $storage->loadMultiple($nids);
  $issues = [];
  foreach ($nodes as $node) {
    if ($node instanceof NodeInterface) {
      $issues[] = $node;
    }
  }
  usort($issues, static function (NodeInterface $a, NodeInterface $b): int {
    $year_a = (int) ($a->get('field_year')->value ?? 0);
    $year_b = (int) ($b->get('field_year')->value ?? 0);
    if ($year_a !== $year_b) {
      return $year_b <=> $year_a;
    }
    $season_a = df_setup_issue_season_weight((string) ($a->get('field_season')->value ?? ''));
    $season_b = df_setup_issue_season_weight((string) ($b->get('field_season')->value ?? ''));
    return $season_b <=> $season_a;
  });
  return $issues;
}

/**
 * Header Issues dropdown links from published issues (newest first).
 *
 * @return array<int, array{title: string, url: string}>
 */
function df_setup_get_header_issue_links(int $limit = 4): array {
  $links = [];
  $issues = df_setup_load_published_issues_sorted();
  if (\Drupal::moduleHandler()->moduleExists('df_editor')) {
    $preview_nid = \Drupal::service('df_editor.issue_preview')->getPreviewIssueNid();
    if ($preview_nid !== NULL) {
      $preview = \Drupal::entityTypeManager()->getStorage('node')->load($preview_nid);
      if ($preview instanceof NodeInterface) {
        $issues = array_values(array_filter(
          $issues,
          static fn (NodeInterface $issue): bool => (int) $issue->id() !== $preview_nid,
        ));
        array_unshift($issues, $preview);
      }
    }
  }
  foreach (array_slice($issues, 0, $limit) as $issue) {
    $links[] = [
      'title' => df_setup_format_issue_nav_label($issue),
      'url' => $issue->toUrl()->toString(),
    ];
  }
  return $links;
}

/**
 * Short issue label for navigation (e.g. "Fall 2026").
 */
function df_setup_format_issue_nav_label(NodeInterface $issue): string {
  if (function_exists('df_impact_format_issue_label')) {
    return (string) df_impact_format_issue_label($issue);
  }
  $season = ucfirst(trim((string) ($issue->get('field_season')->value ?? '')));
  $year = trim((string) ($issue->get('field_year')->value ?? ''));
  return trim($season . ' ' . $year);
}
