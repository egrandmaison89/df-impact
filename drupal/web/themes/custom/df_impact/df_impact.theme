<?php

/**
 * @file
 * Functions to support theming in the Dana-Farber Impact theme.
 */

use Drupal\Core\Template\Attribute;
use Drupal\Core\Url;
use Drupal\df_setup\ArticleCreditLabels;
use Drupal\node\NodeInterface;
use Drupal\views\ViewExecutable;
use Drupal\views\Views;

/**
 * Implements hook_theme().
 */
function df_impact_theme($existing, $type, $theme, $path) {
  return [
    'in_brief_listing_by_issue' => [
      'variables' => [
        'sections' => [],
      ],
    ],
    'topics_index' => [
      'variables' => [
        'heading' => NULL,
        'items' => [],
      ],
      'template' => 'topics-index',
    ],
  ];
}

/**
 * Groups In Brief nodes by issue; issues newest-first (year, then season).
 *
 * @return list<array{issue_label: string, briefs: \Drupal\node\NodeInterface[]}>
 */
function df_impact_group_in_brief_nodes_by_issue(): array {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $nids = $storage->getQuery()
    ->condition('type', 'in_brief')
    ->condition('status', 1)
    ->accessCheck()
    ->execute();
  if (!$nids) {
    return [];
  }

  /** @var \Drupal\node\NodeInterface[] $nodes */
  $nodes = $storage->loadMultiple($nids);
  $by_issue = [];
  foreach ($nodes as $node) {
    if (!$node->hasField('field_issue') || $node->get('field_issue')->isEmpty()) {
      continue;
    }
    $issue_id = (string) $node->get('field_issue')->target_id;
    $by_issue[$issue_id][] = $node;
  }

  foreach ($by_issue as &$briefs) {
    usort($briefs, static function (NodeInterface $a, NodeInterface $b): int {
      return $b->getCreatedTime() <=> $a->getCreatedTime();
    });
  }

  $season_weight = [
    'spring' => 1,
    'summer' => 2,
    'fall' => 3,
    'winter' => 4,
  ];

  $issue_ids = array_keys($by_issue);
  /** @var \Drupal\node\NodeInterface[] $issues */
  $issues = $storage->loadMultiple($issue_ids);
  usort($issue_ids, static function (string $a, string $b) use ($issues, $season_weight): int {
    $ia = $issues[$a] ?? NULL;
    $ib = $issues[$b] ?? NULL;
    if (!$ia || !$ib || $ia->bundle() !== 'issue' || $ib->bundle() !== 'issue') {
      return 0;
    }
    $ya = (int) ($ia->get('field_year')->value ?? 0);
    $yb = (int) ($ib->get('field_year')->value ?? 0);
    if ($ya !== $yb) {
      return $yb <=> $ya;
    }
    $wa = $season_weight[$ia->get('field_season')->value] ?? 0;
    $wb = $season_weight[$ib->get('field_season')->value] ?? 0;
    return $wb <=> $wa;
  });

  $out = [];
  foreach ($issue_ids as $issue_id) {
    $issue = $issues[$issue_id] ?? NULL;
    if (!$issue || $issue->bundle() !== 'issue') {
      continue;
    }
    $label = df_impact_format_issue_label($issue);
    if ($label === NULL) {
      $label = $issue->label();
    }
    $out[] = [
      'issue_label' => $label,
      'briefs' => $by_issue[$issue_id],
    ];
  }

  return $out;
}

/**
 * Build renderable sections for the In Brief archive (per-issue wrappers).
 *
 * @param list<array{issue_label: string, briefs: \Drupal\node\NodeInterface[]}>|null $grouped
 *   Grouped nodes; loads when NULL.
 */
function df_impact_build_in_brief_listing_sections(?array $grouped = NULL): array {
  $grouped ??= df_impact_group_in_brief_nodes_by_issue();
  $view_builder = \Drupal::entityTypeManager()->getViewBuilder('node');
  $sections = [];
  $ultp_block_ids = [
    '9a02d2',
    '0eb052',
    '3c7cc6',
    '317443',
    '57d46b',
    'a1b2c3',
    'd4e5f6',
    '789abc',
  ];

  foreach ($grouped as $index => $row) {
    $items = [];
    foreach ($row['briefs'] as $i => $node) {
      $build = $view_builder->view($node, 'in_brief_listing');
      if ($i >= 5) {
        $build['#in_brief_collapsed'] = TRUE;
      }
      $items[] = $build;
    }
    $sections[] = [
      'issue_label' => $row['issue_label'],
      'items' => $items,
      'show_more' => count($row['briefs']) > 5,
      'ultp_block_id' => $ultp_block_ids[$index % count($ultp_block_ids)],
    ];
  }

  return $sections;
}

/**
 * Implements hook_views_post_render().
 */
function df_impact_views_post_render(ViewExecutable $view, array &$output, $cache): void {
  if ($view->storage->id() !== 'in_brief_listing' || $view->current_display !== 'page_1') {
    return;
  }

  $grouped = df_impact_group_in_brief_nodes_by_issue();
  if ($grouped === []) {
    return;
  }

  $sections = df_impact_build_in_brief_listing_sections($grouped);
  $tags = [];
  foreach ($grouped as $row) {
    foreach ($row['briefs'] as $node) {
      $tags[] = 'node:' . $node->id();
      if ($node->hasField('field_issue') && !$node->get('field_issue')->isEmpty()) {
        $tags[] = 'node:' . $node->get('field_issue')->target_id;
      }
    }
  }

  // Theme variables must use #name keys when the element has #theme
  // (ThemeManager::render); plain 'sections' is ignored.
  $output['#rows'] = [
    '#theme' => 'in_brief_listing_by_issue',
    '#attached' => [
      'library' => ['df_impact/in_brief_page'],
    ],
    '#cache' => [
      'tags' => array_values(array_unique($tags)),
    ],
    '#sections' => $sections,
  ];

  if ($sections !== []) {
    $output['#empty'] = [];
  }
}

/**
 * Resolves the node entity for a Views result row (prefer _entity).
 */
function df_impact_views_result_row_node($row): ?NodeInterface {
  if (!$row) {
    return NULL;
  }
  if (isset($row->_entity) && $row->_entity instanceof NodeInterface) {
    return $row->_entity;
  }
  foreach (['nid', 'node_field_data_nid'] as $prop) {
    if (!empty($row->{$prop})) {
      $nid = (int) $row->{$prop};
      if ($nid > 0) {
        $node = \Drupal::entityTypeManager()->getStorage('node')->load($nid);
        if ($node instanceof NodeInterface) {
          return $node;
        }
      }
    }
  }
  return NULL;
}

/**
 * Implements hook_preprocess_views_view().
 */
function df_impact_preprocess_views_view(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view) {
    return;
  }
  $homepage_views = ['homepage_digital_exclusives', 'homepage_highlights', 'issue_articles'];
  if ($view->id() === 'issue_articles') {
    $variables['title'] = '';
  }
  if (in_array($view->id(), $homepage_views, TRUE)) {
    $variables['title'] = '';
  }
  if ($view->id() === 'in_brief_listing' && $view->current_display === 'page_1') {
    $variables['title'] = '';
  }
  if ($view->id() === 'browse_issues' && $view->current_display === 'page_1') {
    $variables['title'] = '';
  }
  if ($view->id() === 'topic_archive' && $view->current_display === 'page_1') {
    $variables['topic_archive_heading'] = df_impact_topic_archive_term_label() ?? '';
    $variables['title'] = '';
  }
  if ($view->id() === 'past_issues' && $view->current_display === 'page_1') {
    $variables['title'] = '';
  }
  if ($view->id() === 'stories_archive' && $view->current_display === 'page_1') {
    $variables['title'] = '';
  }
  if (in_array($view->id(), [
    'digital_exclusives_archive',
    'topic_archive',
    'stories_archive',
    'past_issues',
    'in_brief_listing',
    'browse_issues',
  ], TRUE)) {
    if ($view->id() === 'digital_exclusives_archive' && $view->current_display === 'page_1') {
      $variables['title'] = '';
    }
    $variables['#attached']['library'][] = 'df_impact/archive_listings';
  }
}

/**
 * Implements hook_preprocess_views_view_unformatted().
 */
function df_impact_preprocess_views_view_unformatted(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view || $view->id() !== 'browse_issues') {
    return;
  }
  $rows = $variables['rows'] ?? [];
  if ($rows === []) {
    return;
  }
  $flex_rows = [];
  foreach (array_chunk($rows, 4) as $group) {
    $flex_rows[] = $group;
  }
  $variables['browse_issue_flex_rows'] = $flex_rows;
}

/**
 * Implements hook_preprocess_views_view_fields().
 */
function df_impact_preprocess_views_view_fields(&$variables): void {
  if (is_array($variables['row'] ?? NULL)) {
    unset($variables['row']['#contextual_links']);
  }
  $view = $variables['view'] ?? NULL;
  if (!$view) {
    return;
  }
  $view_id = $view->storage->id();
  if ($view_id === 'browse_issues') {
    $node = df_impact_views_result_row_node($variables['row'] ?? NULL);
    if (!$node instanceof NodeInterface || $node->bundle() !== 'issue') {
      return;
    }
    $variables['issue_url'] = $node->toUrl()->toString();
    $variables['issue_thumbnail'] = df_impact_build_issue_browse_thumbnail($node);
    $cover = df_impact_issue_browse_cover_meta($node);
    $variables['issue_cover_url'] = $cover['url'] ?? NULL;
    $variables['issue_cover_alt'] = $cover['alt'] ?? $node->label();
    $variables['issue_title_plain'] = df_impact_format_issue_label($node)
      ?? df_impact_decode_plain_text($node->label());
    return;
  }
  if ($view_id === 'issue_articles') {
    $display = $view->current_display ?? '';
    if ($display === 'homepage_latest' || $display === 'block_1') {
      df_impact_preprocess_homepage_article_card_fields($variables);
    }
    return;
  }

  if (in_array($view_id, ['topic_archive', 'digital_exclusives_archive', 'stories_archive'], TRUE)) {
    $variables['article_url'] = NULL;
    $node = df_impact_views_result_row_node($variables['row'] ?? NULL);
    if ($node instanceof NodeInterface) {
      try {
        $variables['article_url'] = $node->toUrl()->toString();
      }
      catch (\Exception) {
        $variables['article_url'] = NULL;
      }
      $meta = df_impact_archive_row_image_meta($node);
      $variables['archive_featured_image_url'] = $meta['url'] ?? NULL;
      $variables['archive_featured_image_alt'] = $meta['alt'] ?? $node->label();
      $variables['archive_featured_image_width'] = $meta['width'] ?? 1450;
      $variables['archive_featured_image_height'] = $meta['height'] ?? 1040;
      $variables['archive_excerpt'] = df_impact_archive_excerpt_for_node($node);
      $variables['archive_title_plain'] = df_impact_decode_plain_text($node->label());
    }
    return;
  }

  $homepage_card_views = [
    'homepage_featured',
    'homepage_highlights',
    'homepage_digital_exclusives',
  ];
  if (in_array($view_id, $homepage_card_views, TRUE)) {
    $display = $view->current_display ?? '';
    if ($display === 'default' || $display === 'block_1') {
      df_impact_preprocess_homepage_article_card_fields($variables);
    }
  }
}

/**
 * Implements hook_preprocess_html().
 */
function df_impact_preprocess_html(array &$variables): void {
  // Safe defaults when df_site_snippets is disabled (module runs first when enabled).
  $variables += [
    'df_site_snippets_header' => NULL,
    'df_site_snippets_footer' => NULL,
  ];
  $route = \Drupal::routeMatch()->getRouteName();
  $variables['is_category_archive'] = ($route === 'view.topic_archive.page_1');

  // Views argument title "%1" leaks into <title> for topic archives.
  if ($variables['is_category_archive']) {
    $topic_title = df_impact_topic_archive_term_label();
    if ($topic_title !== NULL && !empty($variables['head_title']) && is_array($variables['head_title'])) {
      $variables['head_title']['title'] = $topic_title . ' Archives - Impact Magazine';
    }
  }
}

/**
 * Implements hook_preprocess_page().
 */
function df_impact_preprocess_page(&$variables) {
  $front = Url::fromRoute('<front>')->toString();
  $variables['wp_home_url'] = str_ends_with($front, '/') ? $front : $front . '/';
  $request = \Drupal::request();
  $origin = $request->getSchemeAndHttpHost() . $request->getBasePath();
  // Migrated media lives under public://wp-images (not WP uploads path segments).
  $variables['wp_uploads_base'] = rtrim($origin, '/') . '/sites/default/files/wp-images/';
  // Match Mac reference-pack header logo (i0.wp.com derivatives, not local theme stub).
  $logo_base = 'https://i0.wp.com/danafarberimpact.org/wp-content/uploads/2023/03/ImpactDFJF_HeaderLogo_878.png';
  $variables['wp_logo_url'] = $logo_base . '?ssl=1';
  $variables['wp_logo_srcset'] = implode(', ', [
    $logo_base . '?w=878&ssl=1 878w',
    $logo_base . '?resize=300%2C80&ssl=1 300w',
    $logo_base . '?resize=150%2C40&ssl=1 150w',
    $logo_base . '?resize=768%2C206&ssl=1 768w',
  ]);

  // Add the current year for copyright.
  $variables['current_year'] = date('Y');

  // Check if we're on the front page.
  $variables['is_front'] = \Drupal::service('path.matcher')->isFrontPage();
  $variables['is_about_impact'] = df_impact_is_about_impact_page();

  $route_node = \Drupal::routeMatch()->getParameter('node');
  if ($route_node instanceof NodeInterface && in_array($route_node->bundle(), ['article', 'in_brief'], TRUE)) {
    $variables['wp_singular_post_title'] = $route_node->label();
  }

  // Donate CTA — defaults match WordPress; df_editor Site settings override when set.
  $variables['donate_url'] = 'https://danafarber.jimmyfund.org/site/Donation2?df_id=2101&mfc_pref=T&2101.donation=form1&utm_source=dfimpact&utm_medium=button&utm_campaign=AGDFI031323&s_src=AGDFI031323&s_subsrc=AGDFI031323';
  if (\Drupal::moduleHandler()->moduleExists('df_editor')) {
    \Drupal::service('df_editor.site_chrome')->applyPreprocessPage($variables);
  }
  $route_provider = \Drupal::service('router.route_provider');
  if ($route_provider->getRoutesByNames(['df_searchstax.page'])) {
    $variables['search_page_url'] = Url::fromRoute('df_searchstax.page')->toString();
  }
  else {
    $variables['search_page_url'] = Url::fromRoute('view.df_impact_search.page_1')->toString();
  }

  $variables['about_impact_url'] = Url::fromUri('internal:/about')->toString();

  // Header Issues dropdown — recent published issues (WordPress chrome).
  if (function_exists('df_setup_get_header_issue_links')) {
    $variables['header_issue_links'] = df_setup_get_header_issue_links(4);
  }
  else {
    $variables['header_issue_links'] = df_impact_get_header_issue_links(4);
  }

  // WXR wp_navigation "Main Nav" + dropdown-menu (Issues submenu items as top links).
  $latest_issue_url = NULL;
  $latest_nid = df_impact_get_latest_issue_nid();
  if ($latest_nid !== NULL) {
    $latest_issue = \Drupal::entityTypeManager()->getStorage('node')->load($latest_nid);
    if ($latest_issue instanceof NodeInterface) {
      $latest_issue_url = $latest_issue->toUrl()->toString();
    }
  }
  if (empty($variables['header_primary_links'])) {
    $variables['header_primary_links'] = [
      [
        'title' => t('Current Issue'),
        'url' => $latest_issue_url ?: Url::fromRoute('view.browse_issues.page_1')->toString(),
      ],
      [
        'title' => t('Past Issues'),
        'url' => Url::fromRoute('view.past_issues.page_1')->toString(),
      ],
      [
        'title' => t('About'),
        'url' => $variables['about_impact_url'],
      ],
    ];
  }

  if (\Drupal::moduleHandler()->moduleExists('df_editor') && !empty($variables['header_primary_links'])) {
    $variables['header_primary_links'] = \Drupal::service('df_editor.current_issue_nav')
      ->applyCurrentIssueUrl($variables['header_primary_links']);
  }

  $topic_order = [
    'Cancer Research',
    'Total Patient Care',
    'Prevention and Early Detection',
    'Access and Equity',
    'Immunotherapy',
    'Drug Development',
    'Pediatrics',
    'Grassroots Support',
    'Discovery Science',
    'Planned Giving',
  ];
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $footer_topic_links = [];
  foreach ($topic_order as $name) {
    $terms = $term_storage->loadByProperties([
      'vid' => 'topics',
      'name' => $name,
    ]);
    $term = reset($terms);
    if ($term && $term->isPublished()) {
      $footer_topic_links[] = [
        'title' => $term->label(),
        'url' => Url::fromUri('internal:/category/' . df_setup_topic_category_slug($term->label()))->toString(),
      ];
    }
  }
  $variables['footer_topic_links'] = $footer_topic_links;
  $variables['homepage_digital_exclusives_url'] = Url::fromUri('internal:/category/digital-exclusives')->toString();

  // Front page: stories from the newest issue (WordPress "Explore" band).
  $variables['latest_issue_articles'] = NULL;
  $variables['latest_issue_url'] = NULL;
  $variables['latest_issue_label'] = NULL;
  $variables['homepage_hero'] = NULL;
  if (df_impact_is_wordpress_homepage_path()) {
    $latest_nid = df_impact_get_latest_issue_nid();
    if ($latest_nid !== NULL) {
      $issue = \Drupal::entityTypeManager()->getStorage('node')->load($latest_nid);
      if ($issue instanceof NodeInterface && $issue->bundle() === 'issue') {
        $variables['latest_issue_url'] = $issue->toUrl()->toString();
        $variables['latest_issue_label'] = df_impact_format_issue_label($issue);
        $variables['homepage_hero'] = df_impact_build_homepage_hero($issue);
      }
      $view = Views::getView('issue_articles');
      if ($view) {
        $view->setDisplay('homepage_latest');
        $view->setArguments([(string) $latest_nid]);
        $view->execute();
        if (!empty($view->result)) {
          $variables['latest_issue_articles'] = $view->buildRenderable('homepage_latest', [(string) $latest_nid]);
        }
      }
    }
  }

}

/**
 * Implements hook_preprocess_node().
 */
function df_impact_preprocess_node(&$variables) {
  $node = $variables['node'];
  unset($variables['elements']['#contextual_links']);

  // Add view mode class.
  $variables['attributes']['class'][] = 'node--view-mode-' . str_replace('_', '-', $variables['view_mode']);
  $variables['is_about_impact_node'] = df_impact_is_about_impact_page($node);

  if ($node->bundle() === 'in_brief' && $variables['view_mode'] === 'in_brief_listing') {
    $variables['in_brief_collapsed'] = !empty($variables['elements']['#in_brief_collapsed']);
    $variables['in_brief_item_url'] = df_impact_in_brief_item_url($node);
    $image = df_impact_in_brief_card_image_meta($node);
    $variables['in_brief_image_url'] = $image['url'] ?? NULL;
    $variables['in_brief_image_alt'] = $image['alt'] ?? $node->label();
    $variables['in_brief_excerpt'] = df_impact_in_brief_plain_excerpt($node);
  }

  if ($node->bundle() === 'in_brief' && $variables['view_mode'] === 'full') {
    $variables['in_brief_item_url'] = df_impact_in_brief_item_url($node);
    $image = df_impact_in_brief_card_image_meta($node);
    $variables['in_brief_image_url'] = $image['url'] ?? NULL;
    $variables['in_brief_image_alt'] = $image['alt'] ?? $node->label();
    $variables['in_brief_excerpt'] = df_impact_in_brief_plain_excerpt($node);
    $variables['in_brief_byline'] = df_impact_in_brief_byline($node);
    $variables['in_brief_listing_excerpt'] = df_impact_in_brief_listing_excerpt($node);
    if ($node->hasField('field_summary') && !$node->get('field_summary')->isEmpty()) {
      $summary = (string) $node->get('field_summary')->value;
      if ($variables['in_brief_image_url']) {
        $summary = df_impact_article_strip_leading_wp_image_block($summary);
      }
      $summary = df_impact_article_add_drop_cap_class($summary);
      if (isset($variables['content']['field_summary'])) {
        $variables['content']['field_summary']['#access'] = FALSE;
      }
      $variables['in_brief_body'] = [
        '#type' => 'processed_text',
        '#text' => $summary,
        '#format' => $node->get('field_summary')->format ?? 'full_html',
        '#langcode' => $node->language()->getId(),
      ];
    }
    $variables['in_brief_issue_url'] = NULL;
    $variables['in_brief_issue_label'] = NULL;
    if ($node->hasField('field_issue') && !$node->get('field_issue')->isEmpty()) {
      $issue = $node->get('field_issue')->entity;
      if ($issue instanceof NodeInterface) {
        $variables['in_brief_issue_url'] = $issue->toUrl()->toString();
        $variables['in_brief_issue_label'] = $issue->label();
      }
    }
  }

  if ($node->bundle() === 'issue' && $variables['view_mode'] === 'teaser') {
    $cover = df_impact_issue_banner_meta($node);
    $variables['issue_cover_url'] = $cover['url'] ?? NULL;
    $variables['issue_cover_alt'] = $cover['alt'] ?? $node->label();
  }

  // Issue full: promo cards below In Brief (WordPress layout).
  if ($node->bundle() === 'issue' && $variables['view_mode'] === 'full') {
    $banner = df_impact_issue_banner_meta($node);
    $variables['issue_banner_url'] = $banner['url'] ?? NULL;
    $variables['issue_banner_alt'] = $banner['alt'] ?? $node->label();
    $variables['issue_banner_width'] = $banner['width'] ?? 1024;
    $variables['issue_banner_height'] = $banner['height'] ?? 396;
    $variables['issue_promo_cards'] = [];
    $view_builder = \Drupal::entityTypeManager()->getViewBuilder('node');
    foreach (['field_leadership_message', 'field_issue_promo_2'] as $field_name) {
      if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
        continue;
      }
      $referenced = $node->get($field_name)->entity;
      if ($referenced instanceof NodeInterface) {
        $variables['issue_promo_cards'][] = $view_builder->view($referenced, 'issue_promo');
      }
    }
  }

  if (in_array($variables['view_mode'], ['issue_promo'], TRUE) && in_array($node->bundle(), ['page', 'article'], TRUE)) {
    $image = df_impact_article_card_image_meta($node);
    if ($image) {
      $variables['issue_promo_image_url'] = $image['url'];
      $variables['issue_promo_image_alt'] = $image['alt'];
      $variables['issue_promo_image_width'] = $image['width'] ?? 768;
      $variables['issue_promo_image_height'] = $image['height'] ?? 551;
    }
    else {
      $banner = df_impact_issue_banner_meta($node);
      $variables['issue_promo_image_url'] = $banner['url'] ?? NULL;
      $variables['issue_promo_image_alt'] = $banner['alt'] ?? $node->label();
    }
    $variables['issue_promo_excerpt'] = '';
    if ($node->hasField('field_excerpt') && !$node->get('field_excerpt')->isEmpty()) {
      $raw = strip_tags($node->get('field_excerpt')->value ?? '');
      $variables['issue_promo_excerpt'] = html_entity_decode($raw, ENT_QUOTES | ENT_HTML5, 'UTF-8');
    }
    elseif ($node->hasField('body') && !$node->get('body')->isEmpty()) {
      $text = strip_tags($node->get('body')->value ?? '');
      $summary = text_summary($text, NULL, 280);
      $variables['issue_promo_excerpt'] = html_entity_decode($summary, ENT_QUOTES | ENT_HTML5, 'UTF-8');
    }
  }

  // For articles, make the issue link available.
  if ($node->bundle() === 'article' && $node->hasField('field_issue') && !$node->get('field_issue')->isEmpty()) {
    $issue = $node->get('field_issue')->entity;
    if ($issue) {
      $variables['issue_title'] = $issue->label();
      $variables['issue_url'] = $issue->toUrl()->toString();
    }
  }

  // Related articles by shared topics when editors did not pick manual related nodes.
  if ($node->bundle() === 'article' && $variables['view_mode'] === 'full') {
    $variables['article_byline_display'] = '';
    if ($node->hasField('field_byline') && !$node->get('field_byline')->isEmpty()) {
      $variables['article_byline_display'] = ArticleCreditLabels::formatByline((string) $node->get('field_byline')->value);
    }
    $variables['article_photo_credit_display'] = '';
    if ($node->hasField('field_photo_credit') && !$node->get('field_photo_credit')->isEmpty()) {
      $variables['article_photo_credit_display'] = ArticleCreditLabels::formatPhotoCredit((string) $node->get('field_photo_credit')->value);
    }
    $variables['article_photo_caption_display'] = '';
    if ($node->hasField('field_photo_caption') && !$node->get('field_photo_caption')->isEmpty()) {
      $variables['article_photo_caption_display'] = trim((string) $node->get('field_photo_caption')->value);
    }

    if (isset($variables['content']['field_featured_image'])) {
      $variables['content']['field_featured_image']['#access'] = FALSE;
    }
    $variables['article_lead_figure'] = df_impact_article_lead_figure_build($node);
    if ($variables['article_lead_figure'] && $node->hasField('body') && !$node->get('body')->isEmpty()) {
      $stripped = df_impact_article_strip_leading_wp_image_block((string) $node->get('body')->value);
      if ($stripped !== (string) $node->get('body')->value) {
        if (isset($variables['content']['body'])) {
          $variables['content']['body']['#access'] = FALSE;
        }
        $stripped = df_impact_article_add_drop_cap_class($stripped);
        $variables['article_body'] = [
          '#type' => 'processed_text',
          '#text' => $stripped,
          '#format' => $node->get('body')->format,
          '#langcode' => $node->language()->getId(),
        ];
      }
    }

    if (isset($variables['content']['field_related_articles'])) {
      $variables['content']['field_related_articles']['#access'] = FALSE;
    }
    if (isset($variables['content']['field_topics'])) {
      $variables['content']['field_topics']['#access'] = FALSE;
    }
    if (isset($variables['content']['field_cancer_types'])) {
      $variables['content']['field_cancer_types']['#access'] = FALSE;
    }
    $variables['article_post_term_links'] = df_impact_article_post_term_links($node);
    $variables['article_more_stories_cards'] = df_impact_article_more_story_cards($node);
  }
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function df_impact_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  if (df_impact_is_wordpress_homepage_path()) {
    $suggestions[] = 'page__front';
    return;
  }
  // Add page template suggestions based on node type.
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof NodeInterface) {
    $suggestions[] = 'page__node__' . $node->bundle();
  }
}

/**
 * WordPress serves the magazine homepage at / and /homepage (legacy page node).
 */
function df_impact_is_wordpress_homepage_path(): bool {
  $path = rtrim(\Drupal::request()->getPathInfo(), '/') ?: '/';
  return \Drupal::service('path.matcher')->isFrontPage() || $path === '/homepage';
}

/**
 * Implements hook_theme_suggestions_node_alter().
 */
function df_impact_theme_suggestions_node_alter(array &$suggestions, array $variables) {
  // Add node--TYPE--VIEW_MODE suggestion.
  $node = $variables['elements']['#node'];
  $view_mode = $variables['elements']['#view_mode'];
  $suggestions[] = 'node__' . $node->bundle() . '__' . $view_mode;
}

/**
 * Implements hook_preprocess_block().
 */
function df_impact_preprocess_block(&$variables) {
  // Pass is_node flag to blocks so page title can be hidden on node pages.
  $node = \Drupal::routeMatch()->getParameter('node');
  $variables['is_node'] = $node instanceof NodeInterface;
  $variables['is_front'] = \Drupal::service('path.matcher')->isFrontPage();
  $variables['is_about_impact'] = df_impact_is_about_impact_page();
  $route = \Drupal::routeMatch()->getRouteName();
  $variables['hide_page_title_block'] = in_array($route, [
    'view.in_brief_listing.page_1',
    'view.browse_issues.page_1',
    'view.topic_archive.page_1',
    'view.digital_exclusives_archive.page_1',
    'view.past_issues.page_1',
    'df_setup.topics_index',
  ], TRUE);
}

/**
 * Implements hook_preprocess_HOOK() for breadcrumb.
 */
function df_impact_preprocess_breadcrumb(array &$variables): void {
  // WordPress front-end pages do not show Drupal-style breadcrumb trails.
  $variables['breadcrumb'] = [];
}

/**
 * Implements hook_preprocess_HOOK() for menu-local-task.
 */
function df_impact_preprocess_menu_local_task(&$variables): void {
  $variables['link']['#options']['attributes']['class'][] = 'tabs__link';

  if (!empty($variables['is_active'])) {
    $variables['link']['#options']['attributes']['class'][] = 'is-active';
  }

  $link = $variables['element']['#link'] ?? [];
  if (!empty($link['url']) && $link['url']->getRouteName() === 'entity.node.delete_form') {
    // During preprocess, attributes may still be an array (Attribute object is applied later).
    $variables['attributes']['class'][] = 'tabs__tab--danger';
  }
}

/**
 * Implements hook_preprocess_field().
 */
function df_impact_preprocess_field(&$variables) {
  // Add article tag styling to taxonomy reference fields.
  $field_name = $variables['field_name'];
  if (in_array($field_name, ['field_topics', 'field_cancer_types'])) {
    foreach ($variables['items'] as &$item) {
      $item['attributes']->addClass('article__tag');
    }
  }
}

/**
 * Implements hook_theme_suggestions_views_view_unformatted_alter().
 */
function df_impact_theme_suggestions_views_view_unformatted_alter(array &$suggestions, array $variables) {
  $view = $variables['view'];
  $suggestions[] = 'views_view_unformatted__' . $view->id();
  $suggestions[] = 'views_view_unformatted__' . $view->id() . '__' . $view->current_display;
}

/**
 * Implements hook_theme_suggestions_views_view_fields_alter().
 */
function df_impact_theme_suggestions_views_view_fields_alter(array &$suggestions, array $variables) {
  $view = $variables['view'];
  $suggestions[] = 'views_view_fields__' . $view->id();
  $suggestions[] = 'views_view_fields__' . $view->id() . '__' . $view->current_display;
}

/**
 * Implements hook_theme_suggestions_views_view_alter().
 */
function df_impact_theme_suggestions_views_view_alter(array &$suggestions, array $variables) {
  $view = $variables['view'];
  $suggestions[] = 'views_view__' . $view->id();
  $suggestions[] = 'views_view__' . $view->id() . '__' . $view->current_display;
}

/**
 * Implements hook_theme_suggestions_pager_alter().
 */
function df_impact_theme_suggestions_pager_alter(array &$suggestions, array $variables): void {
  if (df_impact_route_uses_wp_query_pager()) {
    $suggestions[] = 'pager__wp_query';
  }
}

/**
 * Whether the active route should render WordPress query-pagination markup.
 */
function df_impact_route_uses_wp_query_pager(): bool {
  $route = \Drupal::routeMatch()->getRouteName();
  if (!$route || !str_starts_with($route, 'view.')) {
    return FALSE;
  }
  $parts = explode('.', $route);
  $view_id = $parts[1] ?? '';
  return in_array($view_id, [
    'topic_archive',
    'digital_exclusives_archive',
    'stories_archive',
    'past_issues',
    'in_brief_listing',
    'browse_issues',
  ], TRUE);
}

/**
 * Implements hook_preprocess_pager().
 */
function df_impact_preprocess_pager(array &$variables): void {
  $variables['use_wp_query_pager'] = df_impact_route_uses_wp_query_pager();
  if ($variables['use_wp_query_pager'] && !empty($variables['items']['next']['text'])) {
    $variables['items']['next']['text'] = t('Next Page');
  }
}

/**
 * Formats an issue node as "Spring 2026" for homepage labels.
 */
function df_impact_format_issue_label(NodeInterface $issue): ?string {
  if ($issue->bundle() !== 'issue') {
    return NULL;
  }
  $map = [
    'spring' => 'Spring',
    'summer' => 'Summer',
    'fall' => 'Fall',
    'winter' => 'Winter',
    'late fall' => 'Late Fall',
  ];
  $season_key = mb_strtolower(trim((string) ($issue->get('field_season')->value ?? '')), 'UTF-8');
  $season = $map[$season_key] ?? ($season_key !== '' ? ucwords($season_key) : '');
  $year = $issue->get('field_year')->value;
  if ($season !== '' && $year !== NULL && $year !== '') {
    return $season . ' ' . $year;
  }
  if ($season !== '') {
    return $season;
  }
  return $issue->label();
}

/**
 * Determines whether the current or provided node is the editable About page.
 */
function df_impact_is_about_impact_page(?NodeInterface $node = NULL): bool {
  if (!$node) {
    $route_node = \Drupal::routeMatch()->getParameter('node');
    $node = $route_node instanceof NodeInterface ? $route_node : NULL;
  }

  if (!$node instanceof NodeInterface || $node->bundle() !== 'page') {
    return FALSE;
  }

  try {
    if (in_array($node->toUrl()->toString(), ['/about', '/about-impact'], TRUE)) {
      return TRUE;
    }
  }
  catch (\Exception) {
    // Fall back to the stable title used by the setup update hook.
  }

  return $node->label() === 'About Impact';
}

/**
 * Builds issue browse thumbnail: cover, then banner, then a story featured image.
 */
function df_impact_build_issue_browse_thumbnail(NodeInterface $issue): array {
  $formatter = [
    'type' => 'entity_reference_entity_view',
    'label' => 'hidden',
    'settings' => [
      'view_mode' => 'default',
      'link' => FALSE,
    ],
  ];
  foreach (['field_cover_image', 'field_banner_image'] as $field_name) {
    if ($issue->hasField($field_name) && !$issue->get($field_name)->isEmpty()) {
      return $issue->get($field_name)->view($formatter);
    }
  }
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $nids = $storage->getQuery()
    ->condition('type', 'article')
    ->condition('status', 1)
    ->condition('field_issue.target_id', $issue->id())
    ->sort('sticky', 'DESC')
    ->sort('created', 'DESC')
    ->range(0, 1)
    ->accessCheck()
    ->execute();
  if (!$nids) {
    return [];
  }
  $article = $storage->load(reset($nids));
  if (!$article instanceof NodeInterface) {
    return [];
  }
  if (!$article->hasField('field_featured_image') || $article->get('field_featured_image')->isEmpty()) {
    return [];
  }
  return $article->get('field_featured_image')->view($formatter);
}

/**
 * Populates PostX card variables for homepage view rows.
 */
function df_impact_preprocess_homepage_article_card_fields(array &$variables): void {
  $node = df_impact_views_result_row_node($variables['row'] ?? NULL);
  if (!$node instanceof NodeInterface || $node->bundle() !== 'article') {
    return;
  }
  $variables['article_nid'] = $node->id();
  $variables['article_url'] = $node->toUrl()->toString();
  $meta = df_impact_article_card_image_meta($node);
  $variables['article_card_image_url'] = $meta['url'] ?? NULL;
  $variables['article_card_image_alt'] = $meta['alt'] ?? $node->label();
  $variables['article_card_image_width'] = $meta['width'] ?? 768;
  $variables['article_card_image_height'] = $meta['height'] ?? 551;
  $variables['article_card_image_srcset'] = $meta['srcset'] ?? NULL;
  $variables['article_card_image_sizes'] = $meta['sizes'] ?? '(max-width: 768px) 100vw, 768px';
  $variables['article_card_image_fallback'] = df_impact_article_lead_image_fallback_build($node);
}

/**
 * Image URL + alt for PostX-style homepage cards.
 *
 * @return array{url: string, alt: string}|null
 */
/**
 * Banner image for issue / promo page nodes.
 *
 * @return array{url: string, alt: string}|null
 */
function df_impact_issue_banner_image_url(string $uri): string {
  $resolved = df_impact_resolve_wp_images_uri($uri);
  if ($resolved !== NULL) {
    $uri = $resolved;
  }
  $file_system = \Drupal::service('file_system');
  $real = $file_system->realpath($uri);
  if ($real === FALSE || !is_file($real)) {
    $live = df_impact_wp_live_url_for_missing_file_uri($uri);
    if ($live !== NULL) {
      if (preg_match('#wp-content/uploads/(.+)$#', $live, $m)) {
        $photon = df_impact_wp_i0_derivative_url('public://wp-content/uploads/' . $m[1], '1024', '396');
        if ($photon !== NULL) {
          return $photon;
        }
      }
      return $live;
    }
  }
  $banner_photon = df_impact_wp_i0_derivative_url($uri, '1024', '396');
  if ($banner_photon !== NULL && df_impact_wp_uploads_path_from_uri($uri) !== NULL) {
    return $banner_photon;
  }
  if (preg_match('/-1024x396\.(jpe?g|png|webp)$/i', $uri)) {
    return \Drupal::service('file_url_generator')->generateAbsoluteString($uri);
  }
  $vendored = df_impact_wp_vendored_derivative_url($uri, '1024x396');
  if ($vendored) {
    return $vendored;
  }
  foreach (['wp_issue_banner_1024x396', 'issue_banner'] as $style_id) {
    $style = \Drupal::entityTypeManager()->getStorage('image_style')->load($style_id);
    if ($style) {
      return $style->buildUrl($uri);
    }
  }
  return \Drupal::service('file_url_generator')->generateAbsoluteString($uri);
}

/**
 * Issue magazine cover for /browse-issues/ (prefer cover art, local file URL).
 *
 * @return array{url: string, alt: string}|null
 */
function df_impact_issue_browse_cover_meta(NodeInterface $issue): ?array {
  foreach (['field_cover_image', 'field_banner_image'] as $field_name) {
    if (!$issue->hasField($field_name) || $issue->get($field_name)->isEmpty()) {
      continue;
    }
    $media = $issue->get($field_name)->entity;
    if ($media && $media->hasField('field_media_image') && !$media->get('field_media_image')->isEmpty()) {
      $file = $media->get('field_media_image')->entity;
      if ($file) {
        $alt = (string) $media->get('field_media_image')->alt;
        if ($alt === '') {
          $alt = $issue->label();
        }
        return [
          'url' => \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri()),
          'alt' => df_impact_decode_plain_text($alt),
        ];
      }
    }
  }
  return NULL;
}

/**
 * Live WordPress uploads URL when a vendored wp-images file is missing locally.
 */
function df_impact_wp_live_url_for_missing_file_uri(string $uri): ?string {
  $relative = str_replace('public://', '', $uri);
  $basename = basename($relative);
  if ($basename === '' || $basename === '.' || $basename === '..') {
    return NULL;
  }
  if (str_starts_with($relative, 'wp-content/uploads/')) {
    return 'https://danafarberimpact.org/' . $relative;
  }
  if (str_starts_with($relative, 'wp-images/')) {
    $uploads_tail = substr($relative, strlen('wp-images/'));
    if (preg_match('#^\d{4}/\d{2}/#', $uploads_tail)) {
      return 'https://danafarberimpact.org/wp-content/uploads/' . $uploads_tail;
    }
    foreach (['2026/08', '2026/09', '2026/06', '2025/12', '2025/09'] as $prefix) {
      return 'https://danafarberimpact.org/wp-content/uploads/' . $prefix . '/' . $basename;
    }
  }
  return NULL;
}

function df_impact_issue_banner_meta(NodeInterface $node): ?array {
  foreach (['field_banner_image', 'field_cover_image'] as $field_name) {
    if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
      continue;
    }
    $media = $node->get($field_name)->entity;
    if ($media && $media->hasField('field_media_image') && !$media->get('field_media_image')->isEmpty()) {
      $file = $media->get('field_media_image')->entity;
      if ($file) {
        $alt = (string) $media->get('field_media_image')->alt;
        if ($alt === '') {
          $alt = $node->label();
        }
        $width = 1024;
        $height = 396;
        $path = \Drupal::service('file_system')->realpath($file->getFileUri());
        if ($path && is_file($path)) {
          $info = @getimagesize($path);
          if (is_array($info) && !empty($info[0]) && !empty($info[1])) {
            $width = (int) $info[0];
            $height = (int) $info[1];
          }
        }
        return [
          'url' => df_impact_issue_banner_image_url($file->getFileUri()),
          'alt' => $alt,
          'width' => $width,
          'height' => $height,
        ];
      }
    }
  }
  return NULL;
}

/**
 * Removes the first Gutenberg lead image block when rendered separately as featured media.
 */
function df_impact_article_strip_leading_wp_image_block(string $body): string {
  $stripped = preg_replace('/\s*<!-- wp:image\b.*?<!-- \/wp:image -->\s*/s', '', $body, 1);
  return is_string($stripped) ? $stripped : $body;
}

/**
 * Adds WP has-drop-cap to the first paragraph (matches Gutenberg dropCap blocks).
 */
function df_impact_article_add_drop_cap_class(string $html): string {
  if (preg_match('/\bhas-drop-cap\b/', $html)) {
    return $html;
  }
  $updated = preg_replace(
    '/<p(\s[^>]*)?>/',
    '<p class="has-drop-cap wp-block-paragraph"$1>',
    $html,
    1,
  );
  return is_string($updated) ? $updated : $html;
}

/**
 * Lead figcaption from export body when the Drupal caption field is empty.
 */
function df_impact_article_wp_lead_figcaption_from_export(NodeInterface $node): string {
  $row = df_impact_article_export_row_for_node($node);
  if (!is_array($row)) {
    return '';
  }
  $body = (string) ($row['body'] ?? '');
  if (preg_match('/<figcaption class="wp-element-caption">(.*?)<\/figcaption>/s', $body, $match)) {
    return trim(html_entity_decode(strip_tags($match[1]), ENT_QUOTES | ENT_HTML5, 'UTF-8'));
  }
  return '';
}

/**
 * WordPress lead-image block metadata from the migrated body (align, display size).
 *
 * @return array{align: string, width: int|null, height: int|null, size_slug: string, style_width: string|null}
 */
function df_impact_article_wp_lead_block_meta(NodeInterface $node): array {
  $defaults = [
    'align' => 'right',
    'width' => 725,
    'height' => 520,
    'size_slug' => 'large',
    'style_width' => NULL,
  ];
  $row = df_impact_article_export_row_for_node($node);
  if (!is_array($row)) {
    return $defaults;
  }
  $body = (string) ($row['body'] ?? '');
  if (!preg_match('/<!-- wp:image (\{.*?\}) -->/s', $body, $match)) {
    return $defaults;
  }
  $json = json_decode($match[1], TRUE);
  if (!is_array($json)) {
    return $defaults;
  }
  $align = (string) ($json['align'] ?? $defaults['align']);
  $size_slug = (string) ($json['sizeSlug'] ?? $defaults['size_slug']);
  $width = $json['width'] ?? NULL;
  $height = $json['height'] ?? NULL;
  if (is_string($width)) {
    $width = (int) preg_replace('/[^0-9]/', '', $width);
  }
  if (is_string($height)) {
    $height = (int) preg_replace('/[^0-9]/', '', $height);
  }
  $style_width = NULL;
  if (isset($json['style']['width']) && is_string($json['style']['width'])) {
    $style_width = $json['style']['width'];
  }
  elseif ($align === 'left' && ($width === NULL || $width === 0)) {
    $style_width = '363px';
  }
  return [
    'align' => $align === 'left' ? 'left' : 'right',
    'width' => is_int($width) && $width > 0 ? $width : ($align === 'left' ? 1024 : 725),
    'height' => is_int($height) && $height > 0 ? $height : ($align === 'left' ? 734 : 520),
    'size_slug' => $size_slug !== '' ? $size_slug : 'large',
    'style_width' => $style_width,
  ];
}

/**
 * Prefer vendored WP intermediate files (e.g. *-1024x734.jpg) for pixel parity.
 */
function df_impact_path_basename_key(string $path): string {
  $base = pathinfo($path, PATHINFO_FILENAME);
  return strtolower(preg_replace('/[^a-z0-9]+/i', '', $base));
}

function df_impact_wp_vendored_derivative_url(string $uri, string $suffix): ?string {
  $path = \Drupal::service('file_system')->realpath($uri);
  if (!$path) {
    return NULL;
  }
  $dir = is_dir($path) ? $path : dirname($path);
  $source_key = df_impact_path_basename_key($path);
  foreach (glob($dir . '/*-' . $suffix . '.jpg') ?: [] as $candidate) {
    if (!is_file($candidate)) {
      continue;
    }
    $candidate_base = pathinfo($candidate, PATHINFO_FILENAME);
    $candidate_base = preg_replace('/-' . preg_quote($suffix, '/') . '$/i', '', $candidate_base);
    $candidate_key = df_impact_path_basename_key($candidate_base ?? $candidate);
    if ($candidate_key === $source_key) {
      $relative = str_replace(\Drupal::root() . '/sites/default/files/', '', $candidate);
      return \Drupal::service('file_url_generator')->generateAbsoluteString('public://' . $relative);
    }
  }
  return NULL;
}

/**
 * Styled URL for article lead images (1024×734 WP large derivative).
 */
function df_impact_article_lead_image_url(string $uri): string {
  $photon = df_impact_wp_i0_derivative_url($uri, '1024', '734');
  if ($photon) {
    return $photon;
  }
  $vendored = df_impact_wp_vendored_derivative_url($uri, '1024x734');
  if ($vendored) {
    return $vendored;
  }
  foreach (['wp_article_lead_1024x734', 'article_featured'] as $style_id) {
    $style = \Drupal::entityTypeManager()->getStorage('image_style')->load($style_id);
    if ($style) {
      return $style->buildUrl($uri);
    }
  }
  return \Drupal::service('file_url_generator')->generateAbsoluteString($uri);
}

/**
 * Build WP-like lead figure (align, dimensions, figcaption) for article full view.
 */
function df_impact_article_lead_figure_build(NodeInterface $node): ?array {
  if ($node->bundle() !== 'article') {
    return NULL;
  }
  $layout = df_impact_article_wp_lead_block_meta($node);
  $align_class = $layout['align'] === 'left' ? 'alignleft' : 'alignright';
  $size_class = $layout['size_slug'] === 'full' ? 'size-full' : 'size-large';
  $caption = '';
  if ($node->hasField('field_photo_caption') && !$node->get('field_photo_caption')->isEmpty()) {
    $caption = trim((string) $node->get('field_photo_caption')->value);
  }
  if ($caption === '') {
    $caption = df_impact_article_wp_lead_figcaption_from_export($node);
  }

  $src = NULL;
  $alt = $node->label();
  if ($node->hasField('field_featured_image') && !$node->get('field_featured_image')->isEmpty()) {
    $media = $node->get('field_featured_image')->entity;
    if ($media && $media->hasField('field_media_image') && !$media->get('field_media_image')->isEmpty()) {
      $file = $media->get('field_media_image')->entity;
      if ($file) {
        $src = df_impact_article_lead_image_url($file->getFileUri());
        $alt_field = $media->get('field_media_image')->first();
        if ($alt_field && $alt_field->alt) {
          $alt = $alt_field->alt;
        }
      }
    }
  }
  if ($src === NULL) {
    $fallback = df_impact_article_lead_image_fallback_build($node);
    if ($fallback === NULL) {
      return NULL;
    }
    $fallback['#attributes']['width'] = (string) $layout['width'];
    $fallback['#attributes']['height'] = (string) $layout['height'];
    if ($layout['style_width']) {
      $fallback['#attributes']['style'] = 'width:' . $layout['style_width'];
    }
    return [
      '#type' => 'inline_template',
      '#template' => '<figure class="wp-block-image {{ align_class }} {{ size_class }} is-resized">{{ img|render }}{% if caption %}<figcaption class="wp-element-caption">{{ caption }}</figcaption>{% endif %}</figure>',
      '#context' => [
        'align_class' => $align_class,
        'size_class' => $size_class,
        'img' => $fallback,
        'caption' => $caption,
      ],
    ];
  }

  return [
    '#type' => 'inline_template',
    '#template' => '<figure class="wp-block-image {{ align_class }} {{ size_class }} is-resized"><img decoding="async" loading="lazy" class="wp-image-lead" src="{{ src }}" alt="{{ alt }}" width="{{ width }}" height="{{ height }}"{% if style_width %} style="width:{{ style_width }}"{% endif %}>{% if caption %}<figcaption class="wp-element-caption">{{ caption }}</figcaption>{% endif %}</figure>',
    '#context' => [
      'align_class' => $align_class,
      'size_class' => $size_class,
      'src' => $src,
      'alt' => $alt,
      'width' => $layout['width'],
      'height' => $layout['height'],
      'style_width' => $layout['style_width'],
      'caption' => $caption,
    ],
  ];
}

/**
 * Card image URL aligned with WP PostX grid sizing (870×570 crop when possible).
 */
/**
 * PostX card URL with article export fallback when wp-images lacks uploads mapping.
 */
function df_impact_card_image_url_for_parity_node(NodeInterface $node, string $uri): string {
  $photon = df_impact_wp_i0_postx_card_url($uri);
  if ($photon !== NULL && df_impact_wp_uploads_path_from_uri($uri) !== NULL) {
    return $photon;
  }
  $row = df_impact_article_export_row_for_node($node);
  if (is_array($row)) {
    foreach (df_impact_article_export_try_image_urls($row) as $candidate) {
      $candidate = trim(html_entity_decode((string) $candidate, ENT_QUOTES | ENT_HTML5, 'UTF-8'));
      if ($candidate !== '' && str_contains($candidate, 'wp-content/uploads')) {
        return df_impact_card_image_url_for_parity_from_src($candidate);
      }
    }
  }
  return df_impact_card_image_url_for_parity($uri);
}

function df_impact_card_image_url_for_parity(string $uri): string {
  $file_system = \Drupal::service('file_system');
  if (!$file_system->realpath($uri)) {
    $uri = df_impact_resolve_wp_images_uri($uri) ?? $uri;
  }
  if ($file_system->realpath($uri)) {
    return \Drupal::service('file_url_generator')->generateAbsoluteString($uri);
  }
  $photon = df_impact_wp_i0_postx_card_url($uri);
  if ($photon) {
    return $photon;
  }
  if (preg_match('/-870x570\.(jpe?g|png|webp)$/i', $uri)) {
    return \Drupal::service('file_url_generator')->generateAbsoluteString($uri);
  }
  $vendored = df_impact_wp_vendored_derivative_url($uri, '870x570');
  if ($vendored) {
    return $vendored;
  }
  foreach (['wp_card_870x570', 'card_large'] as $style_id) {
    $style = \Drupal::entityTypeManager()->getStorage('image_style')->load($style_id);
    if ($style) {
      return $style->buildUrl($uri);
    }
  }
  return \Drupal::service('file_url_generator')->generateAbsoluteString($uri);
}

/**
 * Resolves public://wp-images/* URIs when files omit extensions or use WP stems.
 */
function df_impact_resolve_wp_images_uri(string $uri): ?string {
  $relative = str_replace('public://', '', $uri);
  if (!str_starts_with($relative, 'wp-images/')) {
    if (str_starts_with($relative, 'wp-content/uploads/')) {
      $basename = basename($relative);
      $uri = 'public://wp-images/' . $basename;
      $relative = 'wp-images/' . $basename;
    }
    else {
      return NULL;
    }
  }
  $stem = pathinfo($relative, PATHINFO_FILENAME);
  $dir = DRUPAL_ROOT . '/sites/default/files/wp-images';
  if (!is_dir($dir) || $stem === '') {
    return NULL;
  }
  $exact = $dir . '/' . basename($relative);
  if (is_file($exact)) {
    return 'public://wp-images/' . basename($relative);
  }
  $glob = glob($dir . '/' . $stem . '*');
  if (!is_array($glob)) {
    return NULL;
  }
  foreach ($glob as $path) {
    if (is_file($path) && preg_match('/\.(jpe?g|png|gif|webp)$/i', $path)) {
      return 'public://wp-images/' . basename($path);
    }
  }
  return NULL;
}

function df_impact_card_image_url_for_parity_from_src(string $src): string {
  if (preg_match('#i\d*\.wp\.com/#i', $src)) {
    return $src;
  }
  if (preg_match('#/wp-content/uploads/(.+)$#', $src, $m)) {
    $uri = 'public://wp-content/uploads/' . $m[1];
    if (\Drupal::service('file_system')->realpath($uri)) {
      return df_impact_card_image_url_for_parity($uri);
    }
  }
  return $src;
}

/**
 * Resolves a Drupal file URI to a wp-content/uploads/... path when possible.
 */
function df_impact_wp_uploads_path_from_uri(string $uri): ?string {
  $relative = str_replace('public://', '', $uri);
  if (str_starts_with($relative, 'wp-content/uploads/')) {
    return $relative;
  }
  if (!str_starts_with($relative, 'wp-images/')) {
    return NULL;
  }
  $basename = basename($relative);
  $stem = strtolower(pathinfo($basename, PATHINFO_FILENAME));
  $index = df_impact_media_source_url_index();
  $candidates = array_values(array_unique(array_filter([
    $stem,
    preg_replace('/_1450$/', '', $stem),
    preg_replace('/-\d+x\d+$/', '', $stem),
  ])));
  $source = NULL;
  foreach ($candidates as $key) {
    if ($key !== '' && isset($index[$key])) {
      $source = $index[$key];
      break;
    }
  }
  if (!is_string($source)) {
    $needle = strtolower($basename);
    foreach ($index as $candidate) {
      if (is_string($candidate) && str_contains(strtolower($candidate), $needle)) {
        $source = $candidate;
        break;
      }
    }
  }
  if (!is_string($source)) {
    foreach ($index as $key => $candidate) {
      if (!is_string($candidate)) {
        continue;
      }
      if (str_contains($stem, $key) || str_contains($key, $stem)) {
        $source = $candidate;
        break;
      }
    }
  }
  if (is_string($source) && preg_match('#wp-content/uploads/(.+)$#', $source, $m)) {
    return 'wp-content/uploads/' . $m[1];
  }
  return NULL;
}

/**
 * WordPress Photon derivative URL (resize=w,h), matching live WP srcset.
 */
function df_impact_wp_i0_derivative_url(string $uri, string $width, string $height): ?string {
  $uploads_path = df_impact_wp_uploads_path_from_uri($uri);
  if ($uploads_path === NULL) {
    return NULL;
  }
  return 'https://i0.wp.com/danafarberimpact.org/' . $uploads_path . '?resize=' . rawurlencode($width) . '%2C' . rawurlencode($height) . '&ssl=1';
}

/**
 * WordPress Photon URL for PostX card grids, matching live WP fit=768×551.
 */
function df_impact_wp_i0_postx_card_url(string $uri): ?string {
  $uploads_path = df_impact_wp_uploads_path_from_uri($uri);
  if ($uploads_path === NULL) {
    return NULL;
  }
  return 'https://i0.wp.com/danafarberimpact.org/' . $uploads_path . '?fit=768%2C551&ssl=1';
}

/**
 * Jetpack related-posts thumbnail (350×200 resize, matches live WP).
 */
function df_impact_jetpack_related_image_url(string $uri): string {
  $photon = df_impact_wp_i0_derivative_url($uri, '350', '200');
  if ($photon) {
    return $photon;
  }
  if (str_contains($uri, 'wp-images/')) {
    $index = df_impact_media_source_url_index();
    $basename = basename($uri);
    $stems = [
      strtolower(pathinfo($basename, PATHINFO_FILENAME)),
      strtolower(preg_replace('/-\d+x\d+$/', '', pathinfo($basename, PATHINFO_FILENAME))),
    ];
    foreach ($stems as $stem) {
      $source = $index[$stem] ?? NULL;
      if (!is_string($source)) {
        continue;
      }
      if (preg_match('#wp-content/uploads/(.+)$#', $source, $m)) {
        return 'https://i0.wp.com/danafarberimpact.org/wp-content/uploads/' . $m[1] . '?resize=350%2C200&ssl=1';
      }
    }
  }
  $from_src = df_impact_card_image_url_for_parity($uri);
  if (str_contains($from_src, 'i0.wp.com')) {
    return df_impact_wp_i0_derivative_url_from_photon_src($from_src, '350', '200') ?? $from_src;
  }
  return $from_src;
}

/**
 * @return list<array{url: string, label: string}>
 */
function df_impact_article_post_term_links(NodeInterface $node): array {
  $links = [];
  foreach (['field_topics', 'field_cancer_types'] as $field_name) {
    if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
      continue;
    }
    foreach ($node->get($field_name) as $item) {
      $term = $item->entity;
      if (!$term) {
        continue;
      }
      $slug = function_exists('df_setup_topic_category_slug')
        ? df_setup_topic_category_slug($term->label())
        : strtolower(preg_replace('/[^a-z0-9]+/i', '-', $term->label()));
      $links[] = [
        'url' => Url::fromUri('internal:/category/' . $slug)->toString(),
        'label' => $term->label(),
      ];
    }
  }
  return $links;
}

/**
 * Related story nodes for article footer (manual refs or topic-based view).
 *
 * @return \Drupal\node\NodeInterface[]
 */
function df_impact_article_more_story_nodes(NodeInterface $article): array {
  if ($article->bundle() !== 'article') {
    return [];
  }
  $nodes = [];
  if ($article->hasField('field_related_articles') && !$article->get('field_related_articles')->isEmpty()) {
    foreach ($article->get('field_related_articles') as $item) {
      $ref = $item->entity;
      if ($ref instanceof NodeInterface && $ref->isPublished() && (int) $ref->id() !== (int) $article->id()) {
        $nodes[] = $ref;
      }
    }
  }
  return array_slice($nodes, 0, 3);
}

/**
 * @return list<array{url: string, title: string, image_url: string|null, image_alt: string}>
 */
function df_impact_jetpack_related_image_for_article(NodeInterface $related): ?string {
  $row = df_impact_article_export_row_for_node($related);
  if (is_array($row)) {
    foreach (df_impact_article_export_try_image_urls($row) as $candidate) {
      if (preg_match('#danafarberimpact\.org/wp-content/uploads/(.+\.(?:jpe?g|png|webp|gif))#i', $candidate, $m)) {
        return 'https://i0.wp.com/danafarberimpact.org/wp-content/uploads/' . $m[1] . '?resize=350%2C200&ssl=1';
      }
    }
  }
  $uri = df_impact_node_featured_image_uri($related);
  if ($uri !== NULL) {
    $url = df_impact_jetpack_related_image_url($uri);
    if (str_contains($url, 'i0.wp.com')) {
      return $url;
    }
  }
  $meta = df_impact_article_card_image_meta($related);
  if ($meta && !empty($meta['url']) && str_contains($meta['url'], 'i0.wp.com')) {
    return df_impact_wp_i0_derivative_url_from_photon_src($meta['url'], '350', '200') ?? $meta['url'];
  }
  return NULL;
}

function df_impact_article_more_story_cards(NodeInterface $article): array {
  $cards = [];
  foreach (df_impact_article_more_story_nodes($article) as $related) {
    if ($related->bundle() === 'in_brief') {
      $meta = df_impact_in_brief_card_image_meta($related);
      $image_url = $meta['url'] ?? NULL;
      if ($image_url && !str_contains($image_url, 'i0.wp.com')) {
        $image_url = df_impact_wp_i0_derivative_url_from_photon_src($image_url, '350', '200') ?? $image_url;
      }
      $cards[] = [
        'url' => df_impact_in_brief_item_url($related),
        'title' => $related->label(),
        'image_url' => $image_url,
        'image_alt' => $meta['alt'] ?? $related->label(),
      ];
      continue;
    }
    $meta = df_impact_article_card_image_meta($related);
    $cards[] = [
      'url' => $related->toUrl()->toString(),
      'title' => $related->label(),
      'image_url' => df_impact_jetpack_related_image_for_article($related),
      'image_alt' => $meta['alt'] ?? $related->label(),
    ];
  }
  return $cards;
}

/**
 * File URI for an article's featured image, when stored locally.
 */
function df_impact_node_featured_image_uri(NodeInterface $node): ?string {
  if (!$node->hasField('field_featured_image') || $node->get('field_featured_image')->isEmpty()) {
    return NULL;
  }
  $media = $node->get('field_featured_image')->entity;
  if ($media && $media->hasField('field_media_image') && !$media->get('field_media_image')->isEmpty()) {
    $file = $media->get('field_media_image')->entity;
    if ($file) {
      return $file->getFileUri();
    }
  }
  return NULL;
}

function df_impact_wp_i0_derivative_url_from_photon_src(string $src, string $width, string $height): ?string {
  if (preg_match('#i\d*\.wp\.com/danafarberimpact\.org/(.+?)(?:\?|$)#', $src, $m)) {
    return 'https://i0.wp.com/danafarberimpact.org/' . $m[1] . '?resize=' . rawurlencode($width) . '%2C' . rawurlencode($height) . '&ssl=1';
  }
  return NULL;
}

/**
 * Archive row thumbnail URL — WP uses full post-thumbnail (_1450), not PostX fit.
 */
function df_impact_archive_thumbnail_url_for_parity(string $uri): string {
  $uploads_path = df_impact_wp_uploads_path_from_uri($uri);
  if ($uploads_path !== NULL) {
    return 'https://danafarberimpact.org/' . $uploads_path;
  }
  return \Drupal::service('file_url_generator')->generateAbsoluteString($uri);
}

function df_impact_archive_thumbnail_url_from_src(string $src): string {
  if (preg_match('#danafarberimpact\.org/wp-content/uploads/#', $src)) {
    return $src;
  }
  if (preg_match('#/wp-content/uploads/(.+)$#', $src, $m)) {
    $uri = 'public://wp-content/uploads/' . $m[1];
    if (\Drupal::service('file_system')->realpath($uri)) {
      return df_impact_archive_thumbnail_url_for_parity($uri);
    }
    return 'https://danafarberimpact.org/wp-content/uploads/' . $m[1];
  }
  return $src;
}

/**
 * Featured image metadata for category / archive list rows (1450×1040 markup).
 */
function df_impact_archive_row_image_meta(NodeInterface $node): ?array {
  if ($node->bundle() !== 'article') {
    return NULL;
  }
  if ($node->hasField('field_featured_image') && !$node->get('field_featured_image')->isEmpty()) {
    $media = $node->get('field_featured_image')->entity;
    if ($media && $media->hasField('field_media_image') && !$media->get('field_media_image')->isEmpty()) {
      $file = $media->get('field_media_image')->entity;
      if ($file) {
        $alt = (string) $media->get('field_media_image')->alt;
        if ($alt === '') {
          $alt = $node->label();
        }
        return [
          'url' => df_impact_archive_thumbnail_url_for_parity($file->getFileUri()),
          'alt' => $alt,
          'width' => 1450,
          'height' => 1040,
        ];
      }
    }
  }
  $row = df_impact_article_export_row_for_node($node);
  if (!is_array($row)) {
    return NULL;
  }
  foreach (df_impact_article_export_try_image_urls($row) as $candidate) {
    $src = df_impact_article_fallback_image_src($candidate);
    if ($src === NULL || $src === '') {
      continue;
    }
    return [
      'url' => df_impact_archive_thumbnail_url_from_src($src),
      'alt' => df_impact_article_export_lead_alt($row, $node) ?: $node->label(),
      'width' => 1450,
      'height' => 1040,
    ];
  }
  return NULL;
}

/**
 * @return array<string, string>
 *   Lowercase filename stem => production source_url from migrate media.json.
 */
function df_impact_media_source_url_index(): array {
  static $index = NULL;
  if ($index !== NULL) {
    return $index;
  }
  $index = [];
  $path = DRUPAL_ROOT . '/modules/custom/df_migrate/data/media.json';
  if (!is_readable($path)) {
    return $index;
  }
  $items = json_decode(file_get_contents($path), TRUE);
  if (!is_array($items)) {
    return $index;
  }
  foreach ($items as $item) {
    if (empty($item['source_url']) || !is_string($item['source_url'])) {
      continue;
    }
    $filename = $item['filename'] ?? basename(parse_url($item['source_url'], PHP_URL_PATH) ?: '');
    if ($filename === '') {
      continue;
    }
    $stem = strtolower(pathinfo($filename, PATHINFO_FILENAME));
    $index[$stem] = $item['source_url'];
  }
  return $index;
}

function df_impact_article_card_image_meta(NodeInterface $node): ?array {
  if ($node->bundle() !== 'article') {
    return NULL;
  }
  if ($node->hasField('field_featured_image') && !$node->get('field_featured_image')->isEmpty()) {
    $media = $node->get('field_featured_image')->entity;
    if ($media && $media->hasField('field_media_image') && !$media->get('field_media_image')->isEmpty()) {
      $file = $media->get('field_media_image')->entity;
      if ($file) {
        $alt = (string) $media->get('field_media_image')->alt;
        if ($alt === '') {
          $alt = $node->label();
        }
        $uri = $file->getFileUri();
        return [
          'url' => df_impact_card_image_url_for_parity_node($node, $uri),
          'alt' => $alt,
          'width' => 1024,
          'height' => 734,
          'srcset' => df_impact_postx_card_srcset($uri),
          'sizes' => '(max-width: 768px) 100vw, 768px',
        ];
      }
    }
  }
  $row = df_impact_article_export_row_for_node($node);
  if (!is_array($row)) {
    return NULL;
  }
  foreach (df_impact_article_export_try_image_urls($row) as $candidate) {
    $src = df_impact_article_fallback_image_src($candidate);
    if ($src === NULL || $src === '' || !df_impact_is_usable_article_image_src($src)) {
      continue;
    }
    return [
      'url' => df_impact_card_image_url_for_parity_from_src($src),
      'alt' => df_impact_article_export_lead_alt($row, $node) ?: $node->label(),
      'width' => 1024,
      'height' => 734,
      'srcset' => df_impact_postx_card_srcset_from_src($src),
      'sizes' => '(max-width: 768px) 100vw, 768px',
    ];
  }
  return NULL;
}

/**
 * Responsive srcset for PostX cards (Photon 350w + 768w, matching WP).
 */
function df_impact_postx_card_srcset(string $file_uri): ?string {
  $parts = [];
  $small = df_impact_wp_i0_derivative_url($file_uri, '350', '200');
  $large = df_impact_wp_i0_postx_card_url($file_uri);
  if ($small) {
    $parts[] = $small . ' 350w';
  }
  if ($large) {
    $parts[] = $large . ' 768w';
  }
  return $parts === [] ? NULL : implode(', ', $parts);
}

/**
 * Build srcset from a parity image URL or uploads URI.
 */
function df_impact_postx_card_srcset_from_src(string $src): ?string {
  $uri = $src;
  if (str_starts_with($src, 'http')) {
    $path = parse_url($src, PHP_URL_PATH) ?? '';
    if ($path !== '') {
      $uri = $path;
    }
  }
  $parts = [];
  $small = df_impact_wp_i0_derivative_url($uri, '350', '200');
  $large = df_impact_wp_i0_postx_card_url($uri);
  if ($small) {
    $parts[] = $small . ' 350w';
  }
  if ($large) {
    $parts[] = $large . ' 768w';
  }
  return $parts === [] ? NULL : implode(', ', $parts);
}

/**
 * Builds homepage hero video variables from the featured issue node.
 *
 * @return array{video_url: string, poster_url: string|null, title: \Drupal\Core\StringTranslation\TranslatableMarkup}|null
 */
function df_impact_build_homepage_hero(?NodeInterface $issue): ?array {
  if (!$issue instanceof NodeInterface || $issue->bundle() !== 'issue') {
    return NULL;
  }
  $video_url = df_impact_media_file_url($issue, 'field_hero_video', 'field_media_video_file');
  if ($video_url === NULL) {
    // Local migrations often omit large hero files; match production WP hero for behavior parity.
    $video_url = 'https://danafarberimpact.org/wp-content/uploads/2026/09/Impact_Ambient.mp4';
  }
  // WordPress homepage cover uses video only (no poster img in reference pack).
  $poster_url = NULL;
  $heading = t('Stories From Our Community of Support');
  if ($issue->hasField('field_hero_heading') && !$issue->get('field_hero_heading')->isEmpty()) {
    $heading = $issue->get('field_hero_heading')->value;
  }
  return [
    'video_url' => $video_url,
    'poster_url' => $poster_url,
    'title' => $heading,
  ];
}

/**
 * Public file URL for an image/video field on a node (media reference).
 */
function df_impact_media_file_url(NodeInterface $node, string $field_name, string $media_file_field): ?string {
  if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
    return NULL;
  }
  $media = $node->get($field_name)->entity;
  if (!$media || !$media->hasField($media_file_field) || $media->get($media_file_field)->isEmpty()) {
    return NULL;
  }
  $file = $media->get($media_file_field)->entity;
  if (!$file) {
    return NULL;
  }
  return \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri());
}

/**
 * Returns the newest published issue node ID (year desc, season desc).
 */
function df_impact_get_latest_issue_nid(): ?int {
  if (function_exists('df_setup_get_latest_issue_nid')) {
    return df_setup_get_latest_issue_nid();
  }
  return NULL;
}

/**
 * Maps article node IDs to WordPress export rows (articles.json) for image fallbacks.
 *
 * @return array<int, array<string, mixed>>
 */
function df_impact_articles_export_rows_by_nid(): array {
  static $by_nid = NULL;
  if ($by_nid !== NULL) {
    return $by_nid;
  }
  $by_nid = [];
  $path = \Drupal::root() . '/modules/custom/df_migrate/data/articles.json';
  if (!is_readable($path)) {
    return $by_nid;
  }
  $rows = json_decode((string) file_get_contents($path), TRUE);
  if (!is_array($rows)) {
    return $by_nid;
  }
  $database = \Drupal::database();
  $wp_to_nid = [];
  if ($database->schema()->tableExists('migrate_map_df_articles')) {
    $wp_to_nid = $database->select('migrate_map_df_articles', 'm')
      ->fields('m', ['sourceid1', 'destid1'])
      ->execute()
      ->fetchAllKeyed();
    $wp_to_nid = array_map('intval', $wp_to_nid);
  }
  foreach ($rows as $row) {
    if (!is_array($row)) {
      continue;
    }
    $resolved = df_impact_article_export_resolve_nid($row, $wp_to_nid);
    if ($resolved !== NULL) {
      $by_nid[$resolved] = $row;
    }
  }
  return $by_nid;
}

/**
 * Maps drupal_alias (normalized with leading slash) to export rows.
 *
 * @return array<string, array<string, mixed>>
 */
function df_impact_articles_export_rows_by_drupal_alias(): array {
  static $by_alias = NULL;
  if ($by_alias !== NULL) {
    return $by_alias;
  }
  $by_alias = [];
  $path = \Drupal::root() . '/modules/custom/df_migrate/data/articles.json';
  if (!is_readable($path)) {
    return $by_alias;
  }
  $rows = json_decode((string) file_get_contents($path), TRUE);
  if (!is_array($rows)) {
    return $by_alias;
  }
  foreach ($rows as $row) {
    if (!is_array($row)) {
      continue;
    }
    $alias = $row['drupal_alias'] ?? '';
    if (!is_string($alias) || $alias === '') {
      continue;
    }
    $norm = '/' . trim($alias, '/');
    $by_alias[$norm] = $row;
  }
  return $by_alias;
}

/**
 * Finds the WordPress export row for an article (nid + migrate map, then path alias).
 *
 * @return array<string, mixed>|null
 */
function df_impact_article_export_row_for_node(NodeInterface $node): ?array {
  if ($node->bundle() !== 'article') {
    return NULL;
  }
  $by_nid = df_impact_articles_export_rows_by_nid();
  $nid = (int) $node->id();
  if (isset($by_nid[$nid])) {
    return $by_nid[$nid];
  }
  $internal = '/node/' . $nid;
  $langcode = $node->language()->getId();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($internal, $langcode);
  if (!is_string($alias) || $alias === '') {
    return NULL;
  }
  $alias = '/' . trim($alias, '/');
  if ($alias === $internal || strncmp($alias, '/node/', 6) === 0) {
    return NULL;
  }
  $by_alias = df_impact_articles_export_rows_by_drupal_alias();
  return $by_alias[$alias] ?? NULL;
}

/**
 * @param array<string, mixed> $row
 * @param array<int|string, int> $wp_to_nid
 */
function df_impact_article_export_resolve_nid(array $row, array $wp_to_nid): ?int {
  $wp_id = (int) ($row['wp_id'] ?? 0);
  if ($wp_id && isset($wp_to_nid[$wp_id])) {
    return (int) $wp_to_nid[$wp_id];
  }
  $alias = $row['drupal_alias'] ?? '';
  if (!is_string($alias) || $alias === '') {
    return NULL;
  }
  $alias = '/' . ltrim($alias, '/');
  $path_alias = \Drupal::service('path_alias.manager');
  foreach ([NULL, 'en'] as $langcode) {
    $internal = $langcode === NULL
      ? $path_alias->getPathByAlias($alias)
      : $path_alias->getPathByAlias($alias, $langcode);
    if (preg_match('#^/node/(\d+)$#', $internal, $m)) {
      return (int) $m[1];
    }
  }
  return NULL;
}

/**
 * @param array<string, mixed> $row
 *
 * @return list<string>
 */
function df_impact_article_export_try_image_urls(array $row): array {
  $out = [];
  $seen = [];
  $push = function (string $url) use (&$out, &$seen): void {
    $url = trim(html_entity_decode($url, ENT_QUOTES | ENT_HTML5, 'UTF-8'));
    if ($url === '') {
      return;
    }
    $key = strtolower($url);
    if (isset($seen[$key])) {
      return;
    }
    $seen[$key] = TRUE;
    $out[] = $url;
  };

  $primary = (string) ($row['featured_image_url'] ?? '');
  if ($primary !== '' && str_contains($primary, 'wp-content/uploads')) {
    $push($primary);
  }
  $body = isset($row['body']) && is_string($row['body']) ? $row['body'] : '';
  if ($body !== '' && preg_match(
    '#https?://(?:i\d*\.wp\.com/)?danafarberimpact\.org/wp-content/uploads/[^\s"\'<>]+#i',
    $body,
    $m
  )) {
    $push($m[0]);
  }
  return $out;
}

/**
 * Resolves a WordPress uploads URL to a displayable image src (local public file preferred).
 */
function df_impact_is_usable_article_image_src(string $src): bool {
  return (bool) preg_match(
    '#(?:wp-content/uploads/|/sites/default/files/wp-images/|i\d*\.wp\.com/).+\.(?:jpe?g|png|gif|webp)(?:\?|$)#i',
    $src,
  );
}

function df_impact_article_fallback_image_src(string $url): ?string {
  $url = trim(html_entity_decode($url, ENT_QUOTES | ENT_HTML5, 'UTF-8'));
  $clean = preg_replace('/\?.*$/', '', $url);
  $file_system = \Drupal::service('file_system');
  $gen = \Drupal::service('file_url_generator');
  if (preg_match('#danafarberimpact\.org/wp-content/uploads/(.+\.(?:jpe?g|png|gif|webp))#i', $clean, $m)) {
    $relative_upload = $m[1];
    $basename = basename($relative_upload);
    foreach (['public://wp-images/' . $basename, 'public://' . $relative_upload] as $uri) {
      $path = $file_system->realpath($uri);
      if ($path && is_file($path)) {
        return $gen->generateAbsoluteString($uri);
      }
    }
  }
  $hostless = preg_replace('#^https?://[^/]+/#', '', $clean) ?? $clean;
  if (preg_match('~^([^/?#]+)/?$~', $hostless, $slug_match)) {
    $stem = strtolower(pathinfo($slug_match[1], PATHINFO_FILENAME));
    $index = df_impact_media_source_url_index();
    if (!empty($index[$stem]) && is_string($index[$stem])) {
      $resolved = df_impact_article_fallback_image_src($index[$stem]);
      if ($resolved !== NULL && $resolved !== '') {
        return $resolved;
      }
    }
    foreach ($index as $key => $source) {
      if (!is_string($source)) {
        continue;
      }
      if ($key === $stem || str_starts_with($key, $stem) || str_starts_with($stem, $key)) {
        $resolved = df_impact_article_fallback_image_src($source);
        if ($resolved !== NULL && $resolved !== '') {
          return $resolved;
        }
      }
    }
    $wp_images_dir = DRUPAL_ROOT . '/sites/default/files/wp-images';
    if (is_dir($wp_images_dir)) {
      $glob = glob($wp_images_dir . '/' . $stem . '*');
      if (is_array($glob)) {
        foreach ($glob as $file_path) {
          if (!is_file($file_path)) {
            continue;
          }
          if (!preg_match('/\.(jpe?g|png|gif|webp)$/i', $file_path)) {
            continue;
          }
          return $gen->generateAbsoluteString('public://wp-images/' . basename($file_path));
        }
      }
    }
  }
  if (preg_match('#^https?://#i', $clean) && df_impact_is_usable_article_image_src($clean)) {
    return $clean;
  }
  if (preg_match('/\.(jpe?g|png|gif|webp)(\?|$)/i', $clean)) {
    return $clean;
  }
  return NULL;
}

/**
 * @param array<string, mixed> $row
 */
function df_impact_article_export_lead_alt(array $row, NodeInterface $node): string {
  $body = isset($row['body']) && is_string($row['body']) ? $row['body'] : '';
  if ($body !== '' && preg_match('#<img[^>]+alt=["\']([^"\']+)#i', $body, $m)) {
    return trim(html_entity_decode($m[1], ENT_QUOTES | ENT_HTML5, 'UTF-8'));
  }
  return '';
}

/**
 * Build a render array for the article lead / card when field_featured_image is empty.
 */
function df_impact_article_lead_image_fallback_build(NodeInterface $node): ?array {
  if ($node->bundle() !== 'article') {
    return NULL;
  }
  if (!$node->hasField('field_featured_image') || !$node->get('field_featured_image')->isEmpty()) {
    return NULL;
  }
  $row = df_impact_article_export_row_for_node($node);
  if (!is_array($row)) {
    return NULL;
  }
  foreach (df_impact_article_export_try_image_urls($row) as $candidate) {
    $src = df_impact_article_fallback_image_src($candidate);
    if ($src === NULL || $src === '') {
      continue;
    }
    $alt = df_impact_article_export_lead_alt($row, $node);
    if ($alt === '') {
      $alt = mb_substr($node->label(), 0, 512);
    }
    return [
      '#type' => 'html_tag',
      '#tag' => 'img',
      '#attributes' => [
        'src' => $src,
        'alt' => $alt,
        'loading' => 'lazy',
        'decoding' => 'async',
        'class' => ['article__lead-fallback-img'],
      ],
      '#cache' => [
        'tags' => $node->getCacheTags(),
        'contexts' => ['languages:language_interface'],
      ],
    ];
  }
  return NULL;
}

/**
 * Implements hook_preprocess_page_title().
 *
 * Fixes Views page title callback returning literal %1 for topic archives.
 */
function df_impact_preprocess_page_title(array &$variables): void {
  $topic_title = df_impact_topic_archive_term_label();
  if ($topic_title !== NULL) {
    $variables['title'] = $topic_title;
  }
}

/**
 * Returns the topic term label for the current category archive route, if any.
 */
function df_impact_topic_archive_term_label(): ?string {
  if (\Drupal::routeMatch()->getRouteName() !== 'view.topic_archive.page_1') {
    return NULL;
  }
  $slug_raw = \Drupal::routeMatch()->getParameter('arg_0');
  $slug = is_scalar($slug_raw) ? mb_strtolower(trim((string) $slug_raw), 'UTF-8') : '';
  if ($slug === '' || !function_exists('df_setup_topic_term_load_by_category_slug')) {
    return NULL;
  }
  $term = df_setup_topic_term_load_by_category_slug($slug);
  if ($term && $term->isPublished()) {
    return $term->getName();
  }
  return NULL;
}

/**
 * Builds header dropdown links for the newest published issues.
 *
 * @return array<int, array{title: string, url: string}>
 */
/**
 * Canonical URL for an In Brief node (external link field when set).
 */
function df_impact_in_brief_item_url(NodeInterface $node): string {
  if ($node->hasField('field_link') && !$node->get('field_link')->isEmpty()) {
    $link = $node->get('field_link')->first();
    if ($link && $link->getUrl() instanceof Url) {
      return $link->getUrl()->toString();
    }
  }
  return $node->toUrl()->toString();
}

/**
 * @return array{url: string, alt: string}|null
 */
function df_impact_in_brief_card_image_meta(NodeInterface $node): ?array {
  if ($node->bundle() !== 'in_brief') {
    return NULL;
  }
  if ($node->hasField('field_image') && !$node->get('field_image')->isEmpty()) {
    $media = $node->get('field_image')->entity;
    if ($media && $media->hasField('field_media_image') && !$media->get('field_media_image')->isEmpty()) {
      $file = $media->get('field_media_image')->entity;
      if ($file) {
        $alt = (string) $media->get('field_media_image')->alt;
        if ($alt === '') {
          $alt = $node->label();
        }
        return [
          'url' => df_impact_card_image_url_for_parity($file->getFileUri()),
          'alt' => $alt,
        ];
      }
    }
  }
  return NULL;
}

/**
 * Plain-text excerpt for In Brief cards (matches WP ultp-block-excerpt).
 */
function df_impact_in_brief_plain_excerpt(NodeInterface $node): string {
  $row = df_impact_in_brief_manifest_row($node);
  if (!empty($row['excerpt'])) {
    return df_impact_decode_plain_text(trim(strip_tags((string) $row['excerpt'])));
  }
  if (!$node->hasField('field_summary') || $node->get('field_summary')->isEmpty()) {
    return '';
  }
  $value = $node->get('field_summary')->value ?? '';
  return trim(strip_tags($value));
}

/**
 * WordPress byline string for In Brief full pages (from migrate manifest).
 */
function df_impact_in_brief_byline(NodeInterface $node): string {
  $row = df_impact_in_brief_manifest_row($node);
  return $row['byline'] ?? '';
}

/**
 * WP listing/full excerpt text for an In Brief node (migrate manifest).
 */
function df_impact_in_brief_listing_excerpt(NodeInterface $node): string {
  $row = df_impact_in_brief_manifest_row($node);
  if (!empty($row['excerpt'])) {
    return df_impact_decode_plain_text(trim(strip_tags((string) $row['excerpt'])));
  }
  return df_impact_in_brief_plain_excerpt($node);
}

/**
 * @return array<string, mixed>
 */
function df_impact_article_manifest_row(NodeInterface $node): array {
  static $by_alias = NULL;
  if ($by_alias === NULL) {
    $by_alias = [];
    $module_path = \Drupal::service('extension.list.module')->getPath('df_migrate');
    $json_path = DRUPAL_ROOT . '/' . $module_path . '/data/articles.json';
    if (is_readable($json_path)) {
      $items = json_decode((string) file_get_contents($json_path), TRUE);
      if (is_array($items)) {
        foreach ($items as $item) {
          if (!empty($item['drupal_alias'])) {
            $by_alias[$item['drupal_alias']] = $item;
          }
        }
      }
    }
  }
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $node->id());
  return $by_alias[$alias] ?? [];
}

function df_impact_in_brief_manifest_row(NodeInterface $node): array {
  static $by_alias = NULL;
  if ($by_alias === NULL) {
    $by_alias = [];
    $module_path = \Drupal::service('extension.list.module')->getPath('df_migrate');
    $json_path = DRUPAL_ROOT . '/' . $module_path . '/data/in_brief.json';
    if (is_readable($json_path)) {
      $items = json_decode((string) file_get_contents($json_path), TRUE);
      if (is_array($items)) {
        foreach ($items as $item) {
          if (!empty($item['drupal_alias'])) {
            $by_alias[$item['drupal_alias']] = $item;
          }
        }
      }
    }
  }
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $node->id());
  return $by_alias[$alias] ?? [];
}

/**
 * Archive listing excerpt for articles (field_excerpt or trimmed body).
 */
/**
 * Decodes HTML entities for plain-text fields (titles, excerpts, alts).
 */
function df_impact_decode_plain_text(?string $text): string {
  return \Drupal\df_migrate\TextEntityHelper::decode($text);
}

function df_impact_archive_excerpt_for_node(NodeInterface $node): string {
  $manifest = df_impact_article_manifest_row($node);
  if (!empty($manifest['excerpt'])) {
    return df_impact_decode_plain_text(trim(strip_tags((string) $manifest['excerpt'])));
  }
  if ($node->hasField('field_excerpt') && !$node->get('field_excerpt')->isEmpty()) {
    return trim(strip_tags($node->get('field_excerpt')->value ?? ''));
  }
  if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
    $text = strip_tags($node->get('body')->value ?? '');
    return trim(text_summary($text, NULL, 280));
  }
  return '';
}

function df_impact_get_header_issue_links(int $limit = 4): array {
  // Match WordPress Max Mega Menu order/labels from reference-pack chrome.
  $canonical = [
    ['path' => '/fall-2026-issue', 'title' => 'Fall 2026'],
    ['path' => '/summer-2026-issue', 'title' => 'Summer 2026'],
    ['path' => '/spring-2026-issue', 'title' => 'Spring 2026'],
    ['path' => '/winter-2025-issue', 'title' => 'Winter 2025'],
  ];
  $links = [];
  foreach (array_slice($canonical, 0, $limit) as $item) {
    $links[] = [
      'title' => $item['title'],
      'url' => Url::fromUri('internal:' . $item['path'])->toString(),
    ];
  }
  return $links;
}

/**
 * Implements hook_page_attachments_alter().
 */
function df_impact_page_attachments_alter(array &$attachments) {
  $attachments['#attached']['library'][] = 'df_impact/gtranslate';

  // Add viewport meta tag.
  $viewport = [
    '#type' => 'html_tag',
    '#tag' => 'meta',
    '#attributes' => [
      'name' => 'viewport',
      'content' => 'width=device-width, initial-scale=1',
    ],
  ];
  $attachments['#attached']['html_head'][] = [$viewport, 'viewport'];
}
