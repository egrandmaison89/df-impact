<?php

/**
 * @file
 * Functions to support theming in the Dana-Farber Impact theme.
 */

use Drupal\Core\Template\Attribute;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;
use Drupal\views\ViewExecutable;
use Drupal\views\Views;

/**
 * Implements hook_theme().
 */
function df_impact_theme($existing, $type, $theme, $path) {
  return [
    'in_brief_listing_by_issue' => [
      'variables' => [
        'sections' => [],
      ],
    ],
  ];
}

/**
 * Groups In Brief nodes by issue; issues newest-first (year, then season).
 *
 * @return list<array{issue_label: string, briefs: \Drupal\node\NodeInterface[]}>
 */
function df_impact_group_in_brief_nodes_by_issue(): array {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $nids = $storage->getQuery()
    ->condition('type', 'in_brief')
    ->condition('status', 1)
    ->accessCheck()
    ->execute();
  if (!$nids) {
    return [];
  }

  /** @var \Drupal\node\NodeInterface[] $nodes */
  $nodes = $storage->loadMultiple($nids);
  $by_issue = [];
  foreach ($nodes as $node) {
    if (!$node->hasField('field_issue') || $node->get('field_issue')->isEmpty()) {
      continue;
    }
    $issue_id = (string) $node->get('field_issue')->target_id;
    $by_issue[$issue_id][] = $node;
  }

  foreach ($by_issue as &$briefs) {
    usort($briefs, static function (NodeInterface $a, NodeInterface $b): int {
      return $b->getCreatedTime() <=> $a->getCreatedTime();
    });
  }

  $season_weight = [
    'spring' => 1,
    'summer' => 2,
    'fall' => 3,
    'winter' => 4,
  ];

  $issue_ids = array_keys($by_issue);
  /** @var \Drupal\node\NodeInterface[] $issues */
  $issues = $storage->loadMultiple($issue_ids);
  usort($issue_ids, static function (string $a, string $b) use ($issues, $season_weight): int {
    $ia = $issues[$a] ?? NULL;
    $ib = $issues[$b] ?? NULL;
    if (!$ia || !$ib || $ia->bundle() !== 'issue' || $ib->bundle() !== 'issue') {
      return 0;
    }
    $ya = (int) ($ia->get('field_year')->value ?? 0);
    $yb = (int) ($ib->get('field_year')->value ?? 0);
    if ($ya !== $yb) {
      return $yb <=> $ya;
    }
    $wa = $season_weight[$ia->get('field_season')->value] ?? 0;
    $wb = $season_weight[$ib->get('field_season')->value] ?? 0;
    return $wb <=> $wa;
  });

  $out = [];
  foreach ($issue_ids as $issue_id) {
    $issue = $issues[$issue_id] ?? NULL;
    if (!$issue || $issue->bundle() !== 'issue') {
      continue;
    }
    $label = df_impact_format_issue_label($issue);
    if ($label === NULL) {
      $label = $issue->label();
    }
    $out[] = [
      'issue_label' => $label,
      'briefs' => $by_issue[$issue_id],
    ];
  }

  return $out;
}

/**
 * Build renderable sections for the In Brief archive (per-issue wrappers).
 *
 * @param list<array{issue_label: string, briefs: \Drupal\node\NodeInterface[]}>|null $grouped
 *   Grouped nodes; loads when NULL.
 */
function df_impact_build_in_brief_listing_sections(?array $grouped = NULL): array {
  $grouped ??= df_impact_group_in_brief_nodes_by_issue();
  $view_builder = \Drupal::entityTypeManager()->getViewBuilder('node');
  $sections = [];

  foreach ($grouped as $row) {
    $items = [];
    foreach ($row['briefs'] as $i => $node) {
      $build = $view_builder->view($node, 'in_brief_listing');
      $classes = ['in-brief-page__item', 'js-in-brief-item'];
      if ($i >= 5) {
        $classes[] = 'is-collapsed';
      }
      $items[] = [
        '#type' => 'container',
        '#attributes' => ['class' => $classes],
        'node' => $build,
      ];
    }
    $sections[] = [
      'issue_label' => $row['issue_label'],
      'items' => $items,
      'show_more' => count($row['briefs']) > 5,
    ];
  }

  return $sections;
}

/**
 * Implements hook_views_post_render().
 */
function df_impact_views_post_render(ViewExecutable $view, array &$output, $cache): void {
  if ($view->storage->id() !== 'in_brief_listing' || $view->current_display !== 'page_1') {
    return;
  }

  $grouped = df_impact_group_in_brief_nodes_by_issue();
  if ($grouped === []) {
    return;
  }

  $sections = df_impact_build_in_brief_listing_sections($grouped);
  $tags = [];
  foreach ($grouped as $row) {
    foreach ($row['briefs'] as $node) {
      $tags[] = 'node:' . $node->id();
      if ($node->hasField('field_issue') && !$node->get('field_issue')->isEmpty()) {
        $tags[] = 'node:' . $node->get('field_issue')->target_id;
      }
    }
  }

  // Theme variables must use #name keys when the element has #theme
  // (ThemeManager::render); plain 'sections' is ignored.
  $output['#rows'] = [
    '#theme' => 'in_brief_listing_by_issue',
    '#attached' => [
      'library' => ['df_impact/in_brief_page'],
    ],
    '#cache' => [
      'tags' => array_values(array_unique($tags)),
    ],
    '#sections' => $sections,
  ];

  if ($sections !== []) {
    $output['#empty'] = [];
  }
}

/**
 * Resolves the node entity for a Views result row (prefer _entity).
 */
function df_impact_views_result_row_node($row): ?NodeInterface {
  if (!$row) {
    return NULL;
  }
  if (isset($row->_entity) && $row->_entity instanceof NodeInterface) {
    return $row->_entity;
  }
  foreach (['nid', 'node_field_data_nid'] as $prop) {
    if (!empty($row->{$prop})) {
      $nid = (int) $row->{$prop};
      if ($nid > 0) {
        $node = \Drupal::entityTypeManager()->getStorage('node')->load($nid);
        if ($node instanceof NodeInterface) {
          return $node;
        }
      }
    }
  }
  return NULL;
}

/**
 * Implements hook_preprocess_views_view_fields().
 */
function df_impact_preprocess_views_view_fields(&$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view) {
    return;
  }
  $view_id = $view->storage->id();
  if ($view_id === 'browse_issues') {
    $node = df_impact_views_result_row_node($variables['row'] ?? NULL);
    if (!$node instanceof NodeInterface || $node->bundle() !== 'issue') {
      return;
    }
    $variables['issue_url'] = $node->toUrl()->toString();
    $variables['issue_thumbnail'] = df_impact_build_issue_browse_thumbnail($node);
    return;
  }
  if ($view_id === 'issue_articles' && ($view->current_display ?? '') === 'homepage_latest') {
    $node = df_impact_views_result_row_node($variables['row'] ?? NULL);
    if ($node instanceof NodeInterface && $node->bundle() === 'article') {
      $variables['article_card_image_fallback'] = df_impact_article_lead_image_fallback_build($node);
    }
    return;
  }

  $homepage_card_views = [
    'homepage_featured',
    'homepage_highlights',
    'homepage_digital_exclusives',
  ];
  if (in_array($view_id, $homepage_card_views, TRUE) && ($view->current_display ?? '') === 'default') {
    $node = df_impact_views_result_row_node($variables['row'] ?? NULL);
    if ($node instanceof NodeInterface && $node->bundle() === 'article') {
      $variables['article_card_image_fallback'] = df_impact_article_lead_image_fallback_build($node);
    }
  }
}

/**
 * Implements hook_preprocess_html().
 */
function df_impact_preprocess_html(array &$variables): void {
  // Safe defaults when df_site_snippets is disabled (module runs first when enabled).
  $variables += [
    'df_site_snippets_header' => NULL,
    'df_site_snippets_footer' => NULL,
  ];
  $route = \Drupal::routeMatch()->getRouteName();
  if (
    $route === 'view.topic_archive.page_1'
    && isset($variables['attributes'])
    && $variables['attributes'] instanceof Attribute
  ) {
    $variables['attributes']->addClass('path-category-archive');
  }
}

/**
 * Implements hook_preprocess_page().
 */
function df_impact_preprocess_page(&$variables) {
  // Add the current year for copyright.
  $variables['current_year'] = date('Y');

  // Check if we're on the front page.
  $variables['is_front'] = \Drupal::service('path.matcher')->isFrontPage();
  $variables['is_about_impact'] = df_impact_is_about_impact_page();

  // Donate CTA — match legacy WordPress / Jimmy Fund campaign parameters.
  $variables['donate_url'] = 'https://danafarber.jimmyfund.org/site/Donation2?df_id=2101&mfc_pref=T&2101.donation=form1&utm_source=dfimpact&utm_medium=button&utm_campaign=AGDFI031323&s_src=AGDFI031323&s_subsrc=AGDFI031323';
  $route_provider = \Drupal::service('router.route_provider');
  if ($route_provider->getRoutesByNames(['df_searchstax.page'])) {
    $variables['search_page_url'] = Url::fromRoute('df_searchstax.page')->toString();
  }
  else {
    $variables['search_page_url'] = Url::fromRoute('view.df_impact_search.page_1')->toString();
  }

  $variables['about_impact_url'] = Url::fromUri('internal:/about-impact')->toString();

  $topic_order = [
    'Cancer Research',
    'Total Patient Care',
    'Prevention and Early Detection',
    'Access and Equity',
    'Immunotherapy',
    'Drug Development',
    'Pediatrics',
    'Grassroots Support',
    'Discovery Science',
    'Planned Giving',
  ];
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $footer_topic_links = [];
  foreach ($topic_order as $name) {
    $terms = $term_storage->loadByProperties([
      'vid' => 'topics',
      'name' => $name,
    ]);
    $term = reset($terms);
    if ($term && $term->isPublished()) {
      $footer_topic_links[] = [
        'title' => $term->label(),
        'url' => Url::fromUri('internal:/category/' . df_setup_topic_category_slug($term->label()))->toString(),
      ];
    }
  }
  $variables['footer_topic_links'] = $footer_topic_links;

  // Front page: stories from the newest issue (WordPress "Explore" band).
  $variables['latest_issue_articles'] = NULL;
  $variables['latest_issue_url'] = NULL;
  $variables['latest_issue_label'] = NULL;
  if (!empty($variables['is_front'])) {
    $latest_nid = df_impact_get_latest_issue_nid();
    if ($latest_nid !== NULL) {
      $issue = \Drupal::entityTypeManager()->getStorage('node')->load($latest_nid);
      if ($issue instanceof NodeInterface && $issue->bundle() === 'issue') {
        $variables['latest_issue_url'] = $issue->toUrl()->toString();
        $variables['latest_issue_label'] = df_impact_format_issue_label($issue);
      }
      $view = Views::getView('issue_articles');
      if ($view) {
        $view->setDisplay('homepage_latest');
        $view->setArguments([(string) $latest_nid]);
        $view->execute();
        if (!empty($view->result)) {
          $variables['latest_issue_articles'] = $view->buildRenderable('homepage_latest', [(string) $latest_nid]);
        }
      }
    }
  }
}

/**
 * Implements hook_preprocess_node().
 */
function df_impact_preprocess_node(&$variables) {
  $node = $variables['node'];

  // Add view mode class.
  $variables['attributes']['class'][] = 'node--view-mode-' . str_replace('_', '-', $variables['view_mode']);
  $variables['is_about_impact_node'] = df_impact_is_about_impact_page($node);

  // Issue full: promo cards below In Brief (WordPress layout).
  if ($node->bundle() === 'issue' && $variables['view_mode'] === 'full') {
    $variables['issue_promo_cards'] = [];
    $view_builder = \Drupal::entityTypeManager()->getViewBuilder('node');
    foreach (['field_leadership_message', 'field_issue_promo_2'] as $field_name) {
      if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
        continue;
      }
      $referenced = $node->get($field_name)->entity;
      if ($referenced instanceof NodeInterface) {
        $variables['issue_promo_cards'][] = $view_builder->view($referenced, 'issue_promo');
      }
    }
  }

  // For articles, make the issue link available.
  if ($node->bundle() === 'article' && $node->hasField('field_issue') && !$node->get('field_issue')->isEmpty()) {
    $issue = $node->get('field_issue')->entity;
    if ($issue) {
      $variables['issue_title'] = $issue->label();
      $variables['issue_url'] = $issue->toUrl()->toString();
    }
  }

  // Related articles by shared topics when editors did not pick manual related nodes.
  if ($node->bundle() === 'article' && $variables['view_mode'] === 'full') {
    $df = \Drupal::service('date.formatter');
    $created = $node->getCreatedTime();
    $variables['article_published'] = $df->format($created, 'custom', 'F j, Y');
    $variables['article_published_iso'] = $df->format($created, 'custom', 'c');

    $variables['article_lead_image_fallback'] = NULL;
    if ($node->hasField('field_featured_image') && $node->get('field_featured_image')->isEmpty()) {
      $variables['article_lead_image_fallback'] = df_impact_article_lead_image_fallback_build($node);
    }

    if ($node->hasField('field_related_articles') && $node->get('field_related_articles')->isEmpty()) {
      $topic_ids = [];
      if ($node->hasField('field_topics')) {
        foreach ($node->get('field_topics') as $item) {
          $topic_ids[] = $item->target_id;
        }
      }
      if ($topic_ids !== []) {
        $variables['related_by_topic'] = views_embed_view(
          'related_articles',
          'block_1',
          implode('+', $topic_ids),
          (string) $node->id(),
        );
      }
    }
  }
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function df_impact_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  // Add page template suggestions based on node type.
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof NodeInterface) {
    $suggestions[] = 'page__node__' . $node->bundle();
  }
}

/**
 * Implements hook_theme_suggestions_node_alter().
 */
function df_impact_theme_suggestions_node_alter(array &$suggestions, array $variables) {
  // Add node--TYPE--VIEW_MODE suggestion.
  $node = $variables['elements']['#node'];
  $view_mode = $variables['elements']['#view_mode'];
  $suggestions[] = 'node__' . $node->bundle() . '__' . $view_mode;
}

/**
 * Implements hook_preprocess_block().
 */
function df_impact_preprocess_block(&$variables) {
  // Pass is_node flag to blocks so page title can be hidden on node pages.
  $node = \Drupal::routeMatch()->getParameter('node');
  $variables['is_node'] = $node instanceof NodeInterface;
  $variables['is_front'] = \Drupal::service('path.matcher')->isFrontPage();
  $variables['is_about_impact'] = df_impact_is_about_impact_page();
}

/**
 * Implements hook_preprocess_HOOK() for breadcrumb.
 */
function df_impact_preprocess_breadcrumb(array &$variables): void {
  if (df_impact_is_about_impact_page()) {
    $variables['breadcrumb'] = [];
  }
}

/**
 * Implements hook_preprocess_HOOK() for menu-local-task.
 */
function df_impact_preprocess_menu_local_task(&$variables): void {
  $variables['link']['#options']['attributes']['class'][] = 'tabs__link';

  if (!empty($variables['is_active'])) {
    $variables['link']['#options']['attributes']['class'][] = 'is-active';
  }

  $link = $variables['element']['#link'] ?? [];
  if (!empty($link['url']) && $link['url']->getRouteName() === 'entity.node.delete_form') {
    // During preprocess, attributes may still be an array (Attribute object is applied later).
    $variables['attributes']['class'][] = 'tabs__tab--danger';
  }
}

/**
 * Implements hook_preprocess_field().
 */
function df_impact_preprocess_field(&$variables) {
  // Add article tag styling to taxonomy reference fields.
  $field_name = $variables['field_name'];
  if (in_array($field_name, ['field_topics', 'field_cancer_types'])) {
    foreach ($variables['items'] as &$item) {
      $item['attributes']->addClass('article__tag');
    }
  }
}

/**
 * Implements hook_theme_suggestions_views_view_unformatted_alter().
 */
function df_impact_theme_suggestions_views_view_unformatted_alter(array &$suggestions, array $variables) {
  $view = $variables['view'];
  $suggestions[] = 'views_view_unformatted__' . $view->id();
  $suggestions[] = 'views_view_unformatted__' . $view->id() . '__' . $view->current_display;
}

/**
 * Implements hook_theme_suggestions_views_view_fields_alter().
 */
function df_impact_theme_suggestions_views_view_fields_alter(array &$suggestions, array $variables) {
  $view = $variables['view'];
  $suggestions[] = 'views_view_fields__' . $view->id();
  $suggestions[] = 'views_view_fields__' . $view->id() . '__' . $view->current_display;
}

/**
 * Implements hook_theme_suggestions_views_view_alter().
 */
function df_impact_theme_suggestions_views_view_alter(array &$suggestions, array $variables) {
  $view = $variables['view'];
  $suggestions[] = 'views_view__' . $view->id();
  $suggestions[] = 'views_view__' . $view->id() . '__' . $view->current_display;
}

/**
 * Formats an issue node as "Spring 2026" for homepage labels.
 */
function df_impact_format_issue_label(NodeInterface $issue): ?string {
  if ($issue->bundle() !== 'issue') {
    return NULL;
  }
  $map = [
    'spring' => 'Spring',
    'summer' => 'Summer',
    'fall' => 'Fall',
    'winter' => 'Winter',
  ];
  $season_key = $issue->get('field_season')->value;
  $season = $map[$season_key] ?? ($season_key ? ucfirst((string) $season_key) : '');
  $year = $issue->get('field_year')->value;
  if ($season !== '' && $year !== NULL && $year !== '') {
    return $season . ' ' . $year;
  }
  if ($season !== '') {
    return $season;
  }
  return $issue->label();
}

/**
 * Determines whether the current or provided node is the editable About page.
 */
function df_impact_is_about_impact_page(?NodeInterface $node = NULL): bool {
  if (!$node) {
    $route_node = \Drupal::routeMatch()->getParameter('node');
    $node = $route_node instanceof NodeInterface ? $route_node : NULL;
  }

  if (!$node instanceof NodeInterface || $node->bundle() !== 'page') {
    return FALSE;
  }

  try {
    if ($node->toUrl()->toString() === '/about-impact') {
      return TRUE;
    }
  }
  catch (\Exception) {
    // Fall back to the stable title used by the setup update hook.
  }

  return $node->label() === 'About Impact';
}

/**
 * Builds issue browse thumbnail: cover, then banner, then a story featured image.
 */
function df_impact_build_issue_browse_thumbnail(NodeInterface $issue): array {
  $formatter = [
    'type' => 'entity_reference_entity_view',
    'label' => 'hidden',
    'settings' => [
      'view_mode' => 'default',
      'link' => FALSE,
    ],
  ];
  foreach (['field_cover_image', 'field_banner_image'] as $field_name) {
    if ($issue->hasField($field_name) && !$issue->get($field_name)->isEmpty()) {
      return $issue->get($field_name)->view($formatter);
    }
  }
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $nids = $storage->getQuery()
    ->condition('type', 'article')
    ->condition('status', 1)
    ->condition('field_issue.target_id', $issue->id())
    ->sort('sticky', 'DESC')
    ->sort('created', 'DESC')
    ->range(0, 1)
    ->accessCheck()
    ->execute();
  if (!$nids) {
    return [];
  }
  $article = $storage->load(reset($nids));
  if (!$article instanceof NodeInterface) {
    return [];
  }
  if (!$article->hasField('field_featured_image') || $article->get('field_featured_image')->isEmpty()) {
    return [];
  }
  return $article->get('field_featured_image')->view($formatter);
}

/**
 * Returns the newest published issue node ID (year desc, season desc).
 */
function df_impact_get_latest_issue_nid(): ?int {
  $nids = \Drupal::entityQuery('node')
    ->condition('type', 'issue')
    ->condition('status', 1)
    ->sort('field_year', 'DESC')
    ->sort('field_season', 'DESC')
    ->range(0, 1)
    ->accessCheck()
    ->execute();
  if (!$nids) {
    return NULL;
  }
  return (int) reset($nids);
}

/**
 * Maps article node IDs to WordPress export rows (articles.json) for image fallbacks.
 *
 * @return array<int, array<string, mixed>>
 */
function df_impact_articles_export_rows_by_nid(): array {
  static $by_nid = NULL;
  if ($by_nid !== NULL) {
    return $by_nid;
  }
  $by_nid = [];
  $path = \Drupal::root() . '/modules/custom/df_migrate/data/articles.json';
  if (!is_readable($path)) {
    return $by_nid;
  }
  $rows = json_decode((string) file_get_contents($path), TRUE);
  if (!is_array($rows)) {
    return $by_nid;
  }
  $database = \Drupal::database();
  $wp_to_nid = [];
  if ($database->schema()->tableExists('migrate_map_df_articles')) {
    $wp_to_nid = $database->select('migrate_map_df_articles', 'm')
      ->fields('m', ['sourceid1', 'destid1'])
      ->execute()
      ->fetchAllKeyed();
    $wp_to_nid = array_map('intval', $wp_to_nid);
  }
  foreach ($rows as $row) {
    if (!is_array($row)) {
      continue;
    }
    $resolved = df_impact_article_export_resolve_nid($row, $wp_to_nid);
    if ($resolved !== NULL) {
      $by_nid[$resolved] = $row;
    }
  }
  return $by_nid;
}

/**
 * Maps drupal_alias (normalized with leading slash) to export rows.
 *
 * @return array<string, array<string, mixed>>
 */
function df_impact_articles_export_rows_by_drupal_alias(): array {
  static $by_alias = NULL;
  if ($by_alias !== NULL) {
    return $by_alias;
  }
  $by_alias = [];
  $path = \Drupal::root() . '/modules/custom/df_migrate/data/articles.json';
  if (!is_readable($path)) {
    return $by_alias;
  }
  $rows = json_decode((string) file_get_contents($path), TRUE);
  if (!is_array($rows)) {
    return $by_alias;
  }
  foreach ($rows as $row) {
    if (!is_array($row)) {
      continue;
    }
    $alias = $row['drupal_alias'] ?? '';
    if (!is_string($alias) || $alias === '') {
      continue;
    }
    $norm = '/' . trim($alias, '/');
    $by_alias[$norm] = $row;
  }
  return $by_alias;
}

/**
 * Finds the WordPress export row for an article (nid + migrate map, then path alias).
 *
 * @return array<string, mixed>|null
 */
function df_impact_article_export_row_for_node(NodeInterface $node): ?array {
  if ($node->bundle() !== 'article') {
    return NULL;
  }
  $by_nid = df_impact_articles_export_rows_by_nid();
  $nid = (int) $node->id();
  if (isset($by_nid[$nid])) {
    return $by_nid[$nid];
  }
  $internal = '/node/' . $nid;
  $langcode = $node->language()->getId();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($internal, $langcode);
  if (!is_string($alias) || $alias === '') {
    return NULL;
  }
  $alias = '/' . trim($alias, '/');
  if ($alias === $internal || strncmp($alias, '/node/', 6) === 0) {
    return NULL;
  }
  $by_alias = df_impact_articles_export_rows_by_drupal_alias();
  return $by_alias[$alias] ?? NULL;
}

/**
 * @param array<string, mixed> $row
 * @param array<int|string, int> $wp_to_nid
 */
function df_impact_article_export_resolve_nid(array $row, array $wp_to_nid): ?int {
  $wp_id = (int) ($row['wp_id'] ?? 0);
  if ($wp_id && isset($wp_to_nid[$wp_id])) {
    return (int) $wp_to_nid[$wp_id];
  }
  $alias = $row['drupal_alias'] ?? '';
  if (!is_string($alias) || $alias === '') {
    return NULL;
  }
  $alias = '/' . ltrim($alias, '/');
  $path_alias = \Drupal::service('path_alias.manager');
  foreach ([NULL, 'en'] as $langcode) {
    $internal = $langcode === NULL
      ? $path_alias->getPathByAlias($alias)
      : $path_alias->getPathByAlias($alias, $langcode);
    if (preg_match('#^/node/(\d+)$#', $internal, $m)) {
      return (int) $m[1];
    }
  }
  return NULL;
}

/**
 * @param array<string, mixed> $row
 *
 * @return list<string>
 */
function df_impact_article_export_try_image_urls(array $row): array {
  $out = [];
  $seen = [];
  $push = function (string $url) use (&$out, &$seen): void {
    $url = trim(html_entity_decode($url, ENT_QUOTES | ENT_HTML5, 'UTF-8'));
    if ($url === '') {
      return;
    }
    $key = strtolower($url);
    if (isset($seen[$key])) {
      return;
    }
    $seen[$key] = TRUE;
    $out[] = $url;
  };

  $primary = (string) ($row['featured_image_url'] ?? '');
  if ($primary !== '') {
    $push($primary);
  }
  $body = isset($row['body']) && is_string($row['body']) ? $row['body'] : '';
  if ($body !== '' && preg_match(
    '#https?://(?:i\d*\.wp\.com/)?danafarberimpact\.org/wp-content/uploads/[^\s"\'<>]+#i',
    $body,
    $m
  )) {
    $push($m[0]);
  }
  return $out;
}

/**
 * Resolves a WordPress uploads URL to a displayable image src (local public file preferred).
 */
function df_impact_article_fallback_image_src(string $url): ?string {
  $url = trim(html_entity_decode($url, ENT_QUOTES | ENT_HTML5, 'UTF-8'));
  $clean = preg_replace('/\?.*$/', '', $url);
  $file_system = \Drupal::service('file_system');
  $gen = \Drupal::service('file_url_generator');
  if (preg_match('#danafarberimpact\.org/wp-content/uploads/(.+\.(?:jpe?g|png|gif|webp))#i', $clean, $m)) {
    $relative_upload = $m[1];
    $basename = basename($relative_upload);
    foreach (['public://wp-images/' . $basename, 'public://' . $relative_upload] as $uri) {
      $path = $file_system->realpath($uri);
      if ($path && is_file($path)) {
        return $gen->generateString($uri);
      }
    }
  }
  if (preg_match('#^https?://#i', $clean)) {
    return $clean;
  }
  return NULL;
}

/**
 * @param array<string, mixed> $row
 */
function df_impact_article_export_lead_alt(array $row, NodeInterface $node): string {
  $body = isset($row['body']) && is_string($row['body']) ? $row['body'] : '';
  if ($body !== '' && preg_match('#<img[^>]+alt=["\']([^"\']+)#i', $body, $m)) {
    return trim(html_entity_decode($m[1], ENT_QUOTES | ENT_HTML5, 'UTF-8'));
  }
  return '';
}

/**
 * Build a render array for the article lead / card when field_featured_image is empty.
 */
function df_impact_article_lead_image_fallback_build(NodeInterface $node): ?array {
  if ($node->bundle() !== 'article') {
    return NULL;
  }
  if (!$node->hasField('field_featured_image') || !$node->get('field_featured_image')->isEmpty()) {
    return NULL;
  }
  $row = df_impact_article_export_row_for_node($node);
  if (!is_array($row)) {
    return NULL;
  }
  foreach (df_impact_article_export_try_image_urls($row) as $candidate) {
    $src = df_impact_article_fallback_image_src($candidate);
    if ($src === NULL || $src === '') {
      continue;
    }
    $alt = df_impact_article_export_lead_alt($row, $node);
    if ($alt === '') {
      $alt = mb_substr($node->label(), 0, 512);
    }
    return [
      '#type' => 'html_tag',
      '#tag' => 'img',
      '#attributes' => [
        'src' => $src,
        'alt' => $alt,
        'loading' => 'lazy',
        'decoding' => 'async',
        'class' => ['article__lead-fallback-img'],
      ],
      '#cache' => [
        'tags' => $node->getCacheTags(),
        'contexts' => ['languages:language_interface'],
      ],
    ];
  }
  return NULL;
}

/**
 * Implements hook_preprocess_page_title().
 *
 * Fixes Views page title callback returning literal %1 for topic archives.
 */
function df_impact_preprocess_page_title(array &$variables): void {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name !== 'view.topic_archive.page_1') {
    return;
  }
  $slug_raw = \Drupal::routeMatch()->getParameter('arg_0');
  $slug = is_scalar($slug_raw) ? mb_strtolower(trim((string) $slug_raw), 'UTF-8') : '';
  if ($slug === '' || !function_exists('df_setup_topic_term_load_by_category_slug')) {
    return;
  }
  $term = df_setup_topic_term_load_by_category_slug($slug);
  if ($term && $term->isPublished()) {
    $variables['title'] = $term->getName();
  }
}

/**
 * Implements hook_page_attachments_alter().
 */
function df_impact_page_attachments_alter(array &$attachments) {
  $attachments['#attached']['library'][] = 'df_impact/gtranslate';

  // Add viewport meta tag.
  $viewport = [
    '#type' => 'html_tag',
    '#tag' => 'meta',
    '#attributes' => [
      'name' => 'viewport',
      'content' => 'width=device-width, initial-scale=1',
    ],
  ];
  $attachments['#attached']['html_head'][] = [$viewport, 'viewport'];
}
