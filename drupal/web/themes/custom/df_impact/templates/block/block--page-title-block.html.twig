{#
/**
 * @file
 * Theme override for the page title block.
 * Hidden on node pages (node templates handle their own titles)
 * and on the front page.
 */
#}
{% if not is_front and not is_node %}
  <div{{ attributes }}>
    {{ title_prefix }}
    {% if content %}
      {{ content }}
    {% endif %}
    {{ title_suffix }}
  </div>
{% endif %}
