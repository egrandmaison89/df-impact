{#
/**
 * @file
 * Theme override for the page title block.
 * Hidden on node pages (node templates handle their own titles), on the front
 * page, and on custom pages that render their own title.
 */
#}
{% if not is_front and not is_node and not is_about_impact %}
  <div{{ attributes }}>
    {{ title_prefix }}
    {% if content %}
      {{ content }}
    {% endif %}
    {{ title_suffix }}
  </div>
{% endif %}
