{#
  Primary local tasks — visible for logged-in editors; hidden markup for anonymous parity.
#}
{% if page.highlighted and not is_about_impact %}
  {% if logged_in %}
    <div class="highlighted df-admin-local-tasks">
      {{ page.highlighted }}
    </div>
  {% else %}
    <div class="highlighted visually-hidden">
      {{ page.highlighted }}
    </div>
  {% endif %}
{% endif %}
