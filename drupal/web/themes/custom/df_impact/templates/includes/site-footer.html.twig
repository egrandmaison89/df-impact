{#
/**
 * @file
 * Site footer — light main band, DEI strip, navy legal bar (WordPress parity).
 */
#}
<footer class="footer" role="contentinfo">
  <div class="footer__main">
    <div class="footer__inner footer__grid">
      <div class="footer__col footer__col--about">
        <h2 class="footer__heading">{{ 'About'|t }}</h2>
        <ul class="footer__link-list">
          <li><a href="{{ about_impact_url }}" class="footer__link">{{ 'About Impact'|t }}</a></li>
          <li><a href="{{ path('view.browse_issues.page_1') }}" class="footer__link">{{ 'See All Issues'|t }}</a></li>
          <li><a href="https://www.jimmyfund.org/events/" class="footer__link" target="_blank" rel="noopener">{{ 'Jimmy Fund Events'|t }}</a></li>
        </ul>
        <p class="footer__address">{{ 'The Jimmy Fund'|t }}<br>{{ '10 Brookline Place West, 5th Floor'|t }}<br>{{ 'Brookline, MA 02445-7226'|t }}<br>{{ '800-525-4669'|t }}</p>
        <div class="footer__brand-row">
          <a href="https://www.dana-farber.org" class="footer__brand-link" target="_blank" rel="noopener" aria-label="{{ 'Dana-Farber Cancer Institute'|t }}">
            <img src="/{{ directory }}/images/Dana-Farber-Logo.png" alt="" width="220" height="50" class="footer__brand-img" loading="lazy" decoding="async">
          </a>
          <a href="https://www.jimmyfund.org" class="footer__brand-link" target="_blank" rel="noopener" aria-label="{{ 'The Jimmy Fund'|t }}">
            <img src="/{{ directory }}/images/JFlogo_187.png" alt="" width="187" height="60" class="footer__brand-img footer__brand-img--jf" loading="lazy" decoding="async">
          </a>
        </div>
      </div>

      <div class="footer__col footer__col--categories">
        <h2 class="footer__heading">{{ 'Categories'|t }}</h2>
        {% if footer_topic_links is not empty %}
          <ul class="footer__link-list">
            {% for item in footer_topic_links %}
              <li><a href="{{ item.url }}" class="footer__link">{{ item.title }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

      <div class="footer__col footer__col--notes">
        <p class="footer__disclaimer">
          {% trans %}<strong>About Our Patient Stories</strong>: Dana-Farber shares patient stories which may include descriptions of actual medical results. Dana-Farber provides personalized care for each patient based on their unique needs; their experiences and results will vary.{% endtrans %}
        </p>
        <ul class="footer__badges" aria-label="{{ 'Recognition badges'|t }}">
          <li>
            <a href="https://health.usnews.com/best-hospitals/area/ma/dana-farber-cancer-institute-6140017" class="footer__badge" target="_blank" rel="noopener" aria-label="{{ 'U.S. News — Adult cancer care'|t }}">
              <img src="/{{ directory }}/images/USNews25-26.png" alt="" width="120" height="120" loading="lazy" decoding="async">
            </a>
          </li>
          <li>
            <a href="https://health.usnews.com/best-hospitals/pediatric-rankings/cancer" class="footer__badge" target="_blank" rel="noopener" aria-label="{{ 'U.S. News — Pediatric cancer'|t }}">
              <img src="/{{ directory }}/images/US-News-Badge-Childrens2526-417.png" alt="" width="120" height="120" loading="lazy" decoding="async">
            </a>
          </li>
          <li>
            <a href="https://www.charitynavigator.org/ein/042263040" class="footer__badge" target="_blank" rel="noopener" aria-label="{{ 'Charity Navigator'|t }}">
              <img src="/{{ directory }}/images/Charity-Navigator-Logo-2024.png" alt="" width="120" height="120" loading="lazy" decoding="async">
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer__dei">
    <div class="footer__inner footer__dei-inner">
      <p class="footer__dei-text">
        <a href="https://www.dana-farber.org/inclusion-diversity-and-equity/" class="footer__link" target="_blank" rel="noopener">{{ 'We work every day'|t }}</a>{{ ' to create an innovative, caring, and inclusive environment where each patient, family, and staff member feels valued and respected.'|t }}
      </p>
    </div>
  </div>

  <div class="footer__legal">
    <div class="footer__inner footer__legal-inner">
      <p class="footer__copyright">
        {{ 'Copyright © @year Dana-Farber Cancer Institute'|t({'@year': current_year}) }}
        <span class="footer__legal-sep" aria-hidden="true">|</span>
        <a href="https://www.jimmyfund.org/dana-farbers-jimmy-fund-fundraising-website-privacy-policy" class="footer__legal-link" target="_blank" rel="noopener">{{ 'Privacy Policy'|t }}</a>
        <span class="footer__legal-sep" aria-hidden="true">|</span>
        <a href="https://www.jimmyfund.org/terms-use" class="footer__legal-link" target="_blank" rel="noopener">{{ 'Terms of Use'|t }}</a>
        <span class="footer__legal-sep" aria-hidden="true">|</span>
        <a href="https://www.jimmyfund.org/website-accessibility-statement" class="footer__legal-link" target="_blank" rel="noopener">{{ 'Accessibility'|t }}</a>
      </p>
      <ul class="footer__social" aria-label="{{ 'Social media'|t }}">
        <li>
          <a href="https://www.facebook.com/thejimmyfund/" class="footer__social-btn" target="_blank" rel="noopener" aria-label="{{ 'Jimmy Fund on Facebook'|t }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M400 32H48A48 48 0 0 0 0 80v352a48 48 0 0 0 48 48h137.25V327.69h-63V256h63v-54.64c0-62.15 34-96.28 93.67-96.28 27.16 0 55.92 4.84 55.92 4.84v61h-31.27c-30.81 0-40.42 19.12-40.42 38.73V256h68.78l-11 71.69h-57.78V480H400a48 48 0 0 0 48-48V80a48 48 0 0 0-48-48z"/></svg>
          </a>
        </li>
        <li>
          <a href="https://twitter.com/TheJimmyFund" class="footer__social-btn" target="_blank" rel="noopener" aria-label="{{ 'Jimmy Fund on X'|t }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </li>
        <li>
          <a href="https://www.instagram.com/thejimmyfund/?ref=badge" class="footer__social-btn" target="_blank" rel="noopener" aria-label="{{ 'Jimmy Fund on Instagram'|t }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"/></svg>
          </a>
        </li>
      </ul>
    </div>
  </div>

  {% if page.footer_first or page.footer_second or page.footer_third %}
    <div class="footer__regions">
      <div class="footer__inner footer__regions-inner">
        {% if page.footer_first %}<div class="footer__region">{{ page.footer_first }}</div>{% endif %}
        {% if page.footer_second %}<div class="footer__region">{{ page.footer_second }}</div>{% endif %}
        {% if page.footer_third %}<div class="footer__region">{{ page.footer_third }}</div>{% endif %}
      </div>
    </div>
  {% endif %}
</footer>
