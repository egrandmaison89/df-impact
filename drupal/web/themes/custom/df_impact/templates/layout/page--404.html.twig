{#
  WordPress 404 template (blockmagchild): "OOPS!" header plus centered message and search block.
#}
<div class="wp-site-blocks">

  {% include '@df_impact/includes/wp-chrome-header.html.twig' %}

  <div class="wp-block-group alignfull no-margin-top header-media-inner-post is-layout-constrained wp-block-group-is-layout-constrained">
    <div class="wp-block-group alignwide is-layout-flow wp-block-group-is-layout-flow" style="padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px">
      <h1 class="alignwide blue-border-header has-text-color has-montserrat-font-family wp-block-heading" style="color:#003354;margin-top:20px;margin-bottom:20px;padding-top:0px;padding-right:20px;padding-bottom:0px;padding-left:15px;font-size:38px;font-style:normal;font-weight:600">{{ 'OOPS!'|t }}</h1>
    </div>
  </div>

  <main id="wp--skip-link--target" class="wp-block-group is-layout-flow wp-block-group-is-layout-flow">
    <div class="wp-block-group is-layout-flow wp-block-group-is-layout-flow">
      <div class="wp-block-group is-layout-constrained wp-block-group-is-layout-constrained">
        <p class="has-text-align-center wp-block-paragraph">{{ 'This page could not be found. Maybe try a search?'|t }}</p>
        <form role="search" method="get" action="{{ path('<front>') }}" class="wp-block-search__button-outside wp-block-search__icon-button aligncenter wp-block-search"><label class="wp-block-search__label screen-reader-text" for="wp-block-search__input-1">{{ 'Search'|t }}</label><div class="wp-block-search__inside-wrapper"><input class="wp-block-search__input" id="wp-block-search__input-1" placeholder="{{ 'Search...'|t }}" value="" type="search" name="s" required><button aria-label="{{ 'Search'|t }}" class="wp-block-search__button has-icon wp-element-button" type="submit"><svg class="search-icon" viewBox="0 0 24 24" width="24" height="24"><path d="M13 5c-3.3 0-6 2.7-6 6 0 1.4.5 2.7 1.3 3.7l-3.8 3.8 1.1 1.1 3.8-3.8c1 .8 2.3 1.3 3.7 1.3 3.3 0 6-2.7 6-6S16.3 5 13 5zm0 10.5c-2.5 0-4.5-2-4.5-4.5s2-4.5 4.5-4.5 4.5 2 4.5 4.5-2 4.5-4.5 4.5z"></path></svg></button></div></form>
      </div>
    </div>
  </main>

  {% include '@df_impact/includes/wp-chrome-footer.html.twig' %}

</div>
