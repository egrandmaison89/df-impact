{#
/**
 * @file
 * Theme override for the front page.
 *
 * Section order aligns with the legacy WordPress homepage pattern.
 */
#}
<div class="page">

  {% include '@df_impact/includes/site-header.html.twig' %}

  {# --- Hero: region block overrides default banner --- #}
  <section class="hero hero--front" aria-label="{{ 'Magazine feature imagery'|t }}">
    {% if page.hero %}
      {{ page.hero }}
    {% else %}
      <div class="hero__banner" role="group" aria-label="{{ 'Magazine feature imagery'|t }}">
        <img src="/{{ directory }}/images/Impact_Homepage_Banner_2560.jpg" width="2560" height="981" alt="{{ 'Blue-toned collage of Dana-Farber staff and patients'|t }}" class="hero__banner-img" loading="eager" fetchpriority="high">
        <div class="hero__banner-overlay">
          <div class="hero__banner-inner">
            <h1 class="hero__banner-title">{{ 'Stories From Our Community of Support'|t }}</h1>
          </div>
        </div>
      </div>
    {% endif %}
  </section>

  <main id="main-content" class="page__content page__content--front" role="main">

    {# --- Explore the latest issue --- #}
    <section class="homepage-section homepage-section--explore" aria-labelledby="homepage-explore-heading">
      <div class="container">
        <h2 id="homepage-explore-heading" class="homepage-section__title">{{ 'Explore the Latest Issue'|t }}</h2>
        {% if latest_issue_label %}
          <p class="homepage-explore-issue-label">{{ latest_issue_label }}</p>
        {% endif %}
        {% if latest_issue_articles %}
          <div class="homepage-latest-issue-stories">
            {{ latest_issue_articles }}
          </div>
        {% else %}
          <div class="homepage-current-issue">
            {{ drupal_view('browse_issues', 'current_issue') }}
          </div>
        {% endif %}
        <p class="homepage-section__footer-link">
          {% if latest_issue_url %}
            <a href="{{ latest_issue_url }}" class="btn btn--primary btn--homepage">{{ 'See Full Issue'|t }}</a>
          {% else %}
            <a href="{{ path('view.browse_issues.page_1') }}" class="btn btn--primary btn--homepage">{{ 'See Full Issue'|t }}</a>
          {% endif %}
        </p>
      </div>
    </section>

    {# --- Digital exclusives (before recent highlights, matching WordPress) --- #}
    <section class="homepage-section" aria-labelledby="homepage-de-heading">
      <div class="container">
        <div class="homepage-section__header">
          <h2 id="homepage-de-heading" class="homepage-section__title">{{ 'Digital Exclusives'|t }}</h2>
        </div>
        {{ drupal_view('homepage_digital_exclusives', 'block_1') }}
        <p class="homepage-section__footer-link">
          <a href="{{ path('view.digital_exclusives_archive.page_1') }}" class="btn btn--primary btn--homepage">{{ 'All Digital Exclusives'|t }}</a>
        </p>
      </div>
    </section>

    {# --- Recent highlights --- #}
    <section class="homepage-section" aria-labelledby="homepage-highlights-heading">
      <div class="container">
        <div class="homepage-section__header">
          <h2 id="homepage-highlights-heading" class="homepage-section__title">{{ 'Recent Highlights'|t }}</h2>
        </div>
        {{ drupal_view('homepage_highlights', 'block_1') }}
        <p class="homepage-section__footer-link">
          <a href="{{ path('view.browse_issues.page_1') }}" class="btn btn--primary btn--homepage">{{ 'See All Issues'|t }}</a>
        </p>
      </div>
    </section>

  </main>

  {% include '@df_impact/includes/site-footer.html.twig' %}

</div>
