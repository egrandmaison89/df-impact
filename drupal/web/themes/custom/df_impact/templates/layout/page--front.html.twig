{#
/**
 * @file
 * Theme override for the front page.
 *
 * Section order aligns with the legacy WordPress homepage pattern:
 * primary frame → current issue → featured row → digital exclusives → recent highlights.
 */
#}
<div class="page">

  {% include '@df_impact/includes/site-header.html.twig' %}

  {# --- Hero: region block overrides default collage --- #}
  <section class="hero" aria-label="{{ 'Magazine feature imagery'|t }}">
    {% if page.hero %}
      {{ page.hero }}
    {% else %}
      <div class="hero__default">
        <img src="/sites/default/files/wp-images/DFCI1450_Impact-Cover-1024x734.jpg" width="1024" height="734" alt="{{ 'Dana-Farber Impact Magazine cover collage'|t }}" class="hero__image" loading="eager" fetchpriority="high">
      </div>
    {% endif %}
  </section>

  <main id="main-content" class="page__content page__content--front" role="main">

    <div class="container">
      <h1 class="homepage-hero-title">{{ 'Stories From Our Community of Support'|t }}</h1>
    </div>

    {# --- Explore the latest issue --- #}
    <section class="homepage-section homepage-section--explore" aria-labelledby="homepage-explore-heading">
      <div class="container">
        <h2 id="homepage-explore-heading" class="homepage-section__title">{{ 'Explore the Latest Issue'|t }}</h2>
        <div class="homepage-current-issue">
          {{ drupal_view('browse_issues', 'current_issue') }}
        </div>
        <p class="homepage-section__footer-link">
          <a href="{{ path('view.browse_issues.page_1') }}">{{ 'Browse all issues'|t }}</a>
        </p>
      </div>
    </section>

    <hr class="divider-gradient" aria-hidden="true">

    {# --- Featured articles --- #}
    <section class="homepage-section" aria-labelledby="homepage-featured-heading">
      <div class="container">
        <div class="homepage-section__header">
          <h2 id="homepage-featured-heading" class="homepage-section__title">{{ 'Featured Stories'|t }}</h2>
        </div>
        <div class="grid grid--featured">
          {{ drupal_view('homepage_featured', 'block_1') }}
        </div>
      </div>
    </section>

    <hr class="divider-gradient" aria-hidden="true">

    {# --- Digital exclusives (before recent highlights, matching WordPress) --- #}
    <section class="homepage-section" aria-labelledby="homepage-de-heading">
      <div class="container">
        <div class="homepage-section__header">
          <h2 id="homepage-de-heading" class="homepage-section__title">{{ 'Digital Exclusives'|t }}</h2>
          <a href="{{ path('view.digital_exclusives_archive.page_1') }}" class="homepage-section__more">{{ 'View All'|t }}</a>
        </div>
        <div class="grid grid--4">
          {{ drupal_view('homepage_digital_exclusives', 'block_1') }}
        </div>
      </div>
    </section>

    <hr class="divider-gradient" aria-hidden="true">

    {# --- Recent highlights --- #}
    <section class="homepage-section homepage-section--gray" aria-labelledby="homepage-highlights-heading">
      <div class="container">
        <div class="homepage-section__header">
          <h2 id="homepage-highlights-heading" class="homepage-section__title">{{ 'Recent Highlights'|t }}</h2>
        </div>
        <div class="grid grid--3">
          {{ drupal_view('homepage_highlights', 'block_1') }}
        </div>
      </div>
    </section>

    {% if page.content %}
      {{ page.content }}
    {% endif %}

  </main>

  {% include '@df_impact/includes/site-footer.html.twig' %}

</div>
