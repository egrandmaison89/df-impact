{#
/**
 * @file
 * Theme override to display a single page.
 */
#}
<div class="page">

  {% include '@df_impact/includes/site-header.html.twig' %}

  {# --- Hero Region --- #}
  {% if page.hero %}
    <section class="hero">
      {{ page.hero }}
    </section>
  {% endif %}

  {# --- Highlighted Region --- #}
  {% if page.highlighted %}
    <div class="highlighted">
      <div class="container">
        {{ page.highlighted }}
      </div>
    </div>
  {% endif %}

  {# --- Main Content --- #}
  <main id="main-content" class="page__content" role="main">
    <a id="main-content-anchor" tabindex="-1"></a>

    {% if page.sidebar %}
      <div class="container">
        <div class="layout-with-sidebar">
          <div class="layout-with-sidebar__content">
            {{ page.content }}
          </div>
          <aside class="layout-with-sidebar__sidebar" role="complementary">
            {{ page.sidebar }}
          </aside>
        </div>
      </div>
    {% else %}
      {{ page.content }}
    {% endif %}
  </main>

  {% include '@df_impact/includes/site-footer.html.twig' %}

</div>
