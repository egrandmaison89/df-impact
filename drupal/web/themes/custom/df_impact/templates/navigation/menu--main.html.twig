{#
/**
 * @file
 * Theme override for the main navigation menu.
 * Renders as a horizontal nav bar with dropdown support.
 */
#}
{% import _self as menus %}
{{ menus.menu_links(items, attributes, 0) }}

{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}
  {% if items %}
    {% if menu_level == 0 %}
      <ul{{ attributes.addClass('header__nav-list') }}>
    {% else %}
      <ul class="header__dropdown">
    {% endif %}
    {% for item in items %}
      {% set item_classes = ['header__nav-item'] %}
      {% if item.below %}
        {% set item_classes = item_classes|merge(['header__nav-item--has-children']) %}
      {% endif %}
      <li{{ item.attributes.addClass(item_classes) }}>
        {% if menu_level == 0 %}
          {% set item_url = item.url.toString() %}
          {% if 'jimmyfund.org' in item_url and ('Donation2' in item_url or '/give/' in item_url or 'donate' in item_url|lower) %}
            {# Skip donate link — CTA is hardcoded in the header include. #}
          {% else %}
            <a href="{{ item.url }}" class="header__nav-link"{{ item.below ? ' aria-expanded="false" aria-haspopup="true"' }}>
              {{ item.title }}
            </a>
          {% endif %}
        {% else %}
          <a href="{{ item.url }}" class="header__dropdown-link">
            {{ item.title }}
          </a>
        {% endif %}
        {% if item.below %}
          {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
        {% endif %}
      </li>
    {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
