{#
  PostX-style pagination for issue landing article grids (ultp-pagination).
#}
{% if items %}
  {% set next_arrow %}
<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m9 18 6-6-6-6"></path>
</svg>
  {% endset %}
  {% set prev_arrow %}
<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m15 18-6-6 6-6"></path>
</svg>
  {% endset %}
  <div class="ultp-pagination-wrap ultp-pagination-ajax-action">
    <ul class="ultp-pagination">
      <li class="ultp-prev-page-numbers"{% if not items.previous %} style="display:none"{% endif %}>
        {% if items.previous %}
          <a href="{{ items.previous.href }}" rel="prev"{{ items.previous.attributes|without('href', 'rel') }}>{{ prev_arrow|raw }} {{ 'Previous'|t }}</a>
        {% else %}
          <a href="#">{{ prev_arrow|raw }} {{ 'Previous'|t }}</a>
        {% endif %}
      </li>
      {% if ellipses.previous %}
        <li class="ultp-first-dot"><a href="#">…</a></li>
      {% endif %}
      {% for key, item in items.pages %}
        <li class="ultp-center-item{{ current == key ? ' pagination-active' : '' }}" data-current="{{ key }}">
          {% if current == key %}
            <a href="{{ item.href }}" aria-current="page"{{ item.attributes|without('href') }}>{{ key }}</a>
          {% else %}
            <a href="{{ item.href }}"{{ item.attributes|without('href') }}>{{ key }}</a>
          {% endif %}
        </li>
      {% endfor %}
      {% if ellipses.next %}
        <li class="ultp-last-dot"><a href="#">…</a></li>
      {% endif %}
      {% if items.last and issue_postx_last_page|default(0) and ellipses.next %}
        <li class="ultp-last-pages" data-current="{{ issue_postx_last_page }}">
          <a href="{{ items.last.href }}"{{ items.last.attributes|without('href') }}>{{ issue_postx_last_page }}</a>
        </li>
      {% endif %}
      <li class="ultp-next-page-numbers">
        {% if items.next %}
          <a href="{{ items.next.href }}" rel="next"{{ items.next.attributes|without('href', 'rel') }}>{{ 'Next'|t }}{{ next_arrow|raw }}</a>
        {% else %}
          <a href="#">{{ 'Next'|t }}{{ next_arrow|raw }}</a>
        {% endif %}
      </li>
    </ul>
  </div>
{% endif %}
