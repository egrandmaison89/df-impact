{#
/**
 * @file
 * WordPress wp-block-query-pagination markup (paginate_links end_size 1, mid_size 2).
 */
#}
{% if wp_pager %}
  <nav class="{{ wp_pager.align_class ? wp_pager.align_class ~ ' ' }}wp-block-query-pagination is-content-justification-space-between is-layout-flex wp-container-core-query-pagination-is-layout-e2853e1a wp-block-query-pagination-is-layout-flex" aria-label="{{ 'Pagination'|t }}">
    {% if wp_pager.previous %}
      <a href="{{ wp_pager.previous }}" class="wp-block-query-pagination-previous has-small-font-size">{{ 'Previous Page'|t }}</a>
    {% endif %}
    <div class="wp-block-query-pagination-numbers">
      {%- for item in wp_pager.pages -%}
        {%- if item.type == 'current' -%}
          <span aria-current="page" class="page-numbers current">{{ item.num }}</span>
        {%- elseif item.type == 'dots' -%}
          <span class="page-numbers dots">&hellip;</span>
        {%- else -%}
          <a class="page-numbers" href="{{ item.href }}">{{ item.num }}</a>
        {%- endif %}
      {% endfor -%}
    </div>
    {% if wp_pager.next %}
      <a href="{{ wp_pager.next }}" class="wp-block-query-pagination-next has-small-font-size">{{ 'Next Page'|t }}</a>
    {% endif %}
  </nav>
{% endif %}
