{#
/**
 * @file
 * WordPress wp-block-query-pagination markup for archive views.
 */
#}
{% if items %}
  <nav class="wp-block-query-pagination is-content-justification-space-between is-layout-flex wp-container-core-query-pagination-is-layout-1 wp-block-query-pagination-is-layout-flex" role="navigation" aria-label="{{ 'Pagination'|t }}">
    <div class="wp-block-query-pagination-numbers">
      {% if items.previous %}
        <a class="wp-block-query-pagination-previous page-numbers" href="{{ items.previous.href }}" rel="prev"{{ items.previous.attributes|without('href', 'rel') }}>{{ items.previous.text|default('Previous'|t) }}</a>
      {% endif %}
      {% if ellipses.previous %}
        <span class="page-numbers dots">&hellip;</span>
      {% endif %}
      {% for key, item in items.pages %}
        {% if current == key %}
          <span aria-current="page" class="page-numbers current">{{ key }}</span>
        {% else %}
          <a class="page-numbers" href="{{ item.href }}"{{ item.attributes|without('href') }}>{{ key }}</a>
        {% endif %}
      {% endfor %}
      {% if ellipses.next %}
        <span class="page-numbers dots">&hellip;</span>
      {% endif %}
    </div>
    {% if items.next %}
      <a href="{{ items.next.href }}" class="wp-block-query-pagination-next has-small-font-size" rel="next"{{ items.next.attributes|without('href', 'rel') }}>{{ items.next.text|default('Next Page'|t) }}</a>
    {% endif %}
  </nav>
{% endif %}
