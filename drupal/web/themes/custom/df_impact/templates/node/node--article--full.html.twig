{#
  Article full — WordPress post template (reference-pack article pages).
#}
<div{{ attributes.addClass('wp-singular', 'post') }}>

  <div class="entry-content article__body alignwide wp-block-post-content is-layout-flow wp-block-post-content-is-layout-flow">

    {% if article_lead_figure is defined and article_lead_figure %}
      {{ article_lead_figure }}
    {% endif %}

    {% set has_byline = article_byline_display is defined and article_byline_display|trim %}
    {% set has_photo_credit = article_photo_credit_display is defined and article_photo_credit_display|trim %}
    {% if issue_url is defined and issue_url %}
      <p class="wp-block-paragraph" style="font-style:normal;font-weight:500">
        <a href="{{ issue_url }}">{{ issue_title }}</a>
        {% if has_byline %}<br>{{ article_byline_display }}{% endif %}
        {% if has_photo_credit %}<br>{{ article_photo_credit_display }}{% endif %}
      </p>
    {% elseif (has_byline or has_photo_credit) and not article_meta_in_body|default(false) %}
      <p class="wp-block-paragraph" style="font-style:normal;font-weight:500">
        {% if has_byline %}{{ article_byline_display }}{% endif %}
        {% if has_photo_credit %}{% if has_byline %}<br>{% endif %}{{ article_photo_credit_display }}{% endif %}
      </p>
    {% endif %}

    {% if article_body is defined and article_body %}
      {{ article_body }}
    {% else %}
      {{ content.body }}
    {% endif %}

    {% if content.field_content_sections|render|trim %}
      {{ content.field_content_sections }}
    {% endif %}

    {% include '@df_impact/includes/article-social-share.html.twig' %}
  </div>

  {% include '@df_impact/includes/single-post-footer.html.twig' %}

</div>
