{#
  Search result row — WordPress Better Search / query block layout.
#}
<li{{ attributes.addClass('wp-block-post', 'node--view-mode-search-result') }}>
  <div class="wp-block-columns is-layout-flex wp-container-core-columns-is-layout-f56f613f wp-block-columns-is-layout-flex">
    {% if search_result_image_url %}
      <div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow" style="flex-basis:33%">
        <div class="wp-block-columns is-style-default is-layout-flex wp-container-core-columns-is-layout-f56f613f wp-block-columns-is-layout-flex">
          <div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow" style="flex-basis:100%">
            <div class="wp-block-group is-nowrap is-layout-flex wp-container-core-group-is-layout-f56f613f wp-block-group-is-layout-flex"><figure class="wp-block-post-featured-image"><a href="{{ url }}" target="_self"><img width="{{ search_result_image_width }}" height="{{ search_result_image_height }}" src="{{ search_result_image_url }}" class="attachment-full size-full wp-post-image" alt="{{ search_result_image_alt }}" style="object-fit:contain;" loading="lazy" decoding="async"></a></figure></div>
          </div>
        </div>
      </div>
    {% endif %}
    <div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow" style="flex-basis:77%">
      <div class="wp-block-columns is-layout-flex wp-container-core-columns-is-layout-f56f613f wp-block-columns-is-layout-flex">
        <div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow" style="flex-basis:100%">
          <div class="wp-block-group wp-block-post-container is-layout-flow wp-block-group-is-layout-flow">
            <h2 style="font-size:24px;font-style:normal;font-weight:600" class="wp-block-post-title"><a href="{{ url }}" target="_self">{{ search_result_title|default(label) }}</a></h2>
            {% if search_result_excerpt %}
              <div class="wp-block-post-excerpt has-text-color has-black-color"><p class="wp-block-post-excerpt__excerpt">{{ search_result_excerpt }}</p></div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</li>
