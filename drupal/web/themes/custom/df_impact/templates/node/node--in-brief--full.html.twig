{#
/**
 * @file
 * In Brief full view — WordPress entry-content parity.
 */
#}
<article{{ attributes.addClass('wp-singular', 'in-brief-post', 'post') }}>

  <div class="wp-block-group alignfull is-content-justification-center is-layout-constrained wp-block-group-is-layout-constrained">
    <h1 class="alignwide wp-block-post-title has-libre-baskerville-font-family">{{ label }}</h1>
  </div>

  <div class="wp-block-group alignwide is-layout-flow wp-block-group-is-layout-flow">
    <div class="entry-content alignwide wp-block-post-content is-layout-flow wp-block-post-content-is-layout-flow">

      {% if in_brief_issue_url %}
        <p class="wp-block-paragraph" style="font-style:normal;font-weight:500">
          <a href="{{ in_brief_issue_url }}">{{ in_brief_issue_label }}</a>
          {% if in_brief_byline %}<br>By {{ in_brief_byline }}{% endif %}
        </p>
      {% elseif in_brief_byline %}
        <p class="wp-block-paragraph" style="font-style:normal;font-weight:500">By {{ in_brief_byline }}</p>
      {% endif %}

      {% if in_brief_image_url %}
        <figure class="wp-block-image alignleft size-large is-resized no-caption-image">
          <img decoding="async" src="{{ in_brief_image_url }}" alt="{{ in_brief_image_alt }}" class="wp-post-image">
        </figure>
      {% endif %}

      {% if content.field_summary|render|trim %}
        {{ content.field_summary }}
      {% endif %}
    </div>
  </div>
</article>
