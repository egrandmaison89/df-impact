{#
/**
 * @file
 * In Brief full view — WordPress entry-content parity (list-style body).
 */
#}
<article{{ attributes.addClass('wp-singular', 'in-brief-post') }}>
  <div class="wp-block-group alignwide is-layout-flow wp-block-group-is-layout-flow">
    {{ title_prefix }}
    <h1 class="wp-block-post-title has-libre-baskerville-font-family">{{ label }}</h1>
    {{ title_suffix }}

    {% if in_brief_image_url %}
      <figure class="wp-block-image alignwide size-large">
        <a href="{{ in_brief_item_url }}"><img decoding="async" src="{{ in_brief_image_url }}" alt="{{ in_brief_image_alt }}" class="wp-post-image"></a>
      </figure>
    {% endif %}

    {% if in_brief_excerpt %}
      <div class="wp-block-post-excerpt">
        <p class="wp-block-post-excerpt__excerpt">{{ in_brief_excerpt }}</p>
      </div>
    {% elseif content.field_summary|render|trim %}
      <div class="wp-block-post-excerpt">
        {{ content.field_summary }}
      </div>
    {% endif %}

    {% if in_brief_item_url %}
      <p class="wp-block-paragraph">
        <a href="{{ in_brief_item_url }}">{{ 'Continue Reading'|t }}</a>
      </p>
    {% endif %}
  </div>
</article>
