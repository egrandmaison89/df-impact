{#
/**
 * @file
 * Theme override for Issue nodes (full view mode).
 *
 * Order: hero → intro → In This Issue (grid + pager) → In Brief banner (CTA only) →
 * featured items (no section header; image + title promos).
 */
#}
<div{{ attributes.addClass('issue-page') }}>

  {% if content.field_banner_image|render|trim %}
    <div class="issue-page__banner">
      {{ content.field_banner_image }}
      <div class="issue-page__banner-overlay">
        <div class="issue-page__banner-panel">
          <h1 class="issue-page__banner-title">{{ label }}</h1>
        </div>
      </div>
    </div>
  {% else %}
    <div class="container">
      <h1 class="issue-page__title-fallback">{{ label }}</h1>
    </div>
  {% endif %}

  {% if content.field_description|render|trim %}
    <div class="issue-page__description">
      {{ content.field_description }}
    </div>
  {% endif %}

  <section class="issue-page__stories-region" aria-labelledby="issue-stories-heading">
    <div class="issue-page__stories-heading">
      <div class="container">
        <h2 id="issue-stories-heading" class="issue-page__stories-title">{{ 'In This Issue'|t }}</h2>
      </div>
    </div>
    <div class="issue-page__articles">
      {{ drupal_view('issue_articles', 'block_1', node.id) }}
    </div>
  </section>

  <section class="issue-page__in-brief-region" aria-labelledby="issue-in-brief-heading">
    <div class="container">
      <div class="issue-page__in-brief-banner">
        <header class="issue-page__in-brief-header">
          <h2 id="issue-in-brief-heading" class="issue-page__in-brief-title">{{ 'In Brief'|t }}</h2>
          <p class="issue-page__in-brief-dek">{{ 'More highlights from our generous community'|t }}</p>
        </header>
        <p class="issue-page__in-brief-action">
          <a href="{{ path('view.in_brief_listing.page_1') }}" class="issue-page__view-all-briefs">{{ 'View All Briefs'|t }}</a>
        </p>
      </div>
    </div>
  </section>

  {% if issue_promo_cards is not empty %}
    <div class="issue-page__promos">
      <div class="container">
        <div class="issue-page__promo-grid">
          {% for card in issue_promo_cards %}
            <div class="issue-page__promo">
              {{ card }}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

</div>
