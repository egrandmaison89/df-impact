{#
/**
 * @file
 * Theme override for Basic Page nodes (full view mode).
 */
#}
{% if is_about_impact_node %}
  <article{{ attributes.addClass('page-node', 'about-impact-page') }} aria-labelledby="about-impact-title">
    <div class="about-impact-page__inner">
      {{ title_prefix }}
      <h1 id="about-impact-title" class="wp-block-heading blue-border-header has-text-color has-montserrat-font-family about-impact-page__title">{{ label }}</h1>
      {{ title_suffix }}

      <div class="about-impact-page__body">
        {{ content.body }}
      </div>
    </div>
  </article>
{% else %}
<article{{ attributes.addClass('page-node', 'wp-singular', 'page') }}>
  {% if content.field_banner_image|render|trim %}
    <figure class="wp-block-image alignwide size-large">
      {{ content.field_banner_image }}
    </figure>
  {% endif %}

  {{ title_prefix }}
  <h1 class="wp-block-heading blue-border-header has-text-color has-montserrat-font-family">{{ label }}</h1>
  {{ title_suffix }}

  <div class="page-node__body wp-block-post-content">
    {{ content.body }}
  </div>

  {% if content.field_content_sections|render|trim %}
    <div class="page-node__sections">
      {{ content.field_content_sections }}
    </div>
  {% endif %}
</article>
{% endif %}
