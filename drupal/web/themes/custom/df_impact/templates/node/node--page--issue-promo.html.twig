{#
  Issue “In Brief” promo row — PostX excerpt card.
#}
<div class="ultp-block-item post-id-{{ node.id }}">
  <div class="ultp-block-content-wrap">
    {% if issue_promo_image_url %}
      <div class="ultp-block-image ultp-block-image-none">
        <a href="{{ url }}"><img decoding="async" src="{{ issue_promo_image_url }}" class="ultp-block-image-content lazyloaded" alt="{{ issue_promo_image_alt }}"></a>
      </div>
    {% endif %}
    <div class="ultp-block-content">
      <h2 class="ultp-block-title"><a href="{{ url }}">{{ label }}</a></h2>
      {% if issue_promo_excerpt %}
        <div class="ultp-block-excerpt">{{ issue_promo_excerpt }}</div>
      {% endif %}
      <div class="ultp-block-readmore"><a aria-label="{{ label }}" href="{{ url }}">{{ 'Continue Reading'|t }}</a></div>
    </div>
  </div>
</div>
