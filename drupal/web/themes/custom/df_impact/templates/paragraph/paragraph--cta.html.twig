{#
/**
 * @file
 * Theme override for Call to Action paragraphs.
 */
#}
<div{{ attributes.addClass('paragraph--cta') }}>
  {% if content.field_cta_heading|render|trim %}
    <h3 class="paragraph--cta__heading">{{ content.field_cta_heading }}</h3>
  {% endif %}

  {% if content.field_cta_body|render|trim %}
    <div class="paragraph--cta__body">
      {{ content.field_cta_body }}
    </div>
  {% endif %}

  {% if content.field_cta_button_url|render|trim %}
    <a href="{{ content.field_cta_button_url[0]['#url'] }}" class="paragraph--cta__button">
      {{ content.field_cta_button_text }}
    </a>
  {% endif %}
</div>
