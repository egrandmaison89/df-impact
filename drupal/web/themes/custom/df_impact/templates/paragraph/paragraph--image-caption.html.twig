{#
  Image with Caption — same figure markup as migrated wp-block-image stories.
#}
{% set display = paragraph.field_display_mode.value|default('half_right') %}
{% if display == 'half_left' %}
  {% set align = 'alignleft' %}
{% elseif display == 'full_width' %}
  {% set align = 'aligncenter' %}
{% else %}
  {% set align = 'alignright' %}
{% endif %}

<figure class="wp-block-image {{ align }} size-large is-resized">
  {{ content.field_para_image }}
  {% if paragraph.field_caption.value %}
    <figcaption class="wp-element-caption">{{ paragraph.field_caption.value }}</figcaption>
  {% endif %}
</figure>
