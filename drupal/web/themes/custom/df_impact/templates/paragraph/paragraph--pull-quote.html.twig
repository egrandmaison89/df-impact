{#
/**
 * @file
 * Pull Quote paragraph — WordPress core/pullquote block markup.
 */
#}
<figure{{ attributes.addClass('wp-block-pullquote', 'paragraph--pull-quote') }}>
  <blockquote>
    {{ content.field_quote_text.0 }}
    {% if content.field_attribution.0 %}
      <cite>{{ content.field_attribution.0 }}</cite>
    {% endif %}
  </blockquote>
</figure>
