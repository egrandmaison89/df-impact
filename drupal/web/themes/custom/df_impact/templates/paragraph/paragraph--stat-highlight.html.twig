{#
/**
 * @file
 * Theme override for Stat Highlight paragraphs.
 */
#}
<div{{ attributes.addClass('paragraph--stat-highlight') }}>
  <div class="paragraph--stat-highlight__number">
    {{ content.field_stat_number }}
  </div>
  <div class="paragraph--stat-highlight__label">
    {{ content.field_stat_label }}
  </div>
  {% if content.field_stat_description|render|trim %}
    <div class="paragraph--stat-highlight__description">
      {{ content.field_stat_description }}
    </div>
  {% endif %}
</div>
