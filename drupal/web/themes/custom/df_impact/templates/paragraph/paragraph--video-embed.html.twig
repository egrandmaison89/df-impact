{#
  Video Embed — YouTube or Vimeo iframe in the same wrapper as migrated embeds.
#}
{% if video_embed_src %}
  <figure class="wp-block-embed is-type-video wp-block-embed-{{ video_embed_provider|default('youtube') }} wp-embed-aspect-16-9">
    <div class="wp-block-embed__wrapper">
      <iframe src="{{ video_embed_src }}" title="{{ video_embed_caption|default('Video') }}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
    </div>
    {% if video_embed_caption %}
      <figcaption class="wp-element-caption">{{ video_embed_caption }}</figcaption>
    {% endif %}
  </figure>
{% endif %}
