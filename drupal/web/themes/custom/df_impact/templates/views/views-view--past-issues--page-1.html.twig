{#
/**
 * @file
 * Past issues landing (/past-issues/) — WordPress Recent Issues band.
 */
#}
<h1 class="wp-block-heading blue-border-header has-text-color has-montserrat-font-family">{{ 'Recent Issues'|t }}</h1>

{% if rows %}
  <div class="wp-block-group is-content-justification-left is-layout-flex wp-block-group-is-layout-flex" style="margin-top:40px">
    {{ rows }}
  </div>
{% elseif empty %}
  {{ empty }}
{% endif %}

{% if pager %}
  {{ pager }}
{% endif %}
