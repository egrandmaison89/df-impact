{#
/**
 * @file
 * Topic archive page wrapper (title + query loop).
 */
#}
{% if topic_archive_heading %}
  <div class="wp-block-group alignfull is-layout-constrained wp-block-group-is-layout-constrained">
    <div class="wp-block-group alignwide is-layout-flow wp-block-group-is-layout-flow">
      <h1 class="wp-block-heading alignwide blue-border-header category-header wp-block-query-title has-text-color has-montserrat-font-family" style="color:#003354;margin-top:40px;padding-top:0;padding-right:20px;padding-bottom:0;padding-left:15px;font-size:38px;font-style:normal;font-weight:600;text-transform:capitalize">{{ topic_archive_heading }}</h1>
    </div>
  </div>
{% endif %}

{% if rows %}
  {{ rows }}
{% elseif empty %}
  <div class="wp-block-paragraph">{{ empty }}</div>
{% endif %}

{% if pager %}
  {{ pager }}
{% endif %}
