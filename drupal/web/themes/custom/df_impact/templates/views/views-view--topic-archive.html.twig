{#
/**
 * @file
 * Topic archive page wrapper (title + query loop).
 */
#}
{% if topic_archive_heading %}
  <h1 class="wp-block-heading alignwide blue-border-header has-text-color has-montserrat-font-family">{{ topic_archive_heading }}</h1>
{% endif %}

{% if rows %}
  {{ rows }}
{% elseif empty %}
  <div class="wp-block-paragraph">{{ empty }}</div>
{% endif %}

{% if pager %}
  {{ pager }}
{% endif %}
