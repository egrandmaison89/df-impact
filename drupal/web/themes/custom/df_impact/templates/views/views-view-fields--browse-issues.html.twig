{#
/**
 * @file
 * Issue card for browse issues — WordPress /browse-issues/ parity (cover + h4).
 */
#}
{% if issue_cover_url is defined and issue_cover_url %}
  <figure class="wp-block-image size-full is-resized issue-cover">
    <a href="{{ issue_url }}"><img decoding="async" src="{{ issue_cover_url }}" alt="{{ issue_cover_alt }}" class="lazyloaded" style="width:250px;height:auto"></a>
  </figure>
{% endif %}
{% if fields.title is defined %}
  <h4 class="wp-block-heading has-tertiary-color has-text-color">{{ fields.title.content|render|striptags|trim }}</h4>
{% endif %}
