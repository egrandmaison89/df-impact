{#
/**
 * @file
 * Article card template for digital exclusives view.
 */
#}
<article class="home-card home-card--digital">
  {% if fields.field_featured_image is defined and fields.field_featured_image.content|render|trim %}
    <div class="home-card__image">
      {{ fields.field_featured_image.content }}
    </div>
  {% elseif article_card_image_fallback is defined and article_card_image_fallback %}
    <div class="home-card__image">
      {{ article_card_image_fallback }}
    </div>
  {% endif %}
  <div class="home-card__body">
    {% if fields.field_topics is defined and fields.field_topics.content|render|trim %}
      <div class="home-card__category">{{ fields.field_topics.content }}</div>
    {% endif %}
    {% if fields.title is defined %}
      <h3 class="home-card__title">{{ fields.title.content }}</h3>
    {% endif %}
    {% if fields.field_excerpt is defined and fields.field_excerpt.content|render|trim %}
      <div class="home-card__excerpt">{{ fields.field_excerpt.content }}</div>
    {% endif %}
  </div>
</article>
