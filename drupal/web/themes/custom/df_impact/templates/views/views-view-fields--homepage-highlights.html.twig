{#
/**
 * @file
 * Article card template for homepage highlights view.
 */
#}
<div class="card">
  {% if fields.field_featured_image is defined and fields.field_featured_image.content|render|trim %}
    <div class="card__image">
      {{ fields.field_featured_image.content }}
    </div>
  {% endif %}
  <div class="card__body">
    {% if fields.field_topics is defined and fields.field_topics.content|render|trim %}
      <div class="card__category">{{ fields.field_topics.content }}</div>
    {% endif %}
    {% if fields.title is defined %}
      <h3 class="card__title">{{ fields.title.content }}</h3>
    {% endif %}
    {% if fields.field_excerpt is defined and fields.field_excerpt.content|render|trim %}
      <div class="card__excerpt">{{ fields.field_excerpt.content }}</div>
    {% endif %}
  </div>
</div>
