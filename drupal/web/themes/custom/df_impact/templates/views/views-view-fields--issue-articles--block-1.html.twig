{#
  Issue story card — PostX style4.
#}
<div class="ultp-block-item post-id-{{ article_nid }}">
  <div class="ultp-block-content-wrap">
    {% if article_card_image_url %}
      <div class="ultp-block-image ultp-block-image-zoomIn">
        <a href="{{ article_url }}"><img decoding="async" src="{{ article_card_image_url }}" class="ultp-block-image-content lazyloaded" alt="{{ article_card_image_alt }}"></a>
      </div>
    {% endif %}
    <div class="ultp-block-content">
      <h2 class="ultp-block-title"><a href="{{ article_url }}">{{ fields.title.content|render|striptags|trim }}</a></h2>
    </div>
  </div>
</div>
