{#
  PostX overlay card — latest issue homepage row.
#}
<div class="ultp-block-item post-id-{{ article_nid }}">
  <div class="ultp-block-content-wrap ultp-block-content-overlay">
    {% if article_card_image_url %}
      <div class="ultp-block-image ultp-block-image-zoomIn">
        <a href="{{ article_url }}"><img decoding="async" src="{{ article_card_image_url }}" width="{{ article_card_image_width }}" height="{{ article_card_image_height }}" class="lazyloaded" alt="{{ article_card_image_alt }}" style="width:100%;height:100%;object-fit:cover"></a>
      </div>
    {% endif %}
    <div class="ultp-block-content ultp-block-content-bottomPosition">
      <div class="ultp-block-content-inner">
        <h2 class="ultp-block-title"><a href="{{ article_url }}">{{ fields.title.content|render|striptags|trim }}</a></h2>
      </div>
    </div>
  </div>
</div>
