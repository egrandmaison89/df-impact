{#
/**
 * @file
 * Topic (category) archive row — WordPress wp-block-query template parity.
 */
#}
<li class="wp-block-post type-post hentry archive-row">
  <div class="wp-block-group is-layout-constrained wp-block-group-is-layout-constrained">
    <div class="wp-block-columns alignwide are-vertically-aligned-center is-layout-flex wp-container-core-columns-is-layout-f56f613f wp-block-columns-is-layout-flex">
      {% if archive_featured_image_url %}
        <div class="wp-block-column is-vertically-aligned-center is-layout-flow wp-block-column-is-layout-flow" style="flex-basis:33%">
          <figure class="wp-block-post-featured-image">
            <a href="{{ article_url }}"><img width="{{ archive_featured_image_width|default(1450) }}" height="{{ archive_featured_image_height|default(1040) }}" src="{{ archive_featured_image_url }}" class="attachment-post-thumbnail size-post-thumbnail wp-post-image" alt="{{ archive_featured_image_alt }}" style="object-fit:cover;" decoding="async" loading="lazy"></a>
          </figure>
        </div>
      {% endif %}
      <div class="wp-block-column is-vertically-aligned-center is-layout-flow wp-block-column-is-layout-flow" style="flex-basis:66%">
        <div class="wp-block-group wp-block-post-container is-layout-flow wp-block-group-is-layout-flow">
          {% if fields.title is defined %}
            <h2 style="color:#00629b;font-size:24px;font-style:normal;font-weight:600" class="has-link-color wp-block-post-title has-text-color has-libre-baskerville-font-family">
              <a href="{{ article_url }}">{{ archive_title_plain|default(fields.title.content|render|striptags|trim) }}</a>
            </h2>
          {% endif %}
          {% if archive_excerpt %}
            <div style="line-height:1.5" class="has-link-color wp-block-post-excerpt has-text-color has-black-color has-upper-heading-font-size has-montserrat-font-family">
              <p class="wp-block-post-excerpt__excerpt">{{ archive_excerpt }}</p>
              {% if article_url %}
                <p class="wp-block-post-excerpt__more-text"><a class="wp-block-post-excerpt__more-link" href="{{ article_url }}">{{ 'Continue Reading'|t }}</a></p>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</li>
