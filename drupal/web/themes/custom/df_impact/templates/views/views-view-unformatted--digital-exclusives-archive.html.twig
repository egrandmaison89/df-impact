{#
/**
 * @file
 * Digital Exclusives archive: stacked story cards (responsive list).
 */
#}
{% if title %}
  <h3 class="de-archive__subsection-title">{{ title }}</h3>
{% endif %}
<div class="de-archive-grid">
  {% for row in rows %}
    <div{{ row.attributes.addClass('views-row', 'de-archive-grid__item') }}>
      {{ row.content }}
    </div>
  {% endfor %}
</div>
