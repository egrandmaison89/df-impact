{#
/**
 * @file
 * Views unformatted template for digital exclusives.
 * Renders as a 3-column grid.
 */
#}
{% if title %}
  <h3>{{ title }}</h3>
{% endif %}
<div class="homepage-card-grid homepage-card-grid--digital">
  {% for row in rows %}
    <div{{ row.attributes }}>
      {{ row.content }}
    </div>
  {% endfor %}
</div>
