{
  "name": "df-impact-parity",
  "private": true,
  "version": "1.0.0",
  "description": "WordPress vs Drupal visual and content parity harness",
  "scripts": {
    "manifest": "python3 scripts/build_site_manifest.py && python3 scripts/merge_manifest_from_exports.py",
    "manifest:exports": "python3 scripts/merge_manifest_from_exports.py",
    "parity": "PARITY_SAMPLE=0 node scripts/run-parity.mjs",
    "parity:smoke": "PARITY_SAMPLE=1 PARITY_LIMIT=25 node scripts/run-parity.mjs",
    "parity:smoke:baseline": "PARITY_SAMPLE=1 PARITY_LIMIT=25 PARITY_WP_BASELINE=df-impact-2026-10-28 PARITY_REQUIRE_BASELINE=1 node scripts/run-parity.mjs",
    "parity:behavior:baseline": "PARITY_WP_BASELINE=df-impact-2026-10-28 PARITY_BEHAVIOR_PATHS=/homepage node scripts/run-behavior-parity.mjs",
    "parity:compare-ref-pack": "node scripts/compare-reference-pack.mjs",
    "parity:compare-template": "node scripts/compare-template-samples.mjs",
    "parity:capture-baseline": "node scripts/capture-wp-baseline.mjs",
    "parity:capture-baseline:smoke": "PARITY_SAMPLE=1 node scripts/capture-wp-baseline.mjs",
    "parity:package-baseline-lite": "node scripts/package-baseline-lite.mjs",
    "parity:behavior": "node scripts/run-behavior-parity.mjs",
    "parity:behavior:smoke": "PARITY_BEHAVIOR_PATHS=/homepage PARITY_BEHAVIOR_HIT_WP=1 node scripts/run-behavior-parity.mjs",
    "parity:full": "PARITY_SAMPLE=0 node scripts/run-parity.mjs",
    "report": "node scripts/generate-html-report.mjs",
    "test": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.51.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0"
  }
}
