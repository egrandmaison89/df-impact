{
  "name": "df-impact-parity",
  "private": true,
  "version": "1.0.0",
  "description": "WordPress vs Drupal visual and content parity harness",
  "scripts": {
    "manifest": "python3 scripts/build_site_manifest.py && python3 scripts/merge_manifest_from_exports.py",
    "manifest:exports": "python3 scripts/merge_manifest_from_exports.py",
    "parity": "PARITY_SAMPLE=0 node scripts/run-parity.mjs",
    "parity:smoke": "PARITY_SAMPLE=1 PARITY_LIMIT=25 node scripts/run-parity.mjs",
    "parity:smoke:baseline": "PARITY_SAMPLE=1 PARITY_LIMIT=25 PARITY_WP_BASELINE=df-impact-2026-10-28 PARITY_REQUIRE_BASELINE=1 node scripts/run-parity.mjs",
    "parity:behavior:baseline": "PARITY_WP_BASELINE=df-impact-2026-10-28 PARITY_BEHAVIOR_PATHS=/homepage node scripts/run-behavior-parity.mjs",
    "parity:capture-template-samples": "node scripts/capture-template-samples.mjs",
    "parity:compare-ref-pack": "node scripts/compare-reference-pack.mjs",
    "parity:compare-template": "node scripts/compare-template-samples.mjs",
    "parity:template-samples:http": "node scripts/check-template-samples-http.mjs",
    "parity:computed-style-diff": "node scripts/computed-style-diff.mjs",
    "parity:capture-baseline": "node scripts/capture-wp-baseline.mjs",
    "parity:capture-baseline:smoke": "PARITY_SAMPLE=1 node scripts/capture-wp-baseline.mjs",
    "parity:package-baseline-lite": "node scripts/package-baseline-lite.mjs",
    "parity:behavior": "node scripts/run-behavior-parity.mjs",
    "parity:behavior:smoke": "PARITY_BEHAVIOR_LITE=1 PARITY_BEHAVIOR_PATHS=/homepage PARITY_BEHAVIOR_HIT_WP=1 PARITY_BEHAVIOR_CROSS_SITE=1 node scripts/run-behavior-parity.mjs",
    "parity:qa:capture": "node scripts/capture-qa-checklist.mjs",
    "parity:analyze:regions": "node scripts/analyze-template-region-bands.mjs",
    "parity:behavior:report-diff": "node scripts/summarize-behavior-wp-diff.mjs",
    "parity:head:refpack": "node scripts/compare-head-meta.mjs",
    "parity:head:manifest": "node scripts/compare-head-meta-manifest.mjs",
    "parity:behavior:templates": "PARITY_BEHAVIOR_PATHS=auto PARITY_BEHAVIOR_HIT_WP=1 PARITY_BEHAVIOR_CROSS_SITE=1 node scripts/run-behavior-parity.mjs",
    "parity:behavior:templates:drupal-only": "PARITY_BEHAVIOR_PATHS=auto PARITY_BEHAVIOR_HIT_WP=0 PARITY_BEHAVIOR_CROSS_SITE=0 node scripts/run-behavior-parity.mjs",
    "parity:url:check": "node scripts/check-url-parity.mjs",
    "parity:launch:lighthouse": "node scripts/run-launch-lighthouse.mjs",
    "parity:launch:axe": "node scripts/run-launch-axe.mjs",
    "parity:launch:tags-test": "cd ../drupal && ddev exec ./vendor/bin/phpunit --bootstrap web/modules/custom/df_launch/tests/bootstrap.php web/modules/custom/df_launch/tests/src/Unit/LaunchEnvironmentTest.php",
    "parity:content:sweep": "node scripts/run-content-sweep.mjs",
    "parity:content:sweep:issues": "node scripts/run-content-sweep-issues.mjs",
    "parity:content:sweep:status": "node scripts/generate-content-sweep-status.mjs",
    "parity:issue-live-text": "node scripts/issue-live-text-sweep.mjs",
    "parity:smoke:200": "node scripts/smoke-200.mjs",
    "parity:article-dom-blocks": "node scripts/compare-article-dom-blocks.mjs",
    "parity:search:fetch-wp": "node scripts/fetch-wp-search-fixtures.mjs",
    "parity:search:compare": "node scripts/compare-search-parity.mjs",
    "parity:article-variants:classify": "cd ../drupal && ./vendor/bin/drush php:script web/modules/custom/df_migrate/scripts/classify_article_variants.php",
    "parity:article-variants:samples": "node scripts/run-article-variant-samples.mjs",
    "parity:article-variants:fetch-wp": "node scripts/fetch-wp-article-variant-fixtures.mjs",
    "parity:article-variants:compare": "node scripts/compare-article-variant-parity.mjs",
    "parity:header-chrome": "node scripts/compare-header-chrome.mjs",
    "parity:computed-style-diff:serial": "PARITY_SERIAL=1 node scripts/computed-style-diff.mjs",
    "parity:computed-style-diff:full": "node scripts/run-computed-style-full.mjs",
    "parity:computed-style-hover": "node scripts/computed-style-hover-diff.mjs",
    "parity:computed-style-hover:full": "node scripts/run-computed-style-hover-full.mjs",
    "parity:analyze-cs-drift": "node scripts/analyze-cs-baseline-drift.mjs",
    "parity:full": "PARITY_SAMPLE=0 node scripts/run-parity.mjs",
    "report": "node scripts/generate-html-report.mjs",
    "test": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.51.0",
    "cheerio": "^1.0.0",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^12.8.2",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0"
  }
}
